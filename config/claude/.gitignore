.credentials.json
history.jsonl

backups/
cache/
projects/
sessions/
shell-snapshots/

# Runtime caches that capture arbitrary file content, including from other
# repos. file-history snapshots every file Claude Code reads or edits, so a
# real .env opened anywhere would land here and be committed — GitHub push
# protection caught exactly this on 2026-07-31 (fabricated fixtures, but the
# path was real). Keep these out of the repo.
file-history/
paste-cache/
image-cache/
session-env/
tasks/

# Housekeeping timestamps. They change on their own every session and mean
# nothing to a second machine.
.last-cleanup
plugins/.last_inuse_sweep

# Plugin install state. Regenerated by Claude Code, and every entry carries an
# absolute installPath that is only true on the machine that wrote it. What
# actually needs tracking is settings.json's `enabledPlugins`, which already is:
# from that, `claude plugin marketplace add` rebuilds the rest.
plugins/installed_plugins.json
plugins/known_marketplaces.json
plugins/cache/
plugins/data/

# A full clone of anthropics/claude-plugins-official — 427 files of somebody
# else's repo, re-synced whenever the marketplace updates. Vendoring it here
# tracked their commits as ours and produced a large diff for changes nobody
# made.
plugins/marketplaces/
