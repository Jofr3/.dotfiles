<?php

namespace App\Services\SubColaborador;

use Illuminate\Support\Facades\DB;

class GestioService
{
    public function getColaboradorsWithSubs(): array
    {
        $colaboradors = DB::select("
            SELECT idcolaborador, nom_colaborador, nick_colaborador
            FROM colaboradors
            ORDER BY idcolaborador
        ");

        $subsByColaborador = [];
        $subs = DB::select("
            SELECT idtipus, idcol_extern, nom_colaborador, nick_colaborador, actiu, emails, color_web,
                   per_defecte_inv, per_gv_defecte_sub, per_gv_defecte_fin, per_gv_defecte_ded,
                   per_defecte_caes, perc_previsio
            FROM colaboradors_externs
            ORDER BY idtipus, actiu DESC, nom_colaborador
        ");

        foreach ($subs as $sub) {
            $sub->css_color = $this->toCssColor($sub->color_web);
            $sub->emails = $sub->emails ? str_replace(';', '; ', preg_replace('/\[[^\]]*\]/', '', $sub->emails)) : null;
            $sub->per_defecte_inv = (float) $sub->per_defecte_inv == 0 ? '' : $sub->per_defecte_inv;
            $sub->per_gv_defecte_sub = (float) $sub->per_gv_defecte_sub == 0 ? '' : $sub->per_gv_defecte_sub;
            $sub->per_gv_defecte_fin = (float) $sub->per_gv_defecte_fin == 0 ? '' : $sub->per_gv_defecte_fin;
            $sub->per_gv_defecte_ded = (float) $sub->per_gv_defecte_ded == 0 ? '' : $sub->per_gv_defecte_ded;
            $sub->per_defecte_caes = (float) $sub->per_defecte_caes == 0 ? '' : $sub->per_defecte_caes;
            $sub->perc_previsio = (float) $sub->perc_previsio == 0 ? '' : $sub->perc_previsio;
            $subsByColaborador[$sub->idtipus][] = $sub;
        }

        $result = [];

        foreach ($colaboradors as $col) {
            $subs = $subsByColaborador[$col->idcolaborador] ?? [];

            $result[] = [
                'colaborador' => $col,
                'subs' => $subs,
                'count' => count($subs),
            ];
        }

        return $result;
    }

    public function getColaboradors(): array
    {
        return DB::select("
            SELECT idcolaborador, nom_colaborador, nick_colaborador
            FROM colaboradors
            ORDER BY nom_colaborador
        ");
    }

    public function getSubColaboradorForEdit(int $idtipus, int $idcol_extern): ?object
    {
        $sub = DB::selectOne("
            SELECT *
            FROM colaboradors_externs
            WHERE idtipus = ? AND idcol_extern = ?
        ", [$idtipus, $idcol_extern]);

        return $sub;
    }

    public function createSubColaborador(array $data): array
    {
        $idtipus = (int) $data['idtipus'];

        $token = bin2hex(random_bytes(16));

        // Get next idcol_extern for this idtipus
        $maxRow = DB::selectOne("
            SELECT COALESCE(MAX(idcol_extern), 0) + 1 as next_id
            FROM colaboradors_externs
            WHERE idtipus = ?
        ", [$idtipus]);
        $idcol_extern = $maxRow->next_id;

        DB::insert("
            INSERT INTO colaboradors_externs (
                idtipus, idcol_extern, nom_colaborador, nick_colaborador,
                color_web, actiu, nom_complet_cat, nom_complet_cast,
                per_defecte_inv, per_gv_defecte_sub, per_gv_defecte_fin, per_gv_defecte_ded,
                per_defecte_caes, perc_previsio,
                emails, emails_interns,
                numero_comptable, nif_factura, nom_factura,
                token_subcolext, dataalta
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ", [
            $idtipus,
            $idcol_extern,
            $data['nom_colaborador'] ?? '',
            $data['nick_colaborador'] ?? '',
            $data['color_web'] ?? null,
            filter_var($data['actiu'] ?? false, FILTER_VALIDATE_BOOLEAN) ? 1 : 0,
            $data['nom_complet_cat'] ?? '',
            $data['nom_complet_cast'] ?? '',
            $data['per_defecte_inv'] ?? 0,
            $data['per_gv_defecte_sub'] ?? 0,
            $data['per_gv_defecte_fin'] ?? 0,
            $data['per_gv_defecte_ded'] ?? 0,
            $data['per_defecte_caes'] ?? 0,
            $data['perc_previsio'] ?? 100,
            $data['emails'] ?? '',
            $data['emails_interns'] ?? '',
            $data['numero_comptable'] ?? '',
            $data['nif_factura'] ?? '',
            $data['nom_factura'] ?? '',
            $token,
            date('Y-m-d'),
        ]);

        return ['idtipus' => $idtipus, 'idcol_extern' => $idcol_extern];
    }

    public function updateSubColaborador(int $idtipus, int $idcol_extern, array $data): void
    {
        DB::update("
            UPDATE colaboradors_externs
            SET nom_colaborador = ?,
                nick_colaborador = ?,
                color_web = ?,
                actiu = ?,
                nom_complet_cat = ?,
                nom_complet_cast = ?,
                per_defecte_inv = ?,
                per_gv_defecte_sub = ?,
                per_gv_defecte_fin = ?,
                per_gv_defecte_ded = ?,
                per_defecte_caes = ?,
                perc_previsio = ?,
                emails = ?,
                emails_interns = ?,
                numero_comptable = ?,
                nif_factura = ?,
                nom_factura = ?
            WHERE idtipus = ? AND idcol_extern = ?
        ", [
            $data['nom_colaborador'] ?? '',
            $data['nick_colaborador'] ?? '',
            $data['color_web'] ?? null,
            filter_var($data['actiu'] ?? false, FILTER_VALIDATE_BOOLEAN) ? 1 : 0,
            $data['nom_complet_cat'] ?? '',
            $data['nom_complet_cast'] ?? '',
            $data['per_defecte_inv'] ?? 0,
            $data['per_gv_defecte_sub'] ?? 0,
            $data['per_gv_defecte_fin'] ?? 0,
            $data['per_gv_defecte_ded'] ?? 0,
            $data['per_defecte_caes'] ?? 0,
            $data['perc_previsio'] ?? 100,
            $data['emails'] ?? '',
            $data['emails_interns'] ?? '',
            $data['numero_comptable'] ?? '',
            $data['nif_factura'] ?? '',
            $data['nom_factura'] ?? '',
            $idtipus,
            $idcol_extern,
        ]);
    }

    private function toCssColor(?string $color): ?string
    {
        if (!$color) {
            return null;
        }

        if (str_starts_with($color, '#')) {
            return $color;
        }

        // Delphi-style $00BBGGRR → #RRGGBB
        if (str_starts_with($color, '$') && strlen($color) === 10) {
            $bb = substr($color, 4, 2);
            $gg = substr($color, 6, 2);
            $rr = substr($color, 8, 2);
            return '#' . $rr . $gg . $bb;
        }

        return null;
    }
}
