const sql = require('/home/jofre/.cache/claude-drizzle-db/node_modules/mssql');
const c = JSON.parse(process.env.DATABASES).find((x) => x.name === 'ateinsa');
const u = new URL(c.url);

(async () => {
  try {
    const pool = await sql.connect({
      user: decodeURIComponent(u.username),
      password: decodeURIComponent(u.password),
      server: u.hostname,
      port: Number(u.port) || 1433,
      database: u.searchParams.get('database'),
      options: { encrypt: false, trustServerCertificate: true },
      connectionTimeout: 15000,
      requestTimeout: 15000,
    });
    const r = await pool.request().query(
      "select @@VERSION as v, DB_NAME() as db, SUSER_NAME() as login",
    );
    console.log('OK');
    console.log('  db:      ', r.recordset[0].db);
    console.log('  login:   ', r.recordset[0].login);
    console.log('  version: ', String(r.recordset[0].v).split('\n')[0].trim());
    const t = await pool.request().query(
      "select count(*) as n from INFORMATION_SCHEMA.TABLES where TABLE_TYPE = 'BASE TABLE'",
    );
    console.log('  tables:  ', t.recordset[0].n);
    await pool.close();
  } catch (e) {
    console.log('FAIL:', e.code || '', e.message);
  }
})();
