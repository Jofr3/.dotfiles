// Normalizes DATABASES in-memory (Go DSN -> URL, `type` -> `dialect`) and runs the
// skill CLI with the patched env. Nothing secret is ever printed.
import { spawnSync } from 'node:child_process';

const GO_DSN = /^([^:@/]+):(.*)@tcp\(([^:)]+):(\d+)\)\/([^?]*)(\?.*)?$/;

const entries = JSON.parse(process.env.DATABASES).map((c) => {
  const out = { ...c };
  if (c.type && !c.dialect) out.dialect = c.type;
  const m = GO_DSN.exec(String(c.url || ''));
  if (m) {
    const [, user, pass, host, port, db, params] = m;
    const scheme = /my/i.test(out.dialect || '') ? 'mysql' : 'mysql';
    out.url = `${scheme}://${encodeURIComponent(user)}:${encodeURIComponent(pass)}`
      + `@${host}:${port}/${db}${params || ''}`;
  }
  return out;
});

const r = spawnSync(
  process.execPath,
  ['/home/jofre/.claude/skills/drizzle-db/scripts/drizzle-db.mjs', ...process.argv.slice(2)],
  { env: { ...process.env, DATABASES: JSON.stringify(entries) }, stdio: 'inherit' },
);
process.exit(r.status ?? 1);
