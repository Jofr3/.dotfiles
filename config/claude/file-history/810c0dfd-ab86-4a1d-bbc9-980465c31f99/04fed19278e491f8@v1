#!/usr/bin/env node
/**
 * Standalone diagnostics — run outside of Claude Code:
 *   node <plugin>/mcp/doctor.mjs
 * Prints the resolved (redacted) configuration and tries to load the toolset.
 */
import { ensureDependencies } from './bootstrap.mjs';

const log = (...args) => console.log(...args);

try {
  ensureDependencies((msg) => log(`• ${msg}`), true);
} catch (error) {
  log(`✗ ${error.message}`);
  process.exit(1);
}

const { loadConfig, describeConfig } = await import('./config.mjs');
const { createClient, loadTools } = await import('./toolbox.mjs');

let config;
try {
  config = loadConfig();
} catch (error) {
  log(`✗ invalid environment: ${error.message}`);
  process.exit(1);
}

log('Configuration (from session environment variables):');
for (const [key, value] of Object.entries(describeConfig(config))) {
  log(`  ${key}: ${Array.isArray(value) ? (value.length ? value.join(', ') : '(none)') : value}`);
}

log(`\nConnecting to ${config.url} …`);
try {
  const { tools, droppedAuthServices, droppedBoundParams } = await loadTools(createClient(config), config);
  if (droppedAuthServices.length > 0) {
    log(`⚠ auth tokens unused by this toolset (ignored): ${droppedAuthServices.join(', ')}`);
  }
  if (droppedBoundParams.length > 0) {
    log(`⚠ bound params unused by this toolset (ignored): ${droppedBoundParams.join(', ')}`);
  }
  log(`✓ loaded ${tools.length} tool(s):`);
  for (const tool of tools) {
    const params = Object.keys(tool.getParamSchema().shape);
    log(`  - ${tool.getName()}(${params.join(', ')})`);
    log(`      ${tool.getDescription().split('\n')[0]}`);
    const bound = Object.keys(tool.boundParams ?? {});
    if (bound.length > 0) {
      log(`      pre-bound params (not asked of the model): ${bound.join(', ')}`);
    }
    if (tool.requiredAuthnParams && Object.keys(tool.requiredAuthnParams).length > 0) {
      log(`      ⚠ unsatisfied auth for params: ${Object.keys(tool.requiredAuthnParams).join(', ')}`);
    }
    if (tool.requiredAuthzTokens?.length > 0) {
      log(`      ⚠ unsatisfied authorization tokens: ${tool.requiredAuthzTokens.join(', ')}`);
    }
  }
} catch (error) {
  const data = error.response?.data;
  const detail = typeof data === 'string' ? data : data ? JSON.stringify(data) : '';
  log(`✗ could not load toolset: ${error.message}${detail ? ` — ${detail}` : ''}`);
  log('\nChecks:');
  log('  1. Is the Toolbox server running?  curl ' + config.url + '/api/toolset');
  log('  2. Is TOOLBOX_URL exported in this shell?');
  log('  3. If the toolset name is wrong, the server returns 404 — check TOOLBOX_TOOLSET.');
  process.exit(1);
}
