// End-to-end test: Claude-side MCP client -> plugin bridge -> fake Toolbox server
import { Client } from '@modelcontextprotocol/sdk/client/index.js';
import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
import { startFakeToolbox } from './fake-toolbox.mjs';

const PLUGIN = '/home/jofre/.dotfiles/config/claude/local-plugins/plugins/toolbox-db';
let failures = 0;
const check = (label, ok, extra = '') => {
  console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${extra ? ` — ${extra}` : ''}`);
  if (!ok) failures++;
};

async function connect(env) {
  const client = new Client({ name: 'test', version: '1.0.0' });
  const transport = new StdioClientTransport({
    command: 'node',
    args: [`${PLUGIN}/mcp/launch.mjs`],
    env: { PATH: process.env.PATH, HOME: process.env.HOME, ...env },
    stderr: 'inherit',
  });
  await client.connect(transport);
  return client;
}

const toolbox = await startFakeToolbox();
console.log(`fake toolbox at ${toolbox.url}\n`);

// --- happy path ---------------------------------------------------------
{
  const client = await connect({
    TOOLBOX_URL: toolbox.url,
    TOOLBOX_TOOLSET: 'default',
    TOOLBOX_API_KEY: 'sekret-key',
    TOOLBOX_BOUND_PARAMS: '{"tenant_id":"42"}',
    TOOLBOX_TOOL_PREFIX: 'db_',
  });

  const { tools } = await client.listTools();
  const names = tools.map((t) => t.name).sort();
  check('tools listed with prefix + meta tools', JSON.stringify(names) ===
    JSON.stringify(['db_count_orders', 'db_search_users', 'toolbox_reload', 'toolbox_status']), names.join(','));

  const searchTool = tools.find((t) => t.name === 'db_search_users');
  check('input schema is a JSON-Schema object', searchTool.inputSchema.type === 'object' &&
    !!searchTool.inputSchema.properties?.email_pattern, JSON.stringify(searchTool.inputSchema));
  check('required params preserved', JSON.stringify(searchTool.inputSchema.required) === '["email_pattern"]',
    JSON.stringify(searchTool.inputSchema.required));
  check('description forwarded', searchTool.description.startsWith('Find users'), searchTool.description);

  const result = await client.callTool({ name: 'db_search_users', arguments: { email_pattern: '%@x.com', limit: 5 } });
  const payload = JSON.parse(result.content[0].text);
  check('tool call reaches toolbox with args', payload.tool === 'search_users' &&
    payload.args.email_pattern === '%@x.com' && payload.args.limit === 5, result.content[0].text);

  const bound = await client.callTool({ name: 'db_count_orders', arguments: {} });
  check('bound param injected from TOOLBOX_BOUND_PARAMS',
    JSON.parse(bound.content[0].text).args.tenant_id === '42', bound.content[0].text);

  const authHeaders = toolbox.seen.headers.at(-1);
  check('client-to-server bearer auth sent', authHeaders.authorization === 'Bearer sekret-key', authHeaders.authorization);

  const status = await client.callTool({ name: 'toolbox_status', arguments: {} });
  const report = JSON.parse(status.content[0].text);
  check('status lists loaded tools', report.loadedTools.includes('db_search_users'), status.content[0].text);
  check('status redacts the api key', !status.content[0].text.includes('sekret-key') &&
    /redacted/.test(report.clientToServerAuth), report.clientToServerAuth);
  check('status reports bound params by key only', JSON.stringify(report.boundParams) === '["tenant_id"]');

  const reloaded = await client.callTool({ name: 'toolbox_reload', arguments: {} });
  check('reload returns a fresh status', JSON.parse(reloaded.content[0].text).loadedTools.length === 2);

  const missing = await client.callTool({ name: 'db_nope', arguments: {} });
  check('unknown tool is a soft error', missing.isError === true, missing.content[0].text);

  await client.close();
}

// --- toolset that does not exist ---------------------------------------
{
  const client = await connect({ TOOLBOX_URL: toolbox.url, TOOLBOX_TOOLSET: 'ghost' });
  const { tools } = await client.listTools();
  check('server stays up when the toolset fails to load',
    tools.map((t) => t.name).sort().join(',') === 'toolbox_reload,toolbox_status');
  const status = JSON.parse((await client.callTool({ name: 'toolbox_status', arguments: {} })).content[0].text);
  check('load error surfaced in status', /not found/.test(status.lastLoadError ?? ''), status.lastLoadError);
  await client.close();
}

// --- toolbox server down ------------------------------------------------
{
  const client = await connect({ TOOLBOX_URL: 'http://127.0.0.1:1' });
  const status = JSON.parse((await client.callTool({ name: 'toolbox_status', arguments: {} })).content[0].text);
  check('unreachable server reported, not crashed', !!status.lastLoadError, status.lastLoadError);
  await client.close();
}

// --- per-tool auth tokens + env var forms -------------------------------
{
  const client = await connect({
    TOOLBOX_URL: toolbox.url,
    TOOLBOX_AUTH_MY_SERVICE: 'token-from-var',
    TOOLBOX_AUTH_TOKENS: '{"other_service":"token-from-json"}',
    TOOLBOX_CLIENT_HEADERS: '{"X-Env":"staging"}',
  });
  const status = JSON.parse((await client.callTool({ name: 'toolbox_status', arguments: {} })).content[0].text);
  check('auth services from both env forms', JSON.stringify(status.toolAuthServices.sort()) ===
    '["my_service","other_service"]', JSON.stringify(status.toolAuthServices));
  check('extra client headers registered', JSON.stringify(status.extraClientHeaders) === '["X-Env"]');
  check('inapplicable auth tokens do not break the load', status.loadedTools.includes('search_users'),
    JSON.stringify(status.loadedTools));
  check('dropped auth tokens reported as warnings',
    status.warnings.some((w) => /auth tokens ignored.*my_service.*other_service/.test(w)),
    JSON.stringify(status.warnings));
  const call = await client.callTool({ name: 'search_users', arguments: { email_pattern: '%' } });
  check('tool still callable', !call.isError, call.content[0].text);
  check('extra header actually sent', toolbox.seen.headers.at(-1)['x-env'] === 'staging');
  await client.close();
}

// --- unused bound param, and strict mode --------------------------------
{
  const client = await connect({
    TOOLBOX_URL: toolbox.url,
    TOOLBOX_TOOLSET: 'readonly',
    TOOLBOX_BOUND_PARAMS: '{"tenant_id":"42","email_pattern":"%@x.com"}',
  });
  const status = JSON.parse((await client.callTool({ name: 'toolbox_status', arguments: {} })).content[0].text);
  check('unused bound param dropped, applicable one kept', status.loadedTools.includes('search_users') &&
    status.warnings.some((w) => /bound params ignored.*tenant_id/.test(w)), JSON.stringify(status.warnings));
  const call = await client.callTool({ name: 'search_users', arguments: {} });
  check('applicable bound param still injected',
    JSON.parse(call.content[0].text).args.email_pattern === '%@x.com', call.content[0].text);
  await client.close();

  const strict = await connect({
    TOOLBOX_URL: toolbox.url,
    TOOLBOX_TOOLSET: 'readonly',
    TOOLBOX_BOUND_PARAMS: '{"tenant_id":"42"}',
    TOOLBOX_STRICT: '1',
  });
  const strictStatus = JSON.parse((await strict.callTool({ name: 'toolbox_status', arguments: {} })).content[0].text);
  check('TOOLBOX_STRICT=1 keeps the SDK\'s fail-loud behaviour',
    /unused bound parameters/.test(strictStatus.lastLoadError ?? ''), strictStatus.lastLoadError);
  await strict.close();
}

// --- bad JSON in env ----------------------------------------------------
{
  const client = await connect({ TOOLBOX_URL: toolbox.url, TOOLBOX_BOUND_PARAMS: '{oops' }).catch((e) => e);
  check('invalid JSON env var fails loudly at startup', client instanceof Error, String(client).slice(0, 120));
}

toolbox.close();
console.log(failures === 0 ? '\nall checks passed' : `\n${failures} check(s) failed`);
process.exit(failures === 0 ? 0 : 1);
