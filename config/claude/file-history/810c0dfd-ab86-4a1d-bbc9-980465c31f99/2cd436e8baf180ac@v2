#!/usr/bin/env node
/** Entry point used by .mcp.json: install deps if needed, then start the server. */
import { ensureDependencies } from './bootstrap.mjs';

const log = (...args) => console.error('[toolbox-db]', ...args);
const autoInstall = !['0', 'false', 'no', 'off'].includes(
  (process.env.TOOLBOX_AUTO_INSTALL ?? '1').trim().toLowerCase(),
);

try {
  ensureDependencies(log, autoInstall);
} catch (error) {
  log(`startup failed: ${error.message}`);
  process.exit(1);
}

await import('./server.mjs');
