/**
 * Thin wrapper around @toolbox-sdk/core: turns the session config into a
 * ToolboxClient and loads a toolset from the Toolbox server.
 */
import { ToolboxClient, Protocol } from '@toolbox-sdk/core';
import { getGoogleIdToken } from '@toolbox-sdk/core/auth';

function resolveProtocol(value) {
  if (!value) return undefined;
  const supported = Object.values(Protocol);
  if (supported.includes(value)) return value;
  const byName = Protocol[value];
  if (byName) return byName;
  throw new Error(
    `TOOLBOX_PROTOCOL="${value}" is not supported. Use one of: ${supported.join(', ')}`,
  );
}

/** Client-to-server headers, as getters so tokens refresh on every request. */
function buildClientHeaders(config) {
  const headers = {};
  for (const [name, value] of Object.entries(config.clientHeaders)) {
    headers[name] = value;
  }
  if (config.useGoogleIdToken) {
    headers.Authorization = () => getGoogleIdToken(config.url);
  } else if (config.apiKey) {
    const prefixed = /^bearer /i.test(config.apiKey) ? config.apiKey : `Bearer ${config.apiKey}`;
    headers.Authorization = () => prefixed;
  }
  return Object.keys(headers).length > 0 ? headers : null;
}

/** Per-tool auth: { my_auth_service: () => token }. */
function buildAuthTokenGetters(config) {
  const getters = {};
  for (const [service, token] of Object.entries(config.authTokens)) {
    getters[service] = () => token;
  }
  return Object.keys(getters).length > 0 ? getters : null;
}

export function createClient(config) {
  return new ToolboxClient(
    config.url,
    null,
    buildClientHeaders(config),
    resolveProtocol(config.protocol),
    'claude-code-toolbox-db',
    '0.1.0',
  );
}

/** Auth services and parameter names the toolset can actually make use of. */
function applicableKeys(tools) {
  const authServices = new Set();
  const paramNames = new Set();
  for (const tool of tools) {
    for (const sources of Object.values(tool.requiredAuthnParams ?? {})) {
      for (const source of sources) authServices.add(source);
    }
    for (const token of tool.requiredAuthzTokens ?? []) authServices.add(token);
    for (const name of Object.keys(tool.getParamSchema().shape)) paramNames.add(name);
  }
  return { authServices, paramNames };
}

function pick(source, allowed) {
  const kept = {};
  const dropped = [];
  for (const [key, value] of Object.entries(source)) {
    if (allowed.has(key)) kept[key] = value;
    else dropped.push(key);
  }
  return { kept, dropped };
}

/**
 * Loads the toolset.
 *
 * The SDK rejects the whole toolset if any supplied auth token or bound param
 * matches no tool — which is easy to hit when configuration comes from
 * long-lived environment variables. Unless TOOLBOX_STRICT is set, the ones that
 * do not apply are dropped (and reported) instead of failing the load.
 *
 * @returns {Promise<{tools: import('@toolbox-sdk/core').ToolboxTool[], droppedAuthServices: string[], droppedBoundParams: string[]}>}
 */
export async function loadTools(client, config) {
  const authGetters = buildAuthTokenGetters(config);
  const hasBound = Object.keys(config.boundParams).length > 0;

  if (config.strict) {
    const tools = await client.loadToolset(
      config.toolset,
      authGetters,
      hasBound ? config.boundParams : null,
      true,
    );
    return { tools, droppedAuthServices: [], droppedBoundParams: [] };
  }

  const probe = await client.loadToolset(config.toolset);
  if (!authGetters && !hasBound) {
    return { tools: probe, droppedAuthServices: [], droppedBoundParams: [] };
  }

  const { authServices, paramNames } = applicableKeys(probe);
  const auth = pick(authGetters ?? {}, authServices);
  const bound = pick(config.boundParams, paramNames);

  const tools = await client.loadToolset(
    config.toolset,
    Object.keys(auth.kept).length > 0 ? auth.kept : null,
    Object.keys(bound.kept).length > 0 ? bound.kept : null,
    false,
  );
  return { tools, droppedAuthServices: auth.dropped, droppedBoundParams: bound.dropped };
}
