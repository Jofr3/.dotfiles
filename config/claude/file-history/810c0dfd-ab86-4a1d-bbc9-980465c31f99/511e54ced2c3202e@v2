/**
 * First-run dependency install.
 *
 * The plugin ships source only, so node_modules is created on first launch.
 * npm output is forced to stderr: stdout belongs to the MCP stdio protocol.
 */
import { execFileSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

export const MCP_DIR = dirname(fileURLToPath(import.meta.url));

const REQUIRED_PACKAGES = [
  '@modelcontextprotocol/sdk',
  '@toolbox-sdk/core',
  'zod',
  'zod-to-json-schema',
];

export function missingPackages() {
  return REQUIRED_PACKAGES.filter((pkg) => !existsSync(join(MCP_DIR, 'node_modules', pkg)));
}

/**
 * @param {(msg: string) => void} log
 * @param {boolean} autoInstall
 */
export function ensureDependencies(log, autoInstall = true) {
  const missing = missingPackages();
  if (missing.length === 0) return;

  if (!autoInstall) {
    throw new Error(
      `missing dependencies (${missing.join(', ')}) and TOOLBOX_AUTO_INSTALL is off. ` +
        `Run: npm install --omit=dev --prefix ${MCP_DIR}`,
    );
  }

  log(`installing dependencies in ${MCP_DIR} (first run, needs network)…`);
  try {
    execFileSync('npm', ['install', '--omit=dev', '--no-audit', '--no-fund', '--loglevel=error'], {
      cwd: MCP_DIR,
      stdio: ['ignore', 2, 2],
    });
  } catch (error) {
    throw new Error(
      `npm install failed in ${MCP_DIR}: ${error.message}. ` +
        `Install manually with: npm install --omit=dev --prefix ${MCP_DIR}`,
    );
  }

  const stillMissing = missingPackages();
  if (stillMissing.length > 0) {
    throw new Error(`dependencies still missing after install: ${stillMissing.join(', ')}`);
  }
  log('dependencies installed');
}
