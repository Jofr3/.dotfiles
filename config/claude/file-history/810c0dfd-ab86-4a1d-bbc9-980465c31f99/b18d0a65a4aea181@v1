#!/usr/bin/env node
/**
 * MCP stdio server that re-exposes the tools of an MCP Toolbox server
 * (https://mcp-toolbox.dev) as Claude Code tools, using @toolbox-sdk/core.
 *
 * All connection settings and credentials come from session environment
 * variables — see config.mjs and the plugin README.
 */
import { Server } from '@modelcontextprotocol/sdk/server/index.js';
import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
import {
  CallToolRequestSchema,
  ListToolsRequestSchema,
} from '@modelcontextprotocol/sdk/types.js';
import { zodToJsonSchema } from 'zod-to-json-schema';

import { loadConfig, describeConfig } from './config.mjs';
import { createClient, loadTools } from './toolbox.mjs';

const SERVER_NAME = 'toolbox-db';
const SERVER_VERSION = '0.1.0';

const log = (...args) => console.error(`[${SERVER_NAME}]`, ...args);

/** MCP tool names allow [a-zA-Z0-9_-]; Toolbox tool names are looser. */
function toMcpName(prefix, toolName) {
  const sanitized = `${prefix}${toolName}`.replace(/[^a-zA-Z0-9_-]/g, '_');
  return sanitized.slice(0, 128);
}

function toJsonSchema(tool) {
  const schema = zodToJsonSchema(tool.getParamSchema(), { target: 'jsonSchema7' });
  delete schema.$schema;
  // Claude requires an object schema even for tools that take no parameters.
  if (schema.type !== 'object') return { type: 'object', properties: {} };
  return { properties: {}, ...schema };
}

function errorMessage(error) {
  if (!error) return 'unknown error';
  // Axios errors carry the useful detail in the response body.
  const data = error.response?.data;
  const detail = typeof data === 'string' ? data : data ? JSON.stringify(data) : undefined;
  return detail ? `${error.message}: ${detail}` : error.message ?? String(error);
}

/** Loads the toolset and builds the MCP tool registry. Never throws. */
async function buildRegistry(config) {
  const registry = new Map();
  const warnings = [];
  try {
    const client = createClient(config);
    const { tools, droppedAuthServices, droppedBoundParams } = await loadTools(client, config);
    for (const tool of tools) {
      const name = toMcpName(config.toolPrefix, tool.getName());
      if (registry.has(name)) {
        log(`skipping duplicate tool name "${name}" (from "${tool.getName()}")`);
        continue;
      }
      registry.set(name, tool);
    }
    if (droppedAuthServices.length > 0) {
      warnings.push(
        `auth tokens ignored, no tool in this toolset uses them: ${droppedAuthServices.join(', ')}`,
      );
    }
    if (droppedBoundParams.length > 0) {
      warnings.push(
        `bound params ignored, no tool in this toolset takes them: ${droppedBoundParams.join(', ')}`,
      );
    }
    for (const warning of warnings) log(`warning: ${warning}`);
    log(`loaded ${registry.size} tool(s) from ${config.url}`);
    return { registry, loadError: null, warnings };
  } catch (error) {
    const message = errorMessage(error);
    log(`failed to load toolset from ${config.url}: ${message}`);
    log('the server stays up — fix the environment and call toolbox_reload');
    return { registry, loadError: message, warnings };
  }
}

async function main() {
  const config = loadConfig();
  let { registry, loadError, warnings } = await buildRegistry(config);

  const server = new Server(
    { name: SERVER_NAME, version: SERVER_VERSION },
    { capabilities: { tools: { listChanged: true } } },
  );

  const statusReport = () => ({
    ...describeConfig(config),
    loadedTools: [...registry.keys()],
    warnings,
    lastLoadError: loadError,
  });

  const metaTools = {
    toolbox_status: {
      description:
        'Report how this plugin is configured (Toolbox server URL, toolset, auth sources, ' +
        'bound params, loaded tools) and any error from the last toolset load. Secrets are redacted. ' +
        'Use this first when database tools are missing or failing.',
      inputSchema: { type: 'object', properties: {} },
      handler: async () => JSON.stringify(statusReport(), null, 2),
    },
    toolbox_reload: {
      description:
        'Reload the toolset from the MCP Toolbox server. Use after starting the Toolbox server or ' +
        'editing its tools.yaml — no Claude Code restart needed. Changed environment variables do ' +
        'need a restart, since this process inherited its environment at launch.',
      inputSchema: { type: 'object', properties: {} },
      handler: async () => {
        const reloaded = await buildRegistry(loadConfig());
        registry = reloaded.registry;
        loadError = reloaded.loadError;
        warnings = reloaded.warnings;
        await server.sendToolListChanged();
        return JSON.stringify(statusReport(), null, 2);
      },
    },
  };

  server.setRequestHandler(ListToolsRequestSchema, async () => ({
    tools: [
      ...[...registry.entries()].map(([name, tool]) => ({
        name,
        description: tool.getDescription(),
        inputSchema: toJsonSchema(tool),
      })),
      ...Object.entries(metaTools).map(([name, meta]) => ({
        name,
        description: meta.description,
        inputSchema: meta.inputSchema,
      })),
    ],
  }));

  server.setRequestHandler(CallToolRequestSchema, async (request) => {
    const { name, arguments: args } = request.params;

    const meta = metaTools[name];
    if (meta) {
      return { content: [{ type: 'text', text: await meta.handler() }] };
    }

    const tool = registry.get(name);
    if (!tool) {
      return {
        isError: true,
        content: [
          {
            type: 'text',
            text:
              `Unknown tool "${name}". Loaded tools: ${[...registry.keys()].join(', ') || '(none)'}. ` +
              `Call toolbox_status for the current configuration.`,
          },
        ],
      };
    }

    try {
      const result = await tool(args ?? {});
      const text = typeof result === 'string' ? result : JSON.stringify(result, null, 2);
      return { content: [{ type: 'text', text: text === '' ? '(empty result)' : text }] };
    } catch (error) {
      return {
        isError: true,
        content: [{ type: 'text', text: `Tool "${name}" failed: ${errorMessage(error)}` }],
      };
    }
  });

  await server.connect(new StdioServerTransport());
  log(`ready — Toolbox at ${config.url}, toolset ${config.toolset ?? '(default)'}`);
}

main().catch((error) => {
  log(`fatal: ${errorMessage(error)}`);
  process.exit(1);
});
