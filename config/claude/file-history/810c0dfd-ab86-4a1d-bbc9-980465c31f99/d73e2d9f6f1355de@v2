// Minimal stand-in for an MCP Toolbox server: JSON-RPC over POST /mcp/{toolset}
import { createServer } from 'node:http';

const TOOLSETS = {
  '': ['search_users', 'count_orders'],
  default: ['search_users', 'count_orders'],
  readonly: ['search_users'],
};

const TOOLS = {
  search_users: {
    description: 'Find users whose email matches a SQL LIKE pattern.',
    inputSchema: {
      type: 'object',
      properties: {
        email_pattern: { type: 'string', description: "LIKE pattern, e.g. '%@example.com'" },
        limit: { type: 'integer', description: 'Max rows' },
      },
      required: ['email_pattern'],
    },
  },
  count_orders: {
    description: 'Count orders for a tenant.',
    inputSchema: {
      type: 'object',
      properties: { tenant_id: { type: 'string', description: 'Tenant id' } },
      required: ['tenant_id'],
    },
    _meta: { 'toolbox/authInvoke': [] },
  },
};

export function startFakeToolbox({ requireAuth = false } = {}) {
  const seen = { headers: [], calls: [] };
  const server = createServer((req, res) => {
    let body = '';
    req.on('data', (c) => (body += c));
    req.on('end', () => {
      const send = (payload, status = 200) => {
        res.writeHead(status, { 'content-type': 'application/json' });
        res.end(JSON.stringify(payload));
      };
      if (req.method !== 'POST' || !req.url.startsWith('/mcp')) {
        return send({ error: 'not found' }, 404);
      }
      if (requireAuth && !req.headers.authorization) {
        return send({ jsonrpc: '2.0', id: null, error: { code: -32001, message: 'missing Authorization' } });
      }
      seen.headers.push(req.headers);

      const rpc = JSON.parse(body || '{}');
      const toolset = decodeURIComponent(req.url.replace(/^\/mcp\/?/, ''));
      const reply = (result) => send({ jsonrpc: '2.0', id: rpc.id, result });

      switch (rpc.method) {
        case 'initialize':
          return reply({
            protocolVersion: rpc.params.protocolVersion,
            capabilities: { tools: {} },
            serverInfo: { name: 'fake-toolbox', version: '0.0.1' },
          });
        case 'notifications/initialized':
          res.writeHead(202);
          return res.end();
        case 'tools/list': {
          const names = TOOLSETS[toolset];
          if (!names) {
            return send({ jsonrpc: '2.0', id: rpc.id, error: { code: -32602, message: `toolset "${toolset}" not found` } });
          }
          return reply({ tools: names.map((name) => ({ name, ...TOOLS[name] })) });
        }
        case 'tools/call': {
          seen.calls.push({ name: rpc.params.name, args: rpc.params.arguments, headers: req.headers });
          if (rpc.params.name === 'count_orders' && !rpc.params.arguments?.tenant_id) {
            return reply({ content: [{ type: 'text', text: 'missing tenant_id' }], isError: true });
          }
          return reply({
            content: [{ type: 'text', text: JSON.stringify({ tool: rpc.params.name, args: rpc.params.arguments }) }],
            isError: false,
          });
        }
        default:
          return send({ jsonrpc: '2.0', id: rpc.id, error: { code: -32601, message: `unknown method ${rpc.method}` } });
      }
    });
  });
  return new Promise((resolve) => {
    server.listen(0, '127.0.0.1', () =>
      resolve({ url: `http://127.0.0.1:${server.address().port}`, seen, close: () => server.close() }),
    );
  });
}
