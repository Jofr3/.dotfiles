    function omplirTaulaCaes(json) {

        const tbody = document.querySelector("#taulaCaes tbody");        
        // Limpiamos el contenido previo de la tabla
        tbody.innerHTML = "";

        // Iteramos por cada clave-valor del objeto JSON
        for (const [key, value] of Object.entries(json)) {
            const row = document.createElement("tr");

            // Columna de la clave
            const keyCell = document.createElement("td");
            keyCell.textContent = key;
            row.appendChild(keyCell);

            // Columna del valor
            const valueCell = document.createElement("td");
            valueCell.innerHTML = value;
            valueCell.title = value;
            row.appendChild(valueCell);

            // Agregamos la fila al tbody
            tbody.appendChild(row);
        }
    }


