    function crear_valor_oficina_tecnica() {
        const container = $("#container-valors-of-tecnica .panel-body");
        let maxN = 0;
        $(".registre-oficina-tecnica").each(function() {
            const number = parseInt($(this).attr('data-counter'));
            if (number > maxN) {
                maxN = number;
            }

        });
        $('#p-no-of').hide()
        maxN = maxN + 1;
        const template = `<div class="row registre-oficina-tecnica"  id="registre-oficina-tecnica-${maxN}" data-counter="${maxN}" style="margin-top:5px;"> 
                        <div class="col-md-4"> 
                        <label>Any</label>
                        <input type="number" title="Any" value="" class="form-control valor-of" name="valors_of[${maxN}][year]"> 
                        </div>
                        <div class="col-md-4">
                        <label>Import</label>
                        <input type="number" title="Import" value="" class="form-control valor-of" name="valors_of[${maxN}][import]"> 
                        </div>
                        <div class="col-md-4">
                        <label>&nbsp;</label>
                            <button class="btn btn-danger btn-sm" onclick="elimina_valor_oficina_tecnica(${maxN})" type="button">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>`;

        container.append(template)
    }
    function elimina_valor_oficina_tecnica(n){
        if($(`#registre-oficina-tecnica-${n}`).length > 0){
            $(`#registre-oficina-tecnica-${n}`).remove()
            if( $(`#registre-oficina-tecnica-${n}`).children().length < 1){
                $('#p-no-of').show()
            }
        }
    }
