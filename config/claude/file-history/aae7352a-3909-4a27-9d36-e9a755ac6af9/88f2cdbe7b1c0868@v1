function normalitzar_import_inversio($valor) {
	$valor = trim((string)$valor);
	if ($valor === '') {
		return '0';
	}

	$valor = str_replace(array('€', ' ', "\xc2\xa0"), '', $valor);
	$te_coma = strpos($valor, ',') !== false;
	$te_punt = strpos($valor, '.') !== false;

	if ($te_coma && $te_punt) {
		$valor = str_replace('.', '', $valor);
		$valor = str_replace(',', '.', $valor);
	} elseif ($te_coma) {
		$valor = str_replace(',', '.', $valor);
	} elseif ($te_punt && preg_match('/^-?\d{1,3}(\.\d{3})+$/', $valor)) {
		$valor = str_replace('.', '', $valor);
	}

	$valor = preg_replace('/[^0-9\.\-]/', '', $valor);
	return is_numeric($valor) ? $valor : '0';
}

