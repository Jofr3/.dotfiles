			var v2 = new_date2,
				d2 = new Date(v2);
			var comparing_timestamp_fi = 0;
			if (v2.length > 0) {
				comparing_timestamp_fi = (d2.getTime() / 1000);
			}
			if ($("#data_fi_inv").val() != '')
