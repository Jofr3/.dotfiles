#!/usr/bin/env node
// Multi-session build driver for the `mem` plugin.
//
// The point: each slice is built in a fresh context. This file is the only thing
// that survives between sessions, so it carries everything the next session needs.
//
//   mem-build status                 where we are
//   mem-build prompt [id]            print the self-contained prompt for a slice
//   mem-build start | pause          arm/disarm the SessionStart relay
//   mem-build done --handoff "..."   runs the slice's verify cmd, then advances
//   mem-build fail --note "..."      record a blocker and stop the loop
//   mem-build reset <id>             put a slice back to todo

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';

const BUILD_DIR = path.dirname(fileURLToPath(import.meta.url));
const STATE_PATH = path.join(BUILD_DIR, 'STATE.json');

const read = () => JSON.parse(fs.readFileSync(STATE_PATH, 'utf8'));

// Atomic, so a crash mid-write can never leave the ledger unparseable.
function write(state) {
  const tmp = `${STATE_PATH}.tmp`;
  fs.writeFileSync(tmp, `${JSON.stringify(state, null, 2)}\n`);
  fs.renameSync(tmp, STATE_PATH);
}

const nextSlice = (s) => s.slices.find((x) => x.status === 'todo' || x.status === 'in_progress');
const bySlice = (s, id) => s.slices.find((x) => x.id === id);

function arg(name, fallback = null) {
  const i = process.argv.indexOf(`--${name}`);
  return i > -1 && process.argv[i + 1] ? process.argv[i + 1] : fallback;
}

function buildPrompt(state, slice) {
  const done = state.slices.filter((x) => x.status === 'done');
  const prev = done[done.length - 1];
  const root = state.root;

  return `You are building the \`mem\` plugin — a Turso-backed memory system for Claude Code.
You are working on ONE slice. Your context is fresh; everything you need is below.

  Repo root:  ${root}
  Design doc: ${root}/${state.plan}   ← read the "${slice.plan}" section before writing code
  Ledger:     ${root}/build/STATE.json

## Slice ${slice.id} — ${slice.title}   (phase ${slice.phase})

${slice.goal}

${prev ? `## Handoff from slice ${prev.id} (${prev.title})\n\n${prev.handoff || '(none recorded)'}` : '## This is the first slice.'}

${state.blockers?.length ? `## Open blockers\n\n${state.blockers.map((b) => `- ${b}`).join('\n')}\n` : ''}
## Contract

1. Read the design doc section named above. It is the source of truth — if the goal here
   and the doc disagree, the doc wins; say so rather than guessing.
2. A previous attempt at this slice may have been interrupted (usage limit, crash) and left
   work on disk. Check what already exists before creating anything, and build on it rather
   than duplicating or clobbering it.
3. Implement ONLY this slice. Do not start the next one.
4. Verify with: \`${slice.verify}\`
5. When it passes, run:

   node ${root}/build/mem-build done --handoff "<what you built, what the next session must know, anything that surprised you>"

   That command re-runs the verify command itself and refuses to advance if it fails,
   so don't call it hopefully.
6. If you hit something that makes the slice wrong or impossible, do NOT work around it
   silently. Run:

   node ${root}/build/mem-build fail --note "<what is blocking>"

Keep the handoff short and factual — it is the only thing the next session sees.
${slice.manual ? '\nNOTE: this slice needs a human action (restarting Claude Code). Do the parts you can, then explain exactly what the user must do.\n' : ''}`;
}

const cmd = process.argv[2] || 'status';
const state = read();

switch (cmd) {
  case 'status': {
    const counts = state.slices.reduce((a, s) => ({ ...a, [s.status]: (a[s.status] || 0) + 1 }), {});
    const n = nextSlice(state);
    console.log(`relay: ${state.active ? 'ARMED' : 'paused'}   ${state.slices.length} slices  ` +
      `(done ${counts.done || 0}, todo ${counts.todo || 0}, blocked ${counts.blocked || 0})`);
    for (const s of state.slices) {
      const mark = { done: '✔', blocked: '✖', in_progress: '▸', todo: '·' }[s.status];
      console.log(`  ${mark} ${s.id.padEnd(5)} ${s.title}`);
    }
    console.log(n ? `\nnext: ${n.id} — ${n.title}` : '\nAll slices complete.');
    break;
  }

  case 'prompt': {
    const slice = arg('id') ? bySlice(state, arg('id')) : nextSlice(state);
    if (!slice) { console.error('No slice remaining.'); process.exit(1); }
    console.log(buildPrompt(state, slice));
    break;
  }

  case 'start':
  case 'pause': {
    state.active = cmd === 'start';
    write(state);
    console.log(`SessionStart relay ${state.active ? 'ARMED' : 'paused'}.`);
    if (state.active) console.log('`/clear` now hands the next slice to a fresh context.');
    break;
  }

  case 'done': {
    const slice = arg('id') ? bySlice(state, arg('id')) : nextSlice(state);
    if (!slice) { console.error('No slice in flight.'); process.exit(1); }
    const handoff = arg('handoff');
    if (!handoff) { console.error('--handoff is required: the next session sees nothing else.'); process.exit(1); }

    // Verify for real. Self-reported completion is how these loops silently rot.
    process.stderr.write(`[mem-build] verifying: ${slice.verify}\n`);
    const r = spawnSync(slice.verify, { cwd: state.root, shell: true, stdio: 'inherit' });
    if (r.status !== 0) {
      console.error(`\n[mem-build] verify FAILED (exit ${r.status}). Slice ${slice.id} stays open.`);
      process.exit(1);
    }

    slice.status = 'done';
    slice.handoff = handoff;
    slice.completed_at = new Date().toISOString();
    state.log.push({ at: slice.completed_at, slice: slice.id, event: 'done' });
    const n = nextSlice(state);
    state.current = n ? n.id : null;
    write(state);

    console.log(`\n[mem-build] ✔ ${slice.id} — ${slice.title}`);
    console.log(n ? `[mem-build] next: ${n.id} — ${n.title}\n\n→ /clear to continue in a fresh context.`
      : '[mem-build] All slices complete.');
    break;
  }

  case 'fail': {
    const slice = arg('id') ? bySlice(state, arg('id')) : nextSlice(state);
    const note = arg('note');
    if (!slice || !note) { console.error('Usage: mem-build fail --note "<blocker>"'); process.exit(1); }
    slice.status = 'blocked';
    slice.blocker = note;
    state.active = false; // never loop on a blocked slice
    state.blockers = [...(state.blockers || []), `${slice.id}: ${note}`];
    state.log.push({ at: new Date().toISOString(), slice: slice.id, event: 'blocked', note });
    write(state);
    console.log(`[mem-build] ✖ ${slice.id} blocked. Relay paused.\n  ${note}`);
    break;
  }

  case 'reset': {
    const slice = bySlice(state, process.argv[3]);
    if (!slice) { console.error('Usage: mem-build reset <slice-id>'); process.exit(1); }
    slice.status = 'todo';
    delete slice.blocker;
    state.current = nextSlice(state)?.id ?? null;
    write(state);
    console.log(`[mem-build] ${slice.id} reset to todo.`);
    break;
  }

  default:
    console.error(`Unknown command: ${cmd}`);
    process.exit(1);
}
