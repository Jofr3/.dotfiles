import { connect } from '@tursodatabase/database';

const db = await connect('probe.db');
const q = async (sql, args = []) => {
  try { return await db.prepare(sql).all(args); }
  catch (e) { return { ERR: String(e.message || e) }; }
};

console.log('version:', JSON.stringify(await q('select sqlite_version() v')));

// vector column + distance
console.log('create:', JSON.stringify(await q(
  'CREATE TABLE IF NOT EXISTS m (id INTEGER PRIMARY KEY, text TEXT, emb F32_BLOB(4))')));
console.log('create-blob:', JSON.stringify(await q(
  'CREATE TABLE IF NOT EXISTS m2 (id INTEGER PRIMARY KEY, text TEXT, emb BLOB)')));

console.log('insert:', JSON.stringify(await q(
  "INSERT INTO m2 (text, emb) VALUES ('hello', vector32('[1,0,0,0]')), ('world', vector32('[0,1,0,0]'))")));
console.log('cos:', JSON.stringify(await q(
  "SELECT text, vector_distance_cos(emb, vector32('[1,0.1,0,0]')) d FROM m2 ORDER BY d LIMIT 2")));
console.log('extract:', JSON.stringify(await q('SELECT vector_extract(emb) FROM m2 LIMIT 1')));
console.log('vector8:', JSON.stringify(await q("SELECT vector_extract(vector8('[1,0,0,0]')) x")));

// ANN index?
console.log('ann-idx:', JSON.stringify(await q(
  "CREATE INDEX m2_idx ON m2 (libsql_vector_idx(emb, 'metric=cosine'))")));
console.log('vector_top_k:', JSON.stringify(await q(
  "SELECT * FROM vector_top_k('m2_idx', vector32('[1,0,0,0]'), 2)")));

// FTS?
console.log('fts5:', JSON.stringify(await q(
  "CREATE VIRTUAL TABLE ft USING fts5(body)")));
console.log('fts-native:', JSON.stringify(await q(
  "CREATE INDEX m2_fts ON m2 (text) USING fts")));
console.log('fts_match:', JSON.stringify(await q(
  "SELECT text FROM m2 WHERE fts_match(text, 'hello')")));

// concurrency
console.log('begin-concurrent:', JSON.stringify(await q('BEGIN CONCURRENT')));
await q('COMMIT');
