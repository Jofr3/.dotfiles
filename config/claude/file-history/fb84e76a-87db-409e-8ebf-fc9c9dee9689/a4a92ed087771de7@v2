import { connect } from '@tursodatabase/database';
import fs from 'node:fs';

fs.rmSync('bench.db', { force: true });
const db = await connect('bench.db');
const DIM = 768;
const N = Number(process.argv[2] || 20000);

await db.exec('CREATE TABLE m (id INTEGER PRIMARY KEY, text TEXT, kind TEXT, emb BLOB)');

const rnd = (() => { let s = 42; return () => (s = (s * 1103515245 + 12345) % 2147483648) / 2147483648; })();
const vec = () => `[${Array.from({ length: DIM }, () => rnd().toFixed(4)).join(',')}]`;

let t = performance.now();
const ins = db.prepare('INSERT INTO m (text, kind, emb) VALUES (?, ?, vector32(?))');
await db.exec('BEGIN');
for (let i = 0; i < N; i++) ins.run([`memory number ${i} about topic ${i % 97}`, i % 3 ? 'fact' : 'pref', vec()]);
await db.exec('COMMIT');
console.log(`insert ${N}x${DIM}d: ${(performance.now() - t).toFixed(0)}ms`);
console.log(`db size: ${(fs.statSync('bench.db').size / 1e6).toFixed(1)} MB`);

const qv = vec();
for (const label of ['cold', 'warm', 'warm2']) {
  t = performance.now();
  const r = await db.prepare(
    'SELECT id, text, vector_distance_cos(emb, vector32(?)) d FROM m ORDER BY d LIMIT 10',
  ).all([qv]);
  console.log(`knn ${label}: ${(performance.now() - t).toFixed(1)}ms  top=${r[0].id} d=${r[0].d.toFixed(4)}`);
}

t = performance.now();
await db.prepare(
  "SELECT id, vector_distance_cos(emb, vector32(?)) d FROM m WHERE kind='pref' ORDER BY d LIMIT 10",
).all([qv]);
console.log(`knn+filter: ${(performance.now() - t).toFixed(1)}ms`);

// fts_match sanity
console.log('fts_match hit :', (await db.prepare("SELECT count(*) c FROM m WHERE fts_match(text,'topic')").all()));
console.log('fts_match miss:', (await db.prepare("SELECT count(*) c FROM m WHERE fts_match(text,'zzzznope')").all()));
console.log('fts_score     :', await db.prepare("SELECT fts_score(text) s FROM m LIMIT 1").all().catch?.(e => e) ?? '');
