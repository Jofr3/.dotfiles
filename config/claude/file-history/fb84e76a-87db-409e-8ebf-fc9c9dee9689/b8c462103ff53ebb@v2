#!/usr/bin/env node
// SessionStart relay: turns `/clear` into "next slice, fresh context".
//
// This runs on EVERY session start, so it is written to be inert and harmless:
// any error, any missing file, any inactive build -> exit 0 with no output.
// It only ever speaks when a build is explicitly armed via `mem-build start`.
//
// Deliberate asymmetry:
//   source=clear   -> initialUserMessage (auto-starts the next slice)
//   anything else  -> additionalContext only (a status line, never auto-starts work)
// So opening a session never puts you to work; you opt in by typing /clear.

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';

const BUILD_DIR = path.dirname(fileURLToPath(import.meta.url));

const silent = () => process.exit(0);

function main() {
  let input = '';
  try {
    input = fs.readFileSync(0, 'utf8');
  } catch { return silent(); }

  let evt;
  try { evt = JSON.parse(input); } catch { return silent(); }

  let state;
  try {
    state = JSON.parse(fs.readFileSync(path.join(BUILD_DIR, 'STATE.json'), 'utf8'));
  } catch { return silent(); }

  if (!state.active) return silent();

  // Only relay inside the repo this build belongs to.
  const cwd = evt.cwd || process.cwd();
  if (!path.resolve(cwd).startsWith(path.resolve(state.root))) return silent();

  const slice = state.slices.find((s) => s.status === 'todo' || s.status === 'in_progress');
  if (!slice) {
    return emit({
      additionalContext: 'mem build: all slices complete. Run `mem-build pause` to disarm the relay.',
    });
  }

  if (evt.source === 'clear') {
    const r = spawnSync(process.execPath, [path.join(BUILD_DIR, 'mem-build'), 'prompt'], {
      encoding: 'utf8',
      timeout: 10_000,
    });
    if (r.status !== 0 || !r.stdout) return silent();
    return emit({
      initialUserMessage: r.stdout,
      sessionTitle: `mem ${slice.id} — ${slice.title}`,
    });
  }

  const done = state.slices.filter((s) => s.status === 'done').length;
  return emit({
    additionalContext:
      `mem build is armed: ${done}/${state.slices.length} slices done, next is ${slice.id} — ${slice.title}. ` +
      'Type /clear to start it in a fresh context, or `mem-build pause` to disarm.',
  });
}

function emit(hookSpecificOutput) {
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: { hookEventName: 'SessionStart', ...hookSpecificOutput },
  }));
  process.exit(0);
}

try { main(); } catch { silent(); }
