    `${SOURCE_ZONE_PHRASE} ([^.]+)  .$`,
);

                                                                             
                                                                               
                                                                                
                                               
  
           
                                                                                 
                                                                                 
                                                
                                
                                                                        
                                 
                                                               
        
  
                                                                                
                                                                         
                                                                                 
                                                                               
                                                                          
                                                                               
                                                                                 
                                                                                 
                                                                                
                                                                               
  
                                                                                
               
                                                                                
                                                                           
                                                                             
                                                                           
                                                                            
                                                                                  
                                                                      
                                                                           
                                            
  
                                                                             
                                                                               
                                                                                 
                                                                                 
                                                                                  
                                                        
                                                                                
                                                                                   
                                                                                  
                                                                                  
                                                                                   
                                                                                
                                                                                
                                                                              
  
                                                                          
                          
                                                                                
                                                                             
                                                                            
                                                                           
                   
                                                                                
                                                                                
                                                                                
                                                                      
                                                                               
                                                                          
                                                                             
                                                                               
                                                                              
                                                                                
                                                                                
                                                                           
                                                                                  
                                                                               
                                                                                 
                                                                            
                                                           
                                                                                  
                                                
                                                                                 
                                                                                 
                                                                           
                                                                                  
                                                                             

                                                                                 
                                                                                 
                                                                                 
                                                                              

                                                                                 
                                                                                
                                                                          
                               
