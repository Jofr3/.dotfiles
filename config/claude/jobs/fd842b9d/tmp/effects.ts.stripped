    }
  }
                                                                               
                                                                                 
                                                                                  
                                         
    
                                                                                
                                                                            
                                                                              
                                                                                  
                                                                             
                                                                             
    
                                                                                  
                                                                                 
                                                                                   
                                                                                  
                                                                                   
                                                                                
                                                                                 
                 
  match = PREVENT_DAMAGE_UP_TO_CAP.exec(effect);
  if (match !== null && match[2] === "less") {
