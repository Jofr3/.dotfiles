);

                                                                           
                                                                              
                                                                               
                                                                              
                                                                         
                                                                               
                                                                                
                                                                                
                                                                     

                                                                              
                                                                                
                                                                             
                                                                             
                                                                                 
                                                                            
                                                                   

                                                                              
                                                                             
                                                                      
                                                                             
                                       
export function searchTopOrderProgram(n: number): EffectOp[] {
  return [
    { op: "shuffleDeck" },
    {
      op: "searchDeck",
                                                                                 
                                                                           
                                                                             
                                                                              
                                     
      filter: { kind: "anyCard" },
      max: n,
                                                                           
                                                                             
                                                                         
      exact: true,
      dest: "deckTop",
    },
                                                                           
                                                                                
                                                                        
    { op: "reorderTop", n },
  ];
}

                                                                  
                                                                   

                                                                                
                                                                               
                                                                              
                                                                              
                                                                          

                                                                                 
                                                                                  
                                                                               
                                                                            
                                                                               
                                                   

                                                                                
                                                                                
                                                                                
                                                                                 
                                                                       
                                                                        
                                                                                
                                                                                   
                                                                                 
                                                               
  
                                                                               
                                                                                    
                                                                                    
                                                                                    
                                                                                   
                                                                                    
                                                                                     
                                                                                     
                                                                                      
                                                                                     
                                                         
  
                                                                             
                                                                                  
                                                                                 
                                                                            
  
                                                                                
                                                                                  
                                                                                  
