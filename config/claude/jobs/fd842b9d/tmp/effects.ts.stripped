    if (match[3] !== undefined) return [{ op: "returnBenched", whose: "self", dest: "hand" }];
    const shuffleAway: EffectOp = { op: "returnBenched", whose: "opponent", dest: "deck" };
                                                                               
                                                                                
                                                                               
                                        
    if (match[4] !== undefined) {
