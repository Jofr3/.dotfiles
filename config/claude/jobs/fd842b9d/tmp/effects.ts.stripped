    ")  .$",
);


                                                                               
                            

                                                                                  
                                                                                  
                                                                                   
                                                                                 
                                                                                  
                                                                                    
                                                                  

                                                                                
                                                                                 
                                                                                  
                                                                                 
                                                                                    
                                                                                     
                                                                                    
                                                                          
const DISCARD_STADIUM = /^Discard a Stadium in play\.$/;
const MAY_DISCARD_STADIUM = /^You may discard a Stadium in play\.$/;

                                                                                  
                                                                                 
                                                                                   
                                                                                 
                                                                                    
                                                                 

                                                                                  
                                                                                  
                                                                                
                                                                                       
                                                                                       
                                                                                      
                                                                                  

                                                                                    
                                                                                      
                                                                              
                                                                                     
                                                                                     
                                                                                   
                                                                              
const DISCARD_HAND_DRAW = /^Discard your hand and draw (\d+) cards\.$/;

                                                                               
                                                                                  
                                                                                   
                                                                                   
                                                      

                                                                                     
                                                                                       
                                                                                     
                                                                                       
                                                                                    
                                                                                      
                                                                                 
                                            

                                                                                     
                                                                                  
                                                                                     
                                                                              
                                                                                     
                                                                                      
                                                                      

                                                                                    
                                                                                  
                                                                                     
                                                                                   
                                                                  

                                                                                    
                                                                                      
                                                                                   
                                                                                 
                                                                                      
                                                                                  
                                                       

                                                                               
                                                                                        
                                                                                      
                                                                                  
                                                                                     
                                                                                     
                                                                                    
                                                                             
                                                                                     
                                                                                        
                    
const SHUFFLE_HAND_DRAW = /^Shuffle your hand into your deck\. Then, draw (\d+) cards\.$/;

                                                                            
                                                                       
                                                                                       
                                                                                      

                                                                                
                                                                                         
                                                                                     
                                                                                        
                                                                                         
                                                                                       
                                                                                      
                                                                             

                                                                               
                                                                                     
                                                                                   
                                                                                      
                                                                        
                                                                                         
                                                                                       
                                                                               

                                                                           
                                                                                         
                                                                                       
                                                                                         
                                                                                      
                                                                                       
                                                         

                                                                                    
                                                                                           
                                                                                        
                                                                                       
                                                                        
                                                                                   
                                           
const SHUFFLE_HAND_DRAW_PER_OPPONENT_HAND =
  /^Shuffle your hand into your deck\. Then, draw a card for each card in your opponent's hand  $/;

/** 🆕🆕 D473 — *"Discard a card from your hand. If you do, draw {N} cards."* — **2
    sentences / 2 legal printings** (file lines 101 and 102, `N` = 2 and 3), and the
    best sentences-per-anchor ratio left in the residue: ONE capture claims BOTH rows.

    🛑 **THE PRINTED *"If you do,"* IS NOT A NEW MECHANISM, AND THAT IS THE WHOLE
    PRICE OF THIS ARM.** It is §9.2's `recordGate` — an OP-RESULT branch that runs its
    `then` when an earlier op in the same program filed at least one card under
    `slot`, shipped since D148 and spelled by Miriam, Dendra and Kofu in
    `registry.ts`. The head is `payFromHand`, the only op in this union that removes a
    CHOSEN card from the controller's own hand (`discardHand` takes the whole hand;
    `handRefresh` shuffles it into the deck; `opponentDiscardsFromHand` and
    `bottomFromOpponentHand` act on the other seat's). So the program is three shipped
    ops in the shipped order, and this slice writes no op, no op field and no op value.

    🛑 **THE EMPTY HAND IS THE REASON THE GATE IS NOT DECORATION.** `payFromHand`'s
    short-hand branch *"pays what there is"* (interpreter.ts: an offer no bigger than
    the count resolves inline), so on an empty hand it discards nothing and files
    nothing — and `recordGateHolds` answers **false** for a slot filed with zero uids,
    so the draw does not happen. Without the gate the attack would draw for free off a
    price the engine never collected, which is exactly the hazard D420's structural
    guard in `handEnergyCancel.test.ts` §4 exists to forbid. See that guard's own block
    for why the GATED shape is admitted there and the bare one still is not.

    ⚠️ **THE SUBJECT AND THE CONSEQUENT ARE BOTH SPELLED OUT RATHER THAN CAPTURED, AND
    BOTH WIDENINGS WERE MEASURED OVER ALL 640 ROWS (D472).**
      • `^Discard (.+) from your hand   If you do, draw (  +) cards  $` claims the
        **IDENTICAL 2 sentences / 2 printings** — it buys nothing and costs a
        wrong-but-plausible program, since a captured noun would derive a FILTERED
        cost as this arm's unfiltered `payFromHand` (D190b/D199).
      • `^Discard a card from your hand   If you do, (.+)  $` claims a **THIRD** row
        — *"…If you do, your opponent discards a card from their hand."* (file line
        103, 1 printing) — whose consequent is a different op that `describeBranch`
        has no phrase for, so the park's caption would silently degrade to the bare
        cost while the sentence read as claimed. That row is already tracked as a
        named `DEFERRED` in `opponentHandDiscard.test.ts` with its own reason.
        🆕🆕🆕 **D515 BUILT THAT ROW, AND EVERY CLAUSE ABOVE WAS TRUE WHEN WRITTEN AND
        IS NOW HISTORY RATHER THAN A REFUSAL** (D178: provenance is annotated, never
        overwritten). The blocker named here — `describeBranch` — was the real one and
        the only one: D515 pays it with ONE case in that switch and claims the row with
        its OWN anchor (`HAND_COST_THEN_OPPONENT_DISCARD`, arm 44b), so the widening
        this bullet refuses is STILL refused and for the same reason it always was. The
        caption degradation is no longer a forecast; it is driven on both sides of the
        describer arm in `handCostOpponentDiscard.test.ts` §5.

    ⚠️ **THE COUNT IS CAPTURED FOR D404'S REASON**: the column prints 2 and 3 on the
    same skeleton, which is D121's two-printings-one-token-varying warrant met inside
    this single anchor rather than argued for across files. The `>= 1` guard is the one
    every counted arm here carries. */
const HAND_COST_THEN_DRAW = /^Discard a card from your hand   If you do, draw (  +) cards  $/;

/** 🆕🆕🆕 D515 — *"Discard a card from your hand. If you do, your opponent discards a
    card from their hand."* — **1 sentence / 1 legal printing** (file line 103), the
    THIRD and LAST member of the printed `Discard a card from your hand. If you do, …`
    family, and the exact row `HAND_COST_THEN_DRAW`'s block one screen up measured,
    named and refused.

    🛑 **THE ANCHOR WAS NEVER THE BLOCKER, AND D473 WROTE DOWN WHICH ONE WAS.** D472's
    measurement is on record: widening that anchor's consequent to `(.+)` claims THIS
    row and no other, and the reason it was refused is not the regex and not a missing
    op — it is `interpreter.ts`'s `describeBranch`, which had **no phrase** for
    `opponentDiscardsFromHand`. `withConsequence` looks DOWN THE QUEUE from the parking
    payment for the gate that reads its slot and appends the printed conditional; with
    no phrase for the branch it returns the prompt unchanged, so the park's caption
    degrades to the bare *"Discard a card from your hand."* — byte-identical to the
    caption of an UNGATED payment — while the census records the sentence built. That
    degradation is DRIVEN in this slice's suite on both sides of the new arm, which is
    what turns D473's forecast into a measurement (D446: a predicted SHAPE is not the
    measurement that predicted it).

    🛑 **SO THE PRICE IS ONE ANCHOR, ONE ARM AND ONE DESCRIBER CASE — AND ZERO NEW
    MECHANISM.** `payFromHand` is the head (the only op in the union that removes a
    CHOSEN card from the controller's own hand), `recordGate` is §9.2's op-result
    branch, and `opponentDiscardsFromHand { count: 1 }` has been produced by the
    OPPONENT-CHOOSES arm of this very function since D426 and by D486's gated
    increment since. This slice writes no op, no op field and no op value.

    ⚠️ **THE CONSEQUENT IS SPELLED OUT AND ITS COUNT IS NOT CAPTURED, WHICH IS THE
    OPPOSITE CALL FROM THE SIBLING ANCHOR'S — MEASURED, NOT PREFERRED.** The draw
    anchor captures `(  +)` because the column prints 2 and 3 on one skeleton (D121's
    two-printings-one-token-varying warrant). Here the column prints the GATED form
    exactly once, at *"a card"*: a `(a card|  + cards)` alternation claims the
    identical 1 sentence / 1 printing, buys nothing, and ships a capture no printing
    can falsify (D231's unkillable singleton). The standalone family DOES print both
    counts (*"Your opponent discards a card from their hand."*, 2 printings, and
    *"…discards 2 cards from their hand."*, 4) and `ATTACK_OPPONENT_DISCARDS_HAND`
    already reads both — so the plural is not unexpressible, it is unprinted HERE, and
    §1 of the suite measures that as zero rather than asserting it.

    ⚠️ **AND THE HEAD IS SPELLED OUT FOR D473's REASON VERBATIM**: a captured noun
    would derive a FILTERED printed cost as this arm's unfiltered `payFromHand`
    (D190b/D199), and the widening buys the identical row count. */
const HAND_COST_THEN_OPPONENT_DISCARD =
  /^Discard a card from your hand\. If you do, your opponent discards a card from their hand\.$/;

                                                                           
                                                                        
                                                                               
export function deriveAttackEffect(text: string): EffectOp[] | null {
  const effect = text.trim();

                                                    
  let match = DEFENDER_NOW.exec(effect);
  if (match !== null) {
    return [{ op: "applyStatus", target: "defender", status: statusOf(match[1]) }];
  }

                                                                           
  match = FLIP_DEFENDER_NOW.exec(effect);
  if (match !== null) {
    return [
      {
        op: "coinFlipGate",
                                                                                                                                                  
        then: [{ op: "applyStatus", target: "defender", status: statusOf(match[1]) }],
      },
    ];
  }

                                                                          
                                                                                   
                                                                                 
                                                                                   
                                                                    
    
                                                                             
                                                                                    
                                                                                  
                                                                                
                                                                                   
                                                  
    
                                                                                  
                                                                                 
                                                                                
                                                                               
                                                              
  match = DEFENDER_STATUS_PAIR.exec(effect);
  if (match !== null) {
    return defenderStatusOps([match[1], match[2]]);
  }

  match = FLIP_DEFENDER_STATUS_PAIR.exec(effect);
  if (match !== null) {
    const then = defenderStatusOps([match[1], match[2]]);
    return then === null
      ? null
      : [
          {
            op: "coinFlipGate",
            then,
          },
        ];
  }

                                                                                    
                                                                             
                                                                                       
                                                                                     
                                                                               
                                                                        
    
                                                                             
                                                                                   
                                                                                    
                                                                                  
                                                     
    
                                                                                     
                                                                         
                                                                                  
                                                                                   
                                                                                       
                                                                                  
                                      
    
                                                                                
                                                                                  
                                                                                    
                                                                   
  match = FLIP_DEFENDER_PAIR_OR_TAILS_STATUS.exec(effect);
  if (match !== null) {
    const heads = defenderStatusOps([match[1], match[2]]);
    return heads === null
      ? null
      : [
          {
            op: "coinFlipGate",
                                                                                                                                                      
            then: heads,
            otherwise: [
              { op: "applyStatus", target: "defender", status: statusOf(match[3]) },
            ],
          },
        ];
  }

                                                                                   
                                                                                      
                                                                          
                                                                                 
                                                                                   
                                                                                      
                                                                                   
                         
    
                                                                                  
                                                                                 
                                                                                     
    
                                                                                  
                                                                                 
                                                                                 
                                                              
  match = DEFENDER_STATUS_TRIPLE.exec(effect);
  if (match !== null) {
    return defenderStatusOps([match[1], match[2], match[3]]);
  }

                                                                                     
                                                                                      
                                                                                     
                                         
    
                                                                                    
                                                                              
                                                                                        
                                                                                         
                                                                                    
    
                                                                                    
                                                                                         
                                                                                        
                                                                                        
    
                                                                                      
                                                                                     
                                                                                       
                                                                                       
                                                    
  match = FLIP_DEFENDER_STATUS_THEN_DISCARD.exec(effect);
  if (match !== null) {
    return [
      {
        op: "coinFlipGate",
                                                                                                                                                  
        then: [
          { op: "applyStatus", target: "defender", status: statusOf(match[1]) },
          { op: "discardEnergy", from: "opponentActive", filter: { kind: "anyEnergy" } },
        ],
      },
    ];
  }

                                                                               
                                                                                  
                                                                                  
                                                                                    
                                                                                 
                                                                                
                                                                                   
                                                     
    
                                                                                   
                                                                                 
                                                                               
                                                                               
                                                                               
                                                                                     
                                                                                     
                                                                           
  match = CLAUSE_GATED_DEFENDER_NOW.exec(effect);
  if (match !== null) {
                                                                                  
                                                                                      
                                                                                     
                                                                                    
                                                                               
                                                        
                                                                                      
                                                                                     
                                                                                    
                                                                                      
                                                                              
    const gate = boardConditionForClause(match[1] ?? "");
    if (gate !== null) {
      return [
        {
          op: "conditionGate",
          cond: gate,
                                                                                                                                                    
          then: [{ op: "applyStatus", target: "defender", status: statusOf(match[2]) }],
        },
      ];
    }
  }

                                                                
                                                                
  match = SELF_NOW.exec(effect);
  if (match !== null) {
    return [{ op: "applyStatus", target: "self", status: statusOf(match[1]) }];
  }

                                                              
  match = SELF_SLEEP_HEAL.exec(effect);
  if (match !== null) {
    return [
      { op: "applyStatus", target: "self", status: "asleep" },
      { op: "heal", target: "self", amount: Number(match[1]) },
    ];
  }

                                                                       
                                                                       
  match = DEFENDER_POISON_N.exec(effect);
  if (match !== null) {
                                             
    return [
      {
        op: "applyStatus",
        target: "defender",
        status: "poisoned",
        poisonDamage: Number(match[1]) * 10,
      },
    ];
  }

                                                                            
                                                                      
                                                                           
    
                                                                                 
                                                                                
                                                                      
    
                                                                                  
                                                                                  
                                                                          
                                                                                
                                                                              
                                                                                 
                                                                                 
                               
    
                                                                                 
                                                                                  
                                                                                 
                                                         
  match = DEFENDER_CONFUSION_N.exec(effect);
  if (match !== null) {
    const counters = Number(match[1]);
    if (counters >= 1) {
      return [
        {
          op: "applyStatus",
          target: "defender",
          status: "confused",
          confusionDamage: counters * 10,
        },
      ];
    }
  }

                                                                       
                                                                            
                      
  match = DEFENDER_CANT_RETREAT.exec(effect);
  if (match !== null) {
    return [{ op: "preventRetreat" }];
  }

                                                                                
                                                                          
                                                                             
  match = DEFENDER_POISON_CANT_RETREAT.exec(effect);
  if (match !== null) {
    return [
      { op: "applyStatus", target: "defender", status: "poisoned" },
      { op: "preventRetreat" },
    ];
  }

                                                                        
                                                                                  
                                                                      
                                                                                  
                                                                           
                                                                             
                                                                                 
    
                                                                                  
                                                                                   
                                                                                 
                                                                                 
                                                                                  
                                                                    
  match = DEFENDER_PRONOUN_CANT_RETREAT.exec(effect);
  if (match !== null) {
    return [{ op: "preventRetreat" }];
  }

                                                                             
                                                                          
                                                                             
                                                                            
                                                                               
                                                                                  
    
                                                                                
                                                                                
                                                                                
                                                                                
                                                                            
                                                                               
                                                                               
                                                                
  match = SELF_CANT_RETREAT.exec(effect);
  if (match !== null) {
    return [{ op: "preventRetreat", target: "self" }];
  }

                                                                           
                                                                              
                                                                                   
                                                                                 
                                                
    
                                                                                   
                                                                                     
                                                                                    
                                                                                    
                                                                       
    
                                                                                 
                                                                                    
                                                                                    
                                           
  match = DELAYED_DEFENDER_COUNTERS.exec(effect);
  if (match !== null) {
    const counters = Number(match[1]);
    if (counters >= 1) return [{ op: "scheduleCounters", amount: counters * 10 }];
  }

                                                                                  
                                                                                    
                                                                                     
                                                                 
    
                                                                                     
                                                                                     
                                                                                    
                                                                                      
                                                         
  match = DELAYED_DEFENDER_DISCARD.exec(effect);
  if (match !== null) {
    return [{ op: "scheduleDiscard" }];
  }

                                                                                  
                                                                                   
                                                                                     
    
                                                                                
                                                                         
                                                                                  
                                                                                      
                                                                                   
                                                                                
                                                                                  
                          
  match = DELAYED_DEFENDER_KO.exec(effect);
  if (match !== null) {
    return [{ op: "scheduleKnockOut" }];
  }

                                                                               
                                                                        
                                                                                
                                                                          
  match = OPPONENT_ACTIVE_BASIC_KO.exec(effect);
  if (match !== null) {
    return [
      {
        op: "conditionGate",
        cond: { kind: "opponentActiveIsBasic" },
                                                                                                                                                  
        then: [{ op: "knockOutDefender" }],
      },
    ];
  }

                                                                               
                                                                             
                                                                                    
                                                                                 
                                                                            
  match = OPPONENT_ACTIVE_SPECIAL_ENERGY_KO.exec(effect);
  if (match !== null) {
    return [
      {
        op: "conditionGate",
        cond: { kind: "opponentActiveHasEnergyAttached", energy: "special" },
                                                                                                                                                  
        then: [{ op: "knockOutDefender" }],
      },
    ];
  }

                                                                                   
                                                                                  
                                                                                    
                                                                               
                                                                                  
                                                                               
                                                                                
                                                       
    
                                                                                 
                                                                                 
                                                                                    
                                                                                    
                                                                          
                                                                             
                                                                                  
                                                                                   
                                                       
  match = SELF_PRIZE_GATE_PARALYZE.exec(effect);
  if (match !== null) {
    return [
      {
        op: "conditionGate",
        cond: { kind: "yourPrizesRemaining", counts: [1] },
                                                                                                                                                  
        then: [{ op: "applyStatus", target: "defender", status: "paralyzed" }],
      },
    ];
  }

                                                                       
                                                                             
                                                                                  
                                                                                 
                                                                              
                                                                          
  match = BOTH_ACTIVES_KO.exec(effect);
  if (match !== null) {
    return [{ op: "knockOutDefender" }, { op: "knockOutSelf" }];
  }

                                                                                  
                                                                                    
                                                                               
                                                                                   
                                                                             
                                                
  match = SELF_DAMAGE_THEN_COIN_KO.exec(effect);
  if (match !== null) {
    const amount = Number(match[1]);
                                                                                
                                                  
    if (amount >= 1) {
      return [
        { op: "damageSelf", amount },
        {
          op: "coinFlipGate",
                                                                                                                                                  
          then: [{ op: "knockOutDefender" }],
        },
      ];
    }
  }

                                                                                 
                                                                                  
                                                                               
                                                                         
                                                        
    
                                                                       
                                                                           
                                                                             
                                                                                
                                                                                
                                           
                                                                                  
                                                                            
                                                                                   
                                                                                   
                                                                                  
                                                                                   
                              
    
                                                                                
                                                                               
                                                                    
  match = FLIP_KO_ACTIVE_OR_BENCHED_BASIC.exec(effect);
  if (match !== null) {
    return [
      {
        op: "coinFlipGate",
                                                                                                                                                  
        then: [
          {
            op: "conditionGate",
            cond: { kind: "opponentActiveIsBasic" },
                                                                                                                                                      
            then: [{ op: "knockOutDefender" }],
          },
        ],
        otherwise: [{ op: "knockOutChosen", target: "opponentBench", basicOnly: true }],
      },
    ];
  }

                                                                             
                                                                                
                                                                                
                                                                                 
                                       
    
                                                                                   
                                                                                    
                                                
  match = KO_EXACT_DAMAGE_COUNTERS.exec(effect);
  if (match !== null) {
    const counters = Number(match[1]);
    if (counters >= 1) {
      return [{ op: "knockOutChosen", target: "opponentAny", damageCountersExactly: counters }];
    }
  }

                                                                                    
                                                                               
                                                                                    
                                                                                      
                              
    
                                                                                   
                                                                                     
                                                                                       
                                                                                
                                                                                      
                                                                                    
                                                                                  
                                                                                       
                                                                                 
                                                                               
                                       
    
                                                                          
                                                                             
                                                                                  
                                                                                  
                                                                                    
                                                                 
  match = HAND_BASIC_ENERGY_COST.exec(effect);
  if (match !== null) {
                                                                                  
                                                                                      
                                                          
    const count = match[1] === undefined ? 1 : Number(match[1]);
    const energyType = ENERGY_TYPE_BY_CODE[match[2] ?? match[4] ?? ""];
                                                                                      
                                                                                    
                                                                                  
                                                                                 
    if (count >= 1 && energyType !== undefined) {
      return [
        {
          op: "payFromHand",
          count,
          to: "discard",
          filter: { kind: "basicEnergy", energyType },
        },
      ];
    }
  }

                                                                                    
                                                                                    
                                                                              
    
                                                                                     
                                                                                     
                                                                                     
                                                                                    
                                                                                 
                                 
    
                                                                                 
                                                                                   
                                                                                      
                                                                                    
    
                                                                                      
                                                                                      
                                                                                      
                                                                              
  match = HAND_BASIC_ENERGY_COST_KO.exec(effect);
  if (match !== null) {
    const count = Number(match[1]);
    const energyType = ENERGY_TYPE_BY_CODE[match[2] ?? ""];
    if (count >= 1 && energyType !== undefined) {
      return [
        {
          op: "payFromHand",
          count,
          to: "discard",
          filter: { kind: "basicEnergy", energyType },
        },
        { op: "knockOutDefender" },
      ];
    }
  }

                                                                                  
                                                                               
                                                                             
    
                                                                               
                                                                                
                                                                                 
                                                                                
                                                                                
                                                                              
                                                                                  
  match = OPPONENT_CANT_PLAY.exec(effect);
  if (match !== null) {
    return [{ op: "preventHandPlay", bars: handPlayClassOf(match[1]) }];
  }
  match = OPPONENT_CANT_PLAY_TRAILING.exec(effect);
  if (match !== null) {
    return [{ op: "preventHandPlay", bars: handPlayClassOf(match[1]) }];
  }
                                                                          
                                                                                  
                                                                                 
                                                              
  if (OPPONENT_CANT_EVOLVE_FROM_HAND.test(effect)) {
    return [{ op: "preventHandPlay", bars: "evolve" }];
  }
                                                                                  
                                                                                   
                                                                              
                                                                                  
                                                                                   
  match = SELF_DISCARD_ALL_THEN_HAND_LOCK.exec(effect);
  if (match !== null) {
    return [
      { op: "discardEnergy", from: "yourActive", filter: { kind: "anyEnergy" }, count: "all" },
      { op: "preventHandPlay", bars: handPlayClassOf(match[1]) },
    ];
  }

                                                                           
                                                                                  
                                                                                    
                                                                               
                                                                                    
                                                                                
                                                                                   
                   
  match = SELF_RECOVERS_ALL.exec(effect);
  if (match !== null) {
    return [{ op: "clearStatus" }];
  }

                                                                                   
                                                                                  
                                                                                 
                                                                                       
                                                                                       
                                                                                   
                                                                  
    
                                                                                   
                                                                                
                                                                                         
                                                                                        
                                                                                       
                                                                                       
                                                                                     
                                                                                     
                                                                                    
                                                                              
                                                                                   
                                                                                  
                                                                                        
                                                                                     
                                                  
    
                                                                                    
                                                                                      
                                                                                     
                                                                                  
                                                                                       
                                                                         
  match = SPREAD_EACH_BENCH_TAKEN_PRIZES.exec(effect);
  if (match !== null) {
    return [
      {
        op: "spreadDamage",
        target: "opponentBench",
        amount: Number(match[1]),
        perTakenPrize: true,
      },
    ];
  }

                                                                              
                                                                           
                                                                              
                                                                            
                                                                               
                                                                           
                                                                                   
                                                                                      
                                                                                       
                                                                                        
                                                                                       
                                                                                      
  match = SPREAD_EACH_BENCH.exec(effect);
  if (match !== null) {
                                                                                
                                                                                   
                                                                                   
                                                                                    
                                                                                     
                                                                                     
    const side = match[2] === "your" ? ("yourBench" as const) : ("opponentBench" as const);
    return [{ op: "spreadDamage", target: side, amount: Number(match[1]) }];
  }

                                                                                       
                                                                                      
                                                                                        
                                                                                          
                                                                                        
                                                                                        
                                                              
    
                                                                                       
                                                                                 
                                                                                          
                                                                                     
                                                                                      
                                                                                        
                                                                                          
                                                                                        
                                                                                          
                                                       
    
                                                                                         
                                                                                     
                                                                                    
                                                                                          
                                                                             
                                                                                          
                                                                                     
                
  match = SPREAD_EACH_BOTH_BENCH.exec(effect);
  if (match !== null) {
    const amount = Number(match[1]);
                                                                                        
                                                                                      
                                                                                   
                                                                                     
    const damagedOnly = match[2] !== undefined;
    return [
      damagedOnly
        ? { op: "spreadDamage", target: "yourBench", amount, damagedOnly: true }
        : { op: "spreadDamage", target: "yourBench", amount },
      damagedOnly
        ? { op: "spreadDamage", target: "opponentBench", amount, damagedOnly: true }
        : { op: "spreadDamage", target: "opponentBench", amount },
    ];
  }

                                                                               
                                                                                   
                                                                    
                                                                                      
                                               
    
                                                                              
                                                                                      
                                                                                  
                                                                                      
                                                                                      
                                                                         
    
                                                                               
                                                                                   
                                                                                     
                                                                                       
                                                                 
    
                                                                            
                                                                                    
                                                                                      
                                                                                     
                                                                                
                                                             
  match = SPREAD_EACH_OPPONENT_POKEMON.exec(effect);
  if (match !== null) {
    const amount = Number(match[1]);
    return [
      { op: "damageDefender", amount },
      { op: "spreadDamage", target: "opponentBench", amount },
    ];
  }

                                                                                    
                                                                                       
                                                                                      
                                                                                    
                                                                                     
    
                                                                                   
                                                                                   
                                                                                      
                                                                                 
                                                                                  
                                                                            
    
                                                                                
                                                                                    
                                                                                  
                                                                                
                                                                                  
                                                                                      
    
                                                                                    
                                                                                     
                                                                                
                                                                                  
                                                                                      
                                                                                
    
                                                                                   
                                                                               
                                                                                    
                                                                     
  match = SPREAD_EACH_CLASSED_OPPONENT_POKEMON.exec(effect);
  if (match !== null) {
    const amount = Number(match[1]);
    const classFilter = IN_PLAY_BODY_NOUNS.get(match[2] ?? "");
                                                                                    
                                           
    if (amount >= 1 && classFilter !== undefined) {
      return [
        {
          op: "damageChosen",
          target: "opponentAny",
          amount,
          count: "all",
          source: "attack",
          deals: true,
          ignoreWR: true,
          filter: classFilter,
        },
      ];
    }
  }

                                                                               
                                                                           
                                                                                 
                                                                                  
                                                                                
                                                                                    
  match = BENCHED_SNIPE_TAKEN_PRIZES.exec(effect);
  if (match !== null) {
    const per = Number(match[1]);
    if (per >= 1) {
      return [
        {
          op: "damageChosen",
          target: "opponentBench",
          amount: per,
          count: 1,
                                                                                
                                                                           
          source: "attack",
          deals: true,
          perTakenPrize: true,
        },
      ];
    }
  }

                                                                                 
                                                                               
                                                                               
                                                                                   
                                                                                 
                                                                     
                                                                                
                                                                                  
                                                                            
                                                                              
                                                                                    
                                                                             
                                                                                   
                                                                                      
                                                                                      
                                                                                     
                                                                                       
    
                                                                                       
                                                                                         
                                                                                    
                                                                                  
                                                                                      
                                                                                   
                                                                                     
                                                                                
                                                                                       
                                                                                     
                                                                               
                                                                                  
                                                                               
  match = ALSO_BENCHED_SNIPE.exec(effect);
  if (match !== null) {
    const amount = Number(match[1]);
    const count = Number(match[2]);
                                                                                 
                                                                                   
                                                                         
                                                                                    
                                                                               
                                                                             
    const snipeSide = match[3] === "your" ? ("yourBench" as const) : ("opponentBench" as const);
                                                                                
                                                                                 
                                                                                   
                                                                                     
                                                                                       
                                                                                        
                                                                                  
    const classNoun = match[4];
    const narrowing = classNoun === undefined ? undefined : BENCHED_SNIPE_CLASS_NOUNS.get(classNoun);
    const damagedOnly = match[5] !== undefined;
                                                                                
                                                                                   
                                                                                       
                                                                        
    const bothRiders = damagedOnly && classNoun !== undefined;
    const readable = classNoun === undefined || narrowing !== undefined;
    const agrees = !damagedOnly || count === 1;
    if (amount >= 1 && count >= 1 && agrees && readable && !bothRiders) {
      if (narrowing !== undefined) {
        return [
          {
            op: "damageChosen",
            target: snipeSide,
            amount,
            count,
            source: "attack",
            deals: true,
            filter: narrowing,
          },
        ];
      }
                                                                                   
                                                                                  
                                                                                  
                                                                                   
                                                                             
                                                                                 
      return damagedOnly
        ? [
            {
              op: "damageChosen",
              target: snipeSide,
              amount,
              count,
              source: "attack",
              deals: true,
              damagedOnly: true,
            },
          ]
        : [
            {
              op: "damageChosen",
              target: snipeSide,
              amount,
              count,
              source: "attack",
              deals: true,
            },
          ];
    }
  }

                                                                                
                                                                             
                                                                                  
                                                                              
                                  
    
                                                                                 
                                                                               
                                                                                  
                                                                                
                                                               
    
                                                                              
                                                                                  
                                                                                 
                                                                      
                                                                                  
                                                                                
  match = CONDITIONAL_BENCH_SNIPE.exec(effect);
  if (match !== null) {
    const cond = boardConditionForClause(match[1] ?? "");
    const amount = Number(match[2]);
    const count = Number(match[3]);
                                                                                
                                                                                       
                                                                                 
                                                                                      
                                                                                        
                                                                                  
                                                                                       
    const gatedSide = match[4] === "your" ? ("yourBench" as const) : ("opponentBench" as const);
                                                                              
                                                                                   
                                                                                   
                                                                                     
                                                                                   
                                                                                    
                                                                                      
                                                                                
                                                                                  
                                                                                         
                                                                                      
                                                                                       
                                                                                        
                                                                                        
                   
    const gatedClassNoun = match[5];
    const gatedNarrowing =
      gatedClassNoun === undefined ? undefined : BENCHED_SNIPE_CLASS_NOUNS.get(gatedClassNoun);
    const damagedOnly = match[6] !== undefined;
    if (
      cond !== null &&
      amount >= 1 &&
      count >= 1 &&
      (!damagedOnly || count === 1) &&
      (gatedClassNoun === undefined || gatedNarrowing !== undefined) &&
      !(damagedOnly && gatedClassNoun !== undefined)
    ) {
      if (gatedNarrowing !== undefined) {
        return [
          {
            op: "conditionGate",
            cond,
                                                                                                                                                      
            then: [
              {
                op: "damageChosen",
                target: gatedSide,
                amount,
                count,
                source: "attack",
                deals: true,
                filter: gatedNarrowing,
              },
            ],
          },
        ];
      }
      return [
        {
          op: "conditionGate",
          cond,
                                                                                                                                                    
          then: damagedOnly
            ? [
                {
                  op: "damageChosen",
                  target: gatedSide,
                  amount,
                  count,
                  source: "attack",
                  deals: true,
                  damagedOnly: true,
                },
              ]
            : [
                {
                  op: "damageChosen",
                  target: gatedSide,
                  amount,
                  count,
                  source: "attack",
                  deals: true,
                },
              ],
        },
      ];
    }
  }

                                                                                 
                                                                              
                                                                                     
                                                                                   
                                                                                   
                                                                                                       
                                                                                     
                         
                                                                                   
                                                                                       
                                                                                 
                                                                                     
                                                                                      
                                                                                    
                                                                                    
                                                                                  
                                   
  match = CHOSEN_ANY_TARGET.exec(effect);
  if (match !== null) {
    const amount = Number(match[1]);
    const count = Number(match[2]);
                                                                                 
    const perEnergyOnSelf = match[3] !== undefined;
    const ignoreWR = match[4] !== undefined;
    const number = match[5];
    const agrees = number === undefined || (number === "those") === (count > 1);
                                                                                 
                                                                                   
    const bothRiders = perEnergyOnSelf && ignoreWR;
    if (amount >= 1 && count >= 1 && agrees && !bothRiders) {
                                                                                    
                                                                                       
                                                                                        
                                                                                         
      if (perEnergyOnSelf) {
        return [
          {
            op: "damageChosen",
            target: "opponentAny",
            amount,
            count,
            source: "attack",
            deals: true,
            perEnergyOnSelf: true,
          },
        ];
      }
      return match[4] === undefined
        ? [
            {
              op: "damageChosen",
              target: "opponentAny",
              amount,
              count,
              source: "attack",
              deals: true,
            },
          ]
        : [
            {
              op: "damageChosen",
              target: "opponentAny",
              amount,
              count,
              source: "attack",
              deals: true,
              ignoreWR: true,
            },
          ];
    }
  }

                                                                                  
                                                                                  
                                                                                 
                                                                                
                                                                             
                                                      
  if (SELF_DISCARD_ONE.test(effect)) {
    return [{ op: "discardEnergy", from: "yourActive", filter: { kind: "anyEnergy" } }];
  }
  match = SELF_DISCARD_N.exec(effect);
  if (match !== null) {
    const count = Number(match[1]);
                                                                               
                                                              
    if (count >= 1) {
      return [{ op: "discardEnergy", from: "yourActive", filter: { kind: "anyEnergy" }, count }];
    }
  }
  if (SELF_DISCARD_ALL.test(effect)) {
    return [
      { op: "discardEnergy", from: "yourActive", filter: { kind: "anyEnergy" }, count: "all" },
    ];
  }

                                                                                  
                                                                                 
                                                                               
                                                                             
    
                                                                              
                                                                              
                                                                          
                                                                                  
                                                                             
                                                                   
                                                                                  
                                                                                
                                                                          
    
                                                                                  
                                                                                   
                                                                                 
                                                       
  match = SELF_DISCARD_THEN_ANY_TARGET.exec(effect);
  if (match !== null) {
    const discard = match[1] === "all" ? ("all" as const) : Number(match[1]);
    const amount = Number(match[2]);
    const count = Number(match[3]);
                                                                             
                                                                             
                                                                                  
                                                                               
                                                                                 
    if ((discard === "all" || discard >= 1) && amount >= 1 && count >= 1) {
      return [
                                                                               
                                                                               
                                                                                  
        { op: "discardEnergy", from: "yourActive", filter: { kind: "anyEnergy" }, count: discard },
        { op: "damageChosen", target: "opponentAny", amount, count, source: "attack", deals: true },
      ];
    }
  }

                                                                                    
                                                                                     
                                                                                    
                                                                           
    
                                                                                       
                                                                                     
                                                                                        
                                                                                
                                                                                      
                                                                                         
                                                                                       
                                                                                       
                                                                                      
                                                                                       
                                                                                         
                                                                                        
                                                                                       
                                                      
    
                                                                                       
                                                                                      
                                                                                        
                                                                                        
                                           
    
                                                                                     
                                                                              
                                                                                     
                                                                                        
                                                                      
                                       
    
                                                                                   
                                                                                   
                                                                     
                                                                                
  match = HAND_DISCARD_THEN_SCALED_ANY_TARGET.exec(effect);
  if (match !== null) {
    const cap = Number(match[1]);
    const per = Number(match[2]);
    if (cap >= 1 && per >= 1) {
      return [
                                                                                    
                                                                                    
                                   
        {
          op: "payFromHand",
          count: "any",
          cap,
          to: "discard",
          filter: { kind: "anyEnergy" },
          recordAs: "discarded",
        },
        {
          op: "damageChosen",
          target: "opponentAny",
          amount: per,
          count: 1,
          source: "attack",
          deals: true,
          perRecorded: "discarded",
        },
      ];
    }
  }

                                                                                      
                                                                                    
                                                                                      
                                                                                        
    
                                                                                      
                                                                                       
                                                                                  
                                                                                     
                                                                                     
                                            
    
                                                                                    
                                                                                    
                                                                                    
                                                                                   
    
                                                                                        
                                                                                       
                                                                      
  match = SELF_DISCARD_THEN_BENCH_SNIPE.exec(effect);
  if (match !== null) {
    const cost = match[1] === "all" ? ("all" as const) : Number(match[1]);
                                                                                  
                                                                                    
                                                                                
                                                                                        
                                                                                         
                                                                                       
                                                                                        
                                                                                         
                                                                                        
                                                                    
    const typeCode = match[2];
    const energyType = typeCode === undefined ? undefined : ENERGY_TYPE_BY_CODE[typeCode];
    const hit = Number(match[3]);
    const bodies = Number(match[4]);
                                                                                      
                                                                                   
                                                                                        
                                                                                         
                                                                                  
                                                                                   
                                                                               
    const benchSide = match[5] === "your" ? ("yourBench" as const) : ("opponentBench" as const);
                                                                              
                                                                                       
                                                                                       
                                                                                     
                                                                                        
    const costClassNoun = match[6];
    const costNarrowing =
      costClassNoun === undefined ? undefined : BENCHED_SNIPE_CLASS_NOUNS.get(costClassNoun);
    const damagedOnly = match[7] !== undefined;
    const agrees = !damagedOnly || bodies === 1;
    if (
      (cost === "all" || cost >= 1) &&
      hit >= 1 &&
      bodies >= 1 &&
      agrees &&
      (costClassNoun === undefined || costNarrowing !== undefined) &&
      !(damagedOnly && costClassNoun !== undefined) &&
      (typeCode === undefined || energyType !== undefined)
    ) {
                                                                                         
                                                                                        
                                                                                         
      const filter =
        energyType === undefined
          ? ({ kind: "anyEnergy" } as const)
          : ({ kind: "providesEnergy", energyType } as const);
      if (costNarrowing !== undefined) {
        return [
          { op: "discardEnergy", from: "yourActive", filter, count: cost },
          {
            op: "damageChosen",
            target: benchSide,
            amount: hit,
            count: bodies,
            source: "attack",
            deals: true,
            filter: costNarrowing,
          },
        ];
      }
      return [
                                                                                        
                                                                                      
                               
        { op: "discardEnergy", from: "yourActive", filter, count: cost },
        damagedOnly
          ? {
              op: "damageChosen",
              target: benchSide,
              amount: hit,
              count: bodies,
              source: "attack",
              deals: true,
              damagedOnly: true,
            }
          : {
              op: "damageChosen",
              target: benchSide,
              amount: hit,
              count: bodies,
              source: "attack",
              deals: true,
            },
      ];
    }
  }

                                                                                 
                                                                                       
                                                                     
    
                                                                                  
                                                                                        
                                                                                       
                                                                                       
                                                                                       
                                                                                        
                                        
    
                                                                                     
                                                                                     
                                                                                    
                                                                    
  if (SELF_DISCARD_ALL_THEN_TAKE_PRIZE.test(effect)) {
