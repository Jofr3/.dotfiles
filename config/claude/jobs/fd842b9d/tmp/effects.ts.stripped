  }
                                                                                      
                                                                                     
                                                                                    
                                                  
    
                                                                               
                                                                                   
                                                                                    
                                                                                     
                                     
                                                                          
                                                                                    
                                                                              
                                                                                  
                                                                                 
                                                                                    
                                                    
    
                                                                                  
                           
    
                                                                               
                                                                                  
                                                                         
                                                                                
                                                                                   
                                                  
  if (SELF_NO_WEAKNESS.test(effect)) return [{ op: "installNoWeakness" }];
  match = SELF_DISCARD_ALL_THEN_REDUCTION.exec(effect);
