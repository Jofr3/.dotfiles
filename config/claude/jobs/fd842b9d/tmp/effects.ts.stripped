  if (DISCARD_STADIUM.test(effect)) {
                                                                                   
                                                                                   
                                                                                   
                                                                                     
    return [{ op: "discardStadium" }];
  }
  if (MAY_DISCARD_STADIUM.test(effect)) {
    return [
      {
                                                                                
                                                                                 
                                                                                  
                                                                                     
                                                                                  
                                                                                    
                                                                                 
                                                                                   
                                                               
        op: "conditionGate",
        cond: { kind: "stadiumInPlay" },
                                                                                                                                                  
        then: [
          {
            op: "optional",
                                                                                
                                                                                 
            note: effect,
                                                                                                                                                      
            then: [{ op: "discardStadium" }],
          },
        ],
                                                                              
                                                                                 
                                                   
      },
    ];
  }

                                                                                   
                                                                                 
                                               
    
                                                                                     
                                                                                       
                                                                                 
                                                                                        
                                                                                     
                                                                                         
                                                                     
    
                                                                                         
                                                                                       
                                                                     
    
                                                                                 
                                                                                        
                                                                                        
                                                                                       
                                                                                        
                                                                                        
                                                                
    
                                                                                          
                                                                                       
                                                                                         
                                       
    
                                                                                      
                                                                                   
                                                                                       
                                                                                       
                                                                                 
                                                                                     
                                                                                      
                                                                                       
                                                                                      
                                                                                  
  match = DISCARD_HAND_DRAW.exec(effect);
  if (match !== null) {
    const count = Number(match[1]);
    if (count >= 1) {
      return [
        { op: "discardHand" },
        { op: "drawCards", count },
      ];
    }
  }

                                                                                   
                                                                                       
                                                                                     
                                                                                  
                                                                                      
                                                 
    
                                                                                        
                                                                                       
                                                                                         
                                                                                   
                                                                                     
                                                                                        
                                                                                    
                                                                                      
                                                            
    
                                                                                    
                                                                                         
                                                                                       
                                                                                  
    
                                                                                       
                                                                                      
                                                                                      
                                                        
    
                                                                                 
                                                                                       
                                                                                      
                                                                                  
                                                                                     
                                                                                
  match = SHUFFLE_HAND_DRAW.exec(effect);
  if (match !== null) {
    const redrawn = Number(match[1]);
    if (redrawn >= 1) {
      return [{ op: "handRefresh", who: "you", draw: { kind: "fixed", count: redrawn } }];
    }
  }

                                                                                 
                                                                                           
                                                                                        
                                                                                         
                                                                                          
                                                                                        
                                                                                      
                                                                                         
                                                      
    
                                                                                  
                                                                                         
                                                                                     
                                                                                     
                                                                                   
                                                                            
    
                                                                                  
                                                                                        
                                                                                       
                                                     
  if (SHUFFLE_HAND_DRAW_PER_OPPONENT_HAND.test(effect)) {
    return [{ op: "handRefresh", who: "you", draw: { kind: "opponentHandSize" } }];
  }

                                                                                 
                                                                                     
                                                                     
                                                                                     
                                                                              
    
                                                                                     
                                                                                      
                                                                                    
                                                                                      
                                                                                  
                                                                                   
                                                                                   
                                                                                   
                                                     
    
                                                                                  
                                                                                     
                                                                                   
                                                                                  
  match = HAND_COST_THEN_DRAW.exec(effect);
  if (match !== null) {
    const drawn = Number(match[1]);
    if (drawn >= 1) {
      return [
        { op: "payFromHand", count: 1, to: "discard", recordAs: "paid" },
                                                                                                                                                  
        { op: "recordGate", slot: "paid", then: [{ op: "drawCards", count: drawn }] },
      ];
    }
  }

                                                                             
                                                                                 
                                                                        
                                                                                 
                                                                                     
                       
    
                                                                                     
                                                                                 
                                                                                    
                                                                                       
                                                                                    
                                                               
    
                                                                                    
                                                                                     
                                                                                
                                                                                 
                                                                                  
                                                                                   
                               
    
                                                                                 
                                                                                    
                                                                                       
                                                     
  if (HAND_COST_THEN_OPPONENT_DISCARD.test(effect)) {
    return [
      { op: "payFromHand", count: 1, to: "discard", recordAs: "paid" },
                                                                                                                                                
      { op: "recordGate", slot: "paid", then: [{ op: "opponentDiscardsFromHand", count: 1 }] },
    ];
  }

                                                                               
                                                                                    
                                                                                    
                                                                      
    
                                                                                 
                                                                                     
                                                                                     
                                                                                
                                                                                       
                                                                                   
                                               
    
                                                                                 
                                                                                   
                                                                                        
                                                                                        
                                                                                       
                                                                                        
                                                                                    
                                                                                      
                                                                   
    
                                                                                     
                                                                                     
                                                                        
  if (SELF_HEAL_DEALT.test(effect)) {
    return [{ op: "heal", target: "self", amount: "dealt" }];
  }

  return null;
}

                                                                                 
                                                               
                                                      
                                                                                
                                                     
                                                                                 
                                                                                 
                                                                                    
                                                                             
                                                                         
                                                                                  
                                                                                  
                                                                                 
                                                                             
                                                                                
                                                                                   
                                                                                   
                                                                                 
                                                                          
                                                                         

                                                                                  
                                                                                  
                                                                                  
                                                                                 
                                                                                 
                                                                                  
                              

                                                                                
                                                                               
                                                                                   
                                                                                   
                                                                                
                                                                               
export interface AttackDamageBonus {
  per: number;
  count: DamageCountSource;
}
                                                                               
                                                                                
                                                                                 
                                                                               
                                                                               
                                                                               
                                                                                
                                                                           
                                 
                                 
                                                                                 
                                                             
                                                                                 
                                                                                 
                                                  

                                                                             
                                                                                    
                                                                                  
                                                                                   
                                                                                 
                                                                               
                                                                                          
                              

                                                                                 
                                                                            
                                                                                
                                                                                  
                                                                            
                                                                                    
                                                                                   
                                                                                    
                                                                                
                                                                                 
                                 
                                                                              
                                                                                   
                                                                                 
                                                                                  
                                                                                   
                                                                             
                                                                                   
                                                                    

                                                                               
                                                                                  
                                                                                
                                                                                 
                                                                             
                                                                                  
                                                                               
                                              

                                                                                
                                                                                  
                                                                                 
                                                                                 
                                                                              
                                                                                  
                                                                                 
                      

                                                                           
                                                                                  
                                                                            
                                                                            
                                                                                  
                                                                             
                                                                                
                                                                                  
                                                                                
                                                                                
           

                                                                                 
                                                                               
                                                                             
                                                                                
                                                                            
                                                                              
                                                                                 
                                                                                   
                                                    

                                                                              
                                                                                 
                                                                                 
                                                                           
                                                                                 
                                                                           
            

                                                                                  
                                                                                 
                                                                                   
                                                                              
                                                                                
                                                                                   
                                                                               
                                                                                  
                                                                             
                                                                                 
                                                  

                                                                              
                                                                                      
                                                                                  
                                                                                  
                                                                  

                                                                                  
                                                                            
                                                                                  
                                                                          
                                                                                 
                                                                              
                                                                              

                                                                                
                                                                               
                                                                             
                                                                                 
                                                                              
                                                                                
                                                                          
                                                                             
                                                                         
                                                                                  
                                                                                 
                                                                                

                                                                              
                                                                                  
                                                                                 
                                                                                
                                                                                  
                                                                                
                                                                             
                                                                                  
            

                                                                             
                                                                             
                                                                                 
                                                                              
                                                                               
                                                                                 
                                                                               
                                                                          

                                                                            
                                                                                 
                                                                                  
                                                                             
                                                                  

                                                              
                                                                                
                                                                               
                                                                                 
                                                                                 
                                                          

                                                                                   
                                                                              
                                                                                 
                                                      

                                                                                   
                                                                               
                                                                                   
                                                                                      
                                                                      
                                                                                    
                                                                                  
                                                         

                                                                                    
                                                                                  
                                                                                     
                                                                                    
                                                                              
                                                                             
                                                                                
               

                                                                                  
                                                                    
                                                                              
                                                                           
                                                                            
                                                                     
                                                                                  
                                                                                 
                                                                             

                                                                                 
                                                                       
                                                                           
                                                                              
                                                                            
                                                                                  
                                                                                
                                                                    
                                                                             
                                                                                 
                                                                      

                                                                                    
                                                                                    
                                                                               
                                                                                
                                                                                  
                                                                                 
                                                                                  
                                                             

                                                                            
                                 

                                                                          
                                                                            
                                                                                  
                                                                                  
                                                                               
                                                                              
                                                                             
                                                                                 
                                                                 
                                                                           
                

                                                                                 
                                                                                
                                                                               
                                                                             
                         

                                                                            
                                                                            
                                                                                 
                                                                                
                                                                            
                                                                             
                                                                                 
                                                                           
                                                                                  
                                                                              
                                                                          
                                                                                
                                                                               
                                                                             
                        

                                                                                   
                                                                          
                                                                             
                                                                                     
                                                                                   
                                                                                     
                                                                                    
                                                                              
                                                                                 
                                                                                

                                                                         
                                                                                  
                                                                           
                                                                                   
                                                                           
                                                                            

                                                                                
                                                                                  
                                                                 

                                                                                 
                                                                                
                                                                                 
                                                                                 
                                  

                                                                                  
                                                                        
                                                                                      
                                                                                   
                                                                                      
                                                                 

                                                                                     
                                                                                   
                                                                            
                                                                                      
                                                                                     
                                                                                 
                                                                                      
                                                                                      
                                                                                        
                                                                                       
                                                                                       
                                                                                     
                                                                                  
                                                                                       
                                              

                                                                                 
                                                                                    
                                                                                      
                                                                                      
                                                                                     
                                                                                     
                                                                           
                             

                                                                                   
                                                                                  
                                                                                  
                                                                                   
                                                                                        
                                                                                        
                                                                                 

                                                                                        
                                                                                        
                                                                          
                                                                                

                                                                                  
                                                                                       
                                                                                
                                                                                         
                                                                                  
                                                                                       
                 

                                                                                       
                                                                                          
                                                                                     
                                                                                      
                                                                                   
                                                   
                                                                                    
                                                                                   
                                                                                     
                 
                                                                                        
                                                                          
                                                                                      
                                                                                    
                                           
                                                                                      
                                                                                   
                                                                                       
                                   

                                                                                         
                                                                                        
                                                                                       
                                                                                       
                                                                                         
                                                                                          
                                                    

                                                                                      
                                                                                         
                                                                               
                                                                             
                                   
                                                                                     
                                                                                         
                                                                             
                                                                                         
                                                                                 

                                                                                      
                                                                                        
                                                                                         
                                                                                          
                                                                                         
                                                             

                                                                                        
                                                                                          
                                                                                           
                                                                                         
                                                                                           
                                                                                          

                                                                                        
                                                                                         
                                                                                    
                                                                                      
                                                                                          
                     

                                                                                     
                                                                                        
                                                                                          
              
export type DamageCountSource =
  | { kind: "damageCountersOnSelf" }
  | { kind: "opponentPrizesTaken" }
  | { kind: "opponentActiveRetreatCost" }
  | { kind: "boardCondition"; cond: BoardCondition }
  | { kind: "damageCountersOnOpponentActive" }
                                                                      
                                                                                      
                                                                                    
                                                                                   
                                                  

                                                                              
                                                                                       
                                                                                     
                                                                       
                                                                                     
                                                                                       
                                               

                                                                               
                                                                                               
                                                                        
                                                                                         
                                                                                      
                                                                                       
                                                                          
                                                                                    
                                                                                        
                                                                                 

                                                                                 
                                                                                
                                                                                      
                                                                                         
                                                                                        
                                                                                        
                                                                                    
                                                                                    
                                                 

                                                                                          
                                                                                          
                                                                                       
                                                                                  
                                                                                       
                                                                     
                                                          
  | { kind: "specialConditionsOnOpponentActive" }
                                                                              
                                                                                 
                                                                                   
                                                                             
                                                                                  
                                                                                   
                                                                                
                                                                                  
                                                                                
                                                                                 
                                                                                
  | { kind: "damageCountersOnYourBench"; filter?: CardFilter }
                                                                            
                                                                                   
                                                                                     
                                                                                    
                                                                                     
                                                            
                                                                                     
                                                                                    
                                                                                      
                                                                       
  | { kind: "damageCountersOnOpponentBoard" }
  | { kind: "bothSidesBenchCount" }
  | { kind: "opponentBenchCount" }
  | { kind: "yourBenchCount"; filter?: CardFilter }
  | {
      kind: "energyOnOpponent";
      zone: OpponentEnergyZone;
                                                                                   
                                                                                     
                                                                                     
                                                                                    
                                                                                     
                                                                                  
                                                                                   
                                                   
      energyType: BasicEnergyType | "special" | "basic" | null;
    }
  | {
      kind: "energyOnSelf";
      zone?: "board";
                                                                                    
                                                                                    
                                                                                 
                                                                                     
                                                                                   
                                                                                  
                                                                                       
                                                                                       
                                                                                        
                                                                                     
                                                                          
                                                            
      energyType: BasicEnergyType | "special" | "basic" | null;
                                                                              
                                                                                
                                                                                 
                                                                                 
                                                                                 
                                                                    
                                                                                    
                                                               

                                                                                  
                                                                              
                                                                        
                                                                         
                                                                                  
                                                                                   
                                                                                     
                            

                                                                                    
                                                                                    
                                                                                     
                                                                                    
                                                                                
                                                                               
                                                                                    
                                                                                    
                          
      filter?: CardFilter;
    }
  | { kind: "bothActivesEnergyCount" }
  | { kind: "toolsOnYourBoard" }
  | { kind: "extraEnergyUnitsBeyondCost"; extra: number }
                                                                                 
                                                                                       
                                                                             
                                                                                    
                                                                                      
                           

                                                                                     
                                                                        
                                                                                     
                                                                                     
                                                                                        
                                                                                        
                                                                                   
                                                                                     
                                                                     
                                                                                     
                                                                                        
                                                                                    
                                            

                                                                                    
                                                                                     
                                                                                         
                                                                                     
                                                                                         
                                                                                         
                                                                             
                                                                                        
                                                                                      
                                                                                         
                                                                               
                                       

                                                                                    
                                                                                         
                                                                                        
                                                                                      
                                                                    
                                                                                        
                                                                                         
                                                                                         
                                                                                        
                                                                                      
                                                                                       
                                                                                         
                                                                                    
                                                                    

                                                                            
                                                                                       
                                                                                 
                                                                                         
                                                                                     
                                                                                         

                                                                                     
                                                                                      
                                                                                         
                                                                                          
                                                                                        
                                                                                        
                                                     

                                                                              
                                                                                       
                                                                                         
                                                                                
                                                                                    
                                                                                        
                                                                                        
                        

                                                                                     
                                                                            
                                                                                        
                                                              
  | { kind: "pokemonInPlay"; seat: CountSeat; filter: CardFilter }
  | { kind: "bothSidesPokemonInPlay"; filter: CardFilter }
  | { kind: "cardsInDiscardPile"; seat: DiscardPileSeat; filter: CardFilter }
  | { kind: "cardsInOpponentHand"; filter: CardFilter };

                                                                                      
                                                                                  
                                                                         
                                                                                     
                                                                                       
                                     

                                                                                    
                                                                                    
                                                                         
                                                                                      
                                                                                        
                                                                                      
                                                                                      
                                                                                 
                                                                                       
                                                                                           
                                                                                       
                                                                                         
                                                    

                                                                                       
                                                                                        
                                                                                 
                                                                                    
                                                                                       
                                                                                       
                                                                                       
                                                                                        
                                                                                         
                                                                                        
                                                                                    
          

                                                                                      
                                                                                     
                                                                                    
                                                                                        
                                                                                        
                                                                                     
                                                                                   
              
export type CountSeat = "you" | "opponent";
                                                                              
                                                                                 
                                                                                  
                                                                
                                                                                  
                                                                                   
                                                                             
                                                                 
export type DiscardPileSeat = CountSeat;

                                                                                
                                                                                
                                                                           
                                                                                  
                                                              

                                                                                
                                                                                
                                                                                
                                                                                
                                             
export type OpponentEnergyZone = "active" | "board";

                                                                              
                                                                                
                                                                                  
                                                                                    
                                                       
                                                                                 
                        
                                                                            
                                                                                    
                                                                                 
                                                                                
                 
export function deriveAttackDamageBonus(text: string): AttackDamageBonus | null {
  const effect = text.trim();
                                                                 
                                                                                  
           
  const selfCounters = SELF_COUNTER_SCALE.exec(effect);
  if (selfCounters !== null) {
    const per = Number(selfCounters[1]);
    if (per >= 1) return { per, count: { kind: "damageCountersOnSelf" } };
  }
  const opponentPrizes = OPPONENT_PRIZES_SCALE.exec(effect);
  if (opponentPrizes !== null) {
    const per = Number(opponentPrizes[1]);
    if (per >= 1) return { per, count: { kind: "opponentPrizesTaken" } };
  }
  const retreatCost = RETREAT_COST_SCALE.exec(effect);
  if (retreatCost !== null) {
    const per = Number(retreatCost[1]);
    if (per >= 1) return { per, count: { kind: "opponentActiveRetreatCost" } };
  }
                                                                              
                                                                             
                                                                  
  const opponentCounters = OPPONENT_COUNTER_SCALE.exec(effect);
  if (opponentCounters !== null) {
    const per = Number(opponentCounters[1]);
    if (per >= 1) return { per, count: { kind: "damageCountersOnOpponentActive" } };
  }
                                                                            
                                                                                   
                                                                                    
                                                                                   
                                                                                   
                                                                                 
                                                                          
  const opponentBoardCounters = OPPONENT_BOARD_COUNTER_SCALE.exec(effect);
  if (opponentBoardCounters !== null) {
    const per = Number(opponentBoardCounters[1]);
    if (per >= 1) return { per, count: { kind: "damageCountersOnOpponentBoard" } };
  }
                                                                               
                                                                                  
                          
  const bothBench = BOTH_BENCH_SCALE.exec(effect);
  if (bothBench !== null) {
    const per = Number(bothBench[1]);
    if (per >= 1) return { per, count: { kind: "bothSidesBenchCount" } };
  }
  const opponentBench = OPPONENT_BENCH_SCALE.exec(effect);
  if (opponentBench !== null) {
    const per = Number(opponentBench[1]);
    if (per >= 1) return { per, count: { kind: "opponentBenchCount" } };
  }
                                                                                  
                                                                          
                                                                                
                                                  
                                                                                
                                                                                   
                                                                                 
                                                                                   
                                                                                   
                                                                                
                                                                                  
                                                                                
                                                                                    
                                           
  const yourBenchNoun = YOUR_BENCHED_NOUN_SCALE.exec(effect);
  if (yourBenchNoun !== null) {
    const per = Number(yourBenchNoun[1]);
    const filter = inPlayBodyFilter(yourBenchNoun[2] ?? "");
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "yourBenchCount", filter } };
    }
  }
  const yourBench = YOUR_BENCH_SCALE.exec(effect);
  if (yourBench !== null) {
    const per = Number(yourBench[1]);
    if (per >= 1) return { per, count: { kind: "yourBenchCount" } };
  }
                                                                            
                                                                                   
                                                                               
                                                                                     
                                                                                     
                                                                                  
          
    
                                                                                
                                                                                     
                                                                                    
                                                                                    
                                                                               
                                                                                
                                                                               
                                                                                
                                                                                    
                                                                                 
  const yourBenchFiltered = YOUR_BENCH_FILTERED_SCALE.exec(effect);
  if (yourBenchFiltered !== null) {
    const per = Number(yourBenchFiltered[1]);
    const filter = inPlayBodyFilter(yourBenchFiltered[2] ?? "");
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "yourBenchCount", filter } };
    }
  }
                                                                              
                                                                                   
                                                                                 
                                                                                 
                                                                        
    
                                                                                  
                                                                                 
                                                                             
                                                                                  
                                                    
                                                                                   
                                                                                    
                                                                                   
                                                                            
  const inPlayBodies = IN_PLAY_BODY_SCALE.exec(effect);
  if (inPlayBodies !== null) {
    const per = Number(inPlayBodies[1]);
    const filter = inPlayBodyFilter(inPlayBodies[2] ?? "");
    if (per >= 1 && filter !== null) {
                                                                            
                                                                               
                                                                                    
                                                                               
                                                                                 
                                                                                  
                                                                      
      return { per, count: { kind: "pokemonInPlay", seat: "you", filter } };
    }
  }
                                                                                     
                                                                                       
                                                                                    
                                                                                
                                  
    
                                                                                      
                                                                             
                                                                                       
                                                                                     
                                        
    
                                                                                     
                                                                                     
                                                                               
                                                                                      
                                                                                  
                                                                                       
                                                                                     
                                                                                      
                                                                
  const yourDiscard = DISCARD_PILE_COUNT_SCALE.exec(effect);
  if (yourDiscard !== null) {
    const per = Number(yourDiscard[1]);
    const filter = discardPileFilter(yourDiscard[2] ?? "");
    const seat: DiscardPileSeat = yourDiscard[3] === "your" ? "you" : "opponent";
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "cardsInDiscardPile", seat, filter } };
    }
  }
                                                                              
                                                                            
                                                                                
                                                                              
                                                                         
                                                                           
  const opponentEnergy = OPPONENT_ENERGY_SCALE.exec(effect);
  if (opponentEnergy !== null) {
    const per = Number(opponentEnergy[1]);
    const energyType = attachedEnergyFilter(opponentEnergy[2]);
    if (per >= 1 && energyType !== undefined) {
      return { per, count: { kind: "energyOnOpponent", zone: "active", energyType } };
    }
  }
                                                                              
                                                                        
                                                                                 
                                                                                  
                                                                              
                                                                                 
                                                                                    
                                                                                 
                                                                                                                                        
                                                                          
              
    
                                                                                 
                                                                                  
                                                                                   
                                                                             
                                                                                 
                                                                               
            
  const selfEnergy = SELF_ENERGY_SCALE.exec(effect);
  if (selfEnergy !== null) {
    const per = Number(selfEnergy[1]);
    const energyType = attachedEnergyFilter(selfEnergy[2]);
    if (per >= 1 && energyType !== undefined) {
      return selfEnergy[3] === "this Pokémon"
        ? { per, count: { kind: "energyOnSelf", energyType } }
        : { per, count: { kind: "energyOnSelf", zone: "board", energyType } };
    }
  }
                                                                                 
                                                                                  
                                                                                  
                                                                                      
                                                                                      
                                                                                 
                                                                                      
                                                                                      
                                                                                  
                                                    
    
                                                                                     
                                                                                      
                                                                                
                                                                                     
                                                                                     
                                                                                    
                                                                                 
                                                                                                         
                                                                              
                                                                                
                                                                                     
                                 
  const selfEnergyFiltered = SELF_ENERGY_FILTERED_SCALE.exec(effect);
  if (selfEnergyFiltered !== null) {
    const per = Number(selfEnergyFiltered[1]);
    const energyType = attachedEnergyFilter(selfEnergyFiltered[2]);
    const filter = inPlayBodyFilter(selfEnergyFiltered[3] ?? "");
    if (per >= 1 && energyType !== undefined && filter !== null) {
                                                                                      
                                                                                    
                                                                                        
      return { per, count: { kind: "energyOnSelf", zone: "board", energyType, filter } };
    }
  }
                                                                                   
                                                                                  
                                                                                  
                                                                               
                                        
  const bothActivesEnergy = SELF_ENERGY_BOTH_ACTIVES_SCALE.exec(effect);
  if (bothActivesEnergy !== null) {
    const per = Number(bothActivesEnergy[1]);
    if (per >= 1) return { per, count: { kind: "bothActivesEnergyCount" } };
  }
                                                                              
                                                                                
                                                                                    
                                                                                 
                                                                
                                                                                
                                                                                  
                                                        
    
                                                                                     
                                                                                 
                                                                                     
                                                                                
                                                                                    
                                                       
                                                                                   
                                                                                     
                                                                                    
                                                                                    
                                                                                     
                                                                             
                                                                           
                                                                                    
                                                                           
  const extraEnergy = EXTRA_ENERGY_BONUS.exec(effect);
  if (extraEnergy !== null) {
    const per = Number(extraEnergy[2]);
    const extra = Number(extraEnergy[1]);
                                                                                 
                                                                                   
                                                                               
                                                                                 
                                                                                   
                                                                                     
                                                                                   
    if (per >= 1) return { per, count: { kind: "extraEnergyUnitsBeyondCost", extra } };
  }
                                                                              
                                                                                
                                                                               
                                                                             
                                                                  
                                                                                
                                                                                      
                                                                                      
                                                                                   
                                                                              
                                                                               
                                                                                      
  const conditional =
    CONDITIONAL_DAMAGE_BONUS.exec(effect) ?? CONDITIONAL_BONUS_SUPPRESSED.exec(effect);
  if (conditional !== null) {
    const cond = boardConditionForClause(conditional[1] ?? "");
    if (cond !== null) {
      const per = Number(conditional[2]);
                                                                               
      if (per >= 1) return { per, count: { kind: "boardCondition", cond } };
    }
  }
  return null;
}

                                                                               
                                                                                
                                                                                 
                                                                                 
                                                                            
                                                                                   
                                                                                   
                                                                              
                                                                                
                                                                                 
                                                        

                                                                                 
                                                                                 
                                                                             
                                                                              
                                                                                
                                                                           
                                                                                  
                                                                                   
                                                                                  

                                                                                      
                                                                                                            
                                                                                                            

                                                                            
                                                                               
                                                                                
                                                                            
                                                                            
                                                                              
                                                                    
                                                                                
                                                                                  
                                                                               
                                                          

                                                                                  
                                                                                  
                                                                                  
                                                                              
                                                                                
                                                                     

                                                                                
                                                                                  
                                                                                
                                                                                  
                                                                             
                                                              
                                                                                   
                                                                               
                                                                                  
                                                                                     
                                                                                 
                                                                              
                                              
                                                                                 
                                
export function deriveAttackDamagePenalty(text: string): AttackDamageBonus | null {
  const effect = text.trim();
                                                                                  
                                                                               
                                                                     
  const selfCounters = SELF_COUNTER_PENALTY.exec(effect);
  if (selfCounters !== null) {
    const per = Number(selfCounters[1]);
    if (per >= 1) return { per, count: { kind: "damageCountersOnSelf" } };
  }
                                                                                
                                                                        
                                                                                
                                                   
  const retreatCost = RETREAT_COST_PENALTY.exec(effect);
  if (retreatCost !== null) {
    const per = Number(retreatCost[1]);
    if (per >= 1) return { per, count: { kind: "opponentActiveRetreatCost" } };
  }
  return null;
}

                                                                              
                                                                               
                                                                              
                                                                   
                                                                           
                                                          
                                                                                 
                                                                                
                                                                                 
                                                                              
                                                                
                                                                                   
                                                                         
                                                                               
                                                            

                                                                                 
                                                                           
                                                                                
                                                                               
                                                                       
                                                                                 
                        

                                                                                 
                                                                                  
                                                                              
                                                                                
                                                  
                                                                                 
                                                                                   
                                                                               
                                                                                   
                                                                                  
                                                                                 

                                                            
                                                                                   
                                                 
export function deriveAttackDamageMultiplier(text: string): AttackDamageBonus | null {
  const effect = text.trim();
                                                                               
             
  const selfCounters = SELF_COUNTER_MULTIPLY.exec(effect);
  if (selfCounters !== null) {
    const per = Number(selfCounters[1]);
    if (per >= 1) return { per, count: { kind: "damageCountersOnSelf" } };
  }
  const opponentPrizes = OPPONENT_PRIZES_MULTIPLY.exec(effect);
  if (opponentPrizes !== null) {
                                                                                
    const per = Number(opponentPrizes[1]);
    if (per >= 1) return { per, count: { kind: "opponentPrizesTaken" } };
  }
  const retreatCost = RETREAT_COST_MULTIPLY.exec(effect);
  if (retreatCost !== null) {
    const per = Number(retreatCost[1]);
    if (per >= 1) return { per, count: { kind: "opponentActiveRetreatCost" } };
  }
                                                                                  
                                                                              
                                                                                 
                                                                                   
                                                                       
                                                                                    
                                                                                
                                                                                    
                                                                                   
                                                                                  
                                                                             
  const opponentCounters = OPPONENT_COUNTER_MULTIPLY.exec(effect);
  if (opponentCounters !== null) {
    const per = Number(opponentCounters[1]);
    if (per >= 1) return { per, count: { kind: "damageCountersOnOpponentActive" } };
  }
                                                                               
                                                                               
                                                            
                                                                              
                                                                                           
                                                                                             
                                                                                            
                                                                                       
                                                                                           
                                                               
    
                                                                                          
                                                                                       
                                                                        
                                                                        
  const opponentConditions = OPPONENT_CONDITION_COUNT_MULTIPLY.exec(effect);
  if (opponentConditions !== null) {
    const per = Number(opponentConditions[1]);
    if (per >= 1) return { per, count: { kind: "specialConditionsOnOpponentActive" } };
  }
  const benchCounters = BENCH_COUNTER_MULTIPLY.exec(effect);
  if (benchCounters !== null) {
    const per = Number(benchCounters[1]);
    if (per >= 1) return { per, count: { kind: "damageCountersOnYourBench" } };
  }
                                                                            
                                                                                    
                                                                                  
                                                                                    
                                                                                  
                                              
    
                                                                        
                                                                                  
                                                                                     
                                                                                    
                        
    
                                                                                
                                                                                    
                                                                                   
                                                                                   
                                                                                    
                                                                            
                                                               
    
                                                                              
                                                                                     
                                                                                    
                                                                                
                                                                                       
                                                                                   
                                                                                 
                                                                                   
                                                                                   
                                                                                   
                                                                      
                                                                               
                                                                      
    
                                                                         
                                                                                     
                                                                                      
                                                                               
                                
  const benchCountersFiltered =
    BENCH_COUNTER_FILTERED_MULTIPLY.exec(effect) ?? BENCH_COUNTER_FILTERED_SUPPRESSED.exec(effect);
  if (benchCountersFiltered !== null) {
    const per = Number(benchCountersFiltered[1]);
    const filter = inPlayBodyFilter(benchCountersFiltered[2] ?? "");
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "damageCountersOnYourBench", filter } };
    }
  }
                                                                                
                                                                                   
                                                                             
                                                        
  const opponentBench = OPPONENT_BENCH_MULTIPLY.exec(effect);
  if (opponentBench !== null) {
    const per = Number(opponentBench[1]);
    if (per >= 1) return { per, count: { kind: "opponentBenchCount" } };
  }
                                                                                 
                                                                                   
                                                                                   
                                                                             
                                                                                  
                                                                 
  const yourBench = YOUR_BENCH_MULTIPLY.exec(effect);
  if (yourBench !== null) {
    const per = Number(yourBench[1]);
    if (per >= 1) return { per, count: { kind: "yourBenchCount" } };
  }
                                                                                 
                                                                                    
                                                                                  
                                                                                 
                                                                              
                                      
  const inPlayBodies = IN_PLAY_BODY_MULTIPLY.exec(effect);
  if (inPlayBodies !== null) {
    const per = Number(inPlayBodies[1]);
    const filter = inPlayBodyFilter(inPlayBodies[2] ?? "");
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "pokemonInPlay", seat: "you", filter } };
    }
  }
                                                                               
                                                                                    
                                                                                     
                                                                                
                                                                                   
                                                                
    
                                                                                   
                                                                                    
                                                                             
                                                                            
                                                                          
    
                                                                              
                                                                               
                                                                                   
                   
  const foeInPlayBodies = IN_PLAY_FOE_BODY_MULTIPLY.exec(effect);
  if (foeInPlayBodies !== null) {
    const per = Number(foeInPlayBodies[1]);
    const filter = inPlayBodyFilter(foeInPlayBodies[2] ?? "");
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "pokemonInPlay", seat: "opponent", filter } };
    }
  }
                                                                              
                                                                                   
                                                                              
    
                                                                                
                                                                               
                                                                                     
                                                                                   
                                                                                    
                                                       
    
                                                                               
                                                                                    
                                                                                    
                                                                           
                                                                                   
                                                                                  
                                                                           
  const roundBodies = IN_PLAY_ATTACK_NAME_MULTIPLY.exec(effect);
  if (roundBodies !== null) {
    const per = Number(roundBodies[1]);
    const attackName = roundBodies[2] ?? "";
    if (per >= 1 && attackName !== "") {
      return {
        per,
        count: {
          kind: "pokemonInPlay",
          seat: "you",
          filter: { kind: "attackNamePokemon", attack: attackName },
        },
      };
    }
  }
                                                                                   
                                                                                  
                                                                                        
                                                                                      
                                                                                   
                                                                                        
                                      
    
                                                                                     
                                                                                        
                                                                                 
                                                                                        
                                                                                     
                                                                                    
                                          
    
                                                                                   
                                                                                         
                                                                                        
                                                                                   
                                                                                      
    
                                                                                        
                                                                                     
                                                                                     
                                                                                 
                                                                                        
                                                                                      
                                                                                        
         
    
                                                                                   
                                                                                         
                                                                                         
                                                                                         
                                                                                       
                                                                                         
                                                                                    
                                                                                 
                                                                                      
                                                                               
                          
  const bothSidesNamed = IN_PLAY_BOTH_SIDES_NAME_MULTIPLY.exec(effect);
  if (bothSidesNamed !== null) {
    const per = Number(bothSidesNamed[1]);
    const first = bothSidesNamed[2] ?? "";
    const second = bothSidesNamed[3] ?? "";
    if (per >= 1 && first !== "" && second !== "") {
      return {
        per,
        count: {
          kind: "bothSidesPokemonInPlay",
          filter: {
            kind: "anyOf",
            filters: [
              { kind: "pokemonNameContaining", fragment: first },
              { kind: "pokemonNameContaining", fragment: second },
            ],
          },
        },
      };
    }
  }
                                                                                     
                                                                                     
                                                                                        
                                                                                  
                                                                                       
                     
    
                                                                                      
                                                                                     
                                                                                    
                                                                                
  const foeDiscard = DISCARD_PILE_COUNT_MULTIPLY.exec(effect);
  if (foeDiscard !== null) {
    const per = Number(foeDiscard[1]);
    const filter = discardPileFilter(foeDiscard[2] ?? "");
    const seat: DiscardPileSeat = foeDiscard[3] === "your" ? "you" : "opponent";
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "cardsInDiscardPile", seat, filter } };
    }
  }
                                                              
                                                                                 
                                                                                   
                                                                                   
                                                                             
                                                                             
    
                                                                                
                                                                               
                                                                        
    
                                                                             
                                                                             
                                                                     
                                                                               
                                                                               
                                                                                
                                                                       
    
                                                                             
                                                                                   
                                                                             
                                                                                 
  const pileByAttackName = DISCARD_PILE_ATTACK_NAME_MULTIPLY.exec(effect);
  if (pileByAttackName !== null) {
    const per = Number(pileByAttackName[1]);
    const attackName = pileByAttackName[2] ?? "";
    if (per >= 1 && attackName !== "") {
      return {
        per,
        count: {
          kind: "cardsInDiscardPile",
          seat: "you",
          filter: { kind: "attackNamePokemon", attack: attackName },
        },
      };
    }
  }
                                                                               
                                                                                     
                                                                                      
                                                                              
                                                        
    
                                                                                     
                                                                                     
                                                                              
                                                                                      
                                                                                        
                                                                                  
    
                                                                                      
                                                                                 
                                                                                       
                                                                                   
                                                                                       
                                                                         
                                                                                    
                                                       
  const foeHand = OPPONENT_HAND_COUNT_MULTIPLY.exec(effect);
  if (foeHand !== null) {
    const per = Number(foeHand[1]);
    const filter = opponentHandFilter(foeHand[2] ?? "");
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "cardsInOpponentHand", filter } };
    }
  }
  const revealedHand = ATTACK_REVEAL_AND_TRAINER_SCALE.exec(effect);
  if (revealedHand !== null) {
    const per = Number(revealedHand[1]);
    const filter = opponentHandFilter(revealedHand[2] ?? "");
    if (per >= 1 && filter !== null) {
      return { per, count: { kind: "cardsInOpponentHand", filter } };
    }
  }
                                                                                
                                                                               
                                                                      
  const opponentEnergy = OPPONENT_ENERGY_MULTIPLY.exec(effect);
  if (opponentEnergy !== null) {
    const per = Number(opponentEnergy[1]);
    const energyType = attachedEnergyFilter(opponentEnergy[2]);
    const zone: OpponentEnergyZone =
      opponentEnergy[3]?.startsWith("all of ") === true ? "board" : "active";
    if (per >= 1 && energyType !== undefined) {
      return { per, count: { kind: "energyOnOpponent", zone, energyType } };
    }
  }
                                                                                 
                                                                                 
                                                                                   
                                                                                 
                                                                                
                                                                              
                                                                                  
    
                                                                                 
                                                                                
                                                                            
                                                                                  
                                                                                 
                                                                                  
                                                                              
                                                                                
                                               
    
                                                                                   
                                                                                 
                                                                                 
                                                            
  const selfEnergy = SELF_ENERGY_MULTIPLY.exec(effect);
  if (selfEnergy !== null) {
    const per = Number(selfEnergy[1]);
    const energyType = attachedEnergyFilter(selfEnergy[2]);
    if (per >= 1 && energyType !== undefined) {
      return { per, count: { kind: "energyOnSelf", energyType } };
    }
  }
                                                                                
                                                                                   
                                                                                
                                                                       
                                                                          
  const yourTools = YOUR_TOOLS_MULTIPLY.exec(effect);
  if (yourTools !== null) {
    const per = Number(yourTools[1]);
    if (per >= 1) return { per, count: { kind: "toolsOnYourBoard" } };
  }
  return null;
}

                                                                                 
                                                                         
                                                                              
                                                    

                                                                                   
                                                                                 
                                                                                
                                                          

                                                                                    
                                                                                    
                                                            
                                                                                    
                                                                                    

                                                                            
                                                                                  
                                                                                  
                                                                                   
                                                                           
                                                                                   
                                                                        
                                                                   
                                                                                  
                                                                           

                                                                                 
                                                                                     
                                                   
                                                                          
                                                                                 
                                                                                  
                                                                                
                                                                               
export interface AttackDamageSuppression {
  weakness?: true;
  resistance?: true;
  targetEffects?: true;
}

                                                                             
                                                                                
                                                

                                                                                 
                                                                                   
                                                                                 
                                                                                
                                                                          
                                               

                                                                     
                                                                             
                                                                          
                                                                                  
                                                               
                                                                                
                             
const DAMAGE_SUPPRESSION = new RegExp(
  `^This attack['’]s damage isn['’]t affected by ` +
    `(?:(Weakness or Resistance, or by any effects on your opponent['’]s Active Pokémon)` +
    "|(Weakness or Resistance)" +
    "|(Resistance)" +
    `|(any effects on your opponent['’]s Active Pokémon))  .$`,
);

                                                                                  
                                                       

                                                                                 
                                                                                
                                                                                 
                                                                                  
                                                                                
                                                             
export function deriveAttackDamageSuppression(text: string): AttackDamageSuppression | null {
  const trimmed = text.trim();
                                                                        
                                                                                       
                                                                                     
                                                                                   
                                                                               
                                                                                    
                                                                                
    
                                                                                  
                                                                                       
                                                                                     
                                                                                   
                                                                                      
                                                                               
                                                                                       
                                                                                       
                                                                                  
    
                                                                                      
                                                                                   
                                                                                       
                                                                          
    
                                                                                     
                                                                                      
                                                                                       
                                                                                   
                                                            
                                                                  
                                                                                  
  if (
    CONDITIONAL_BONUS_SUPPRESSED.test(trimmed) &&
    deriveAttackDamageBonus(trimmed) !== null
  ) {
    return { weakness: true };
  }
                                                                             
                                                                                  
                                                                                  
                                                                                 
                                                                                
                                                                            
                                                                          
                                                                               
                        
    
                                                                             
                                                                                    
                                                                               
                                                                                     
                                                                                    
                                                                                  
                                                                                      
                                                                                     
                                                                                     
         
    
                                                                                    
                                                                                  
                                                                                   
                                                                                     
                                                                                  
                                                                                      
                                                                                      
                                                                                     
                                                                                 
                
  if (
    BENCH_COUNTER_FILTERED_SUPPRESSED.test(trimmed) &&
    deriveAttackDamageMultiplier(trimmed) !== null
  ) {
    return { weakness: true };
  }
  const match = DAMAGE_SUPPRESSION.exec(trimmed);
  if (match === null) return null;
  if (match[1] !== undefined) return { weakness: true, resistance: true, targetEffects: true };
  if (match[2] !== undefined) return { weakness: true, resistance: true };
  if (match[3] !== undefined) return { resistance: true };
  return { targetEffects: true };
}

                                                                          
                                                               

                                                                                  
                                                                                 
                                                                                  
                                                                      
                                                                                
                                                             
                                                                                
                                   
                                                                         
                                                                     
                                                                              
                                                    
                                                                                 
                                                                                
                                                                                
                                                                               
                                                                                
                                                              

                                                                              
                                                                                
                                                                                
                                                                                 
                                                                          
                                                                                  
                                                                                  
                                                                                 
                                                                     

                                                                                
                                                                                
                                                                                  
                                                                              
                                                                                
                                                                           
                                                                    
                                                                                
                                                                              
                                                                                 
                                                                            
                          

                                                                                
                                                                      
                                                                           
                                                                                
                                                                                 
                                                                         
                                                                   

                                                                                 
                                                                                   
                                                                             
                                                                              
                                                                                 
                                                                                 
                                                                                 
          

                                                                                 
                                                                                   
                                                                                 
                                                                               
                                                                               
                                                                                
                                                          
export interface AttackOptionalBoost {
                                                                        
  bonus: number;
                                                                              
                                                                             
                                                               
  ops: EffectOp[];
}

const OPTIONAL_DAMAGE_BOOST = /^You may do (\d+) more damage\. If you do, (.+)$/;
const BOOST_RETURN_SELF = /^shuffle this Pokémon and all attached cards into your deck\.$/;
const BOOST_SELF_DAMAGE = /^this Pokémon also does (\d+) damage to itself\.$/;
const BOOST_CANT_ATTACK = /^during your next turn, this Pokémon can['’]t attack  $/;

/** Parse the optional damage boost into its bonus and its consequent's ops, or
    null for anything else.

    THE EIGHTH READER of the same effect text, and disjoint from all seven by its
    LEADING WORDS: *"You may do"* denies `deriveAttackEffect`'s whole-sentence
    anchors, both scaling readers' `^This attack does` / `^If`, the coin family's
    `^Flip a coin`, the requirement family's `^If` and the suppression family's
    `^This attack's damage`. attack.ts owns the read site, beside the coin
    reader's. */
export function deriveAttackOptionalBoost(text: string): AttackOptionalBoost | null {
  const match = OPTIONAL_DAMAGE_BOOST.exec(text.trim());
  if (match === null) return null;
  const bonus = Number(match[1]);
  const consequent = match[2] ?? "";
  if (bonus < 1) return null;
  if (BOOST_RETURN_SELF.test(consequent)) {
    return { bonus, ops: [{ op: "returnSelf", dest: "deck" }] };
  }
  const recoil = BOOST_SELF_DAMAGE.exec(consequent);
  if (recoil !== null) {
    const amount = Number(recoil[1]);
    return amount >= 1 ? { bonus, ops: [{ op: "damageSelf", amount }] } : null;
  }
  if (BOOST_CANT_ATTACK.test(consequent)) return { bonus, ops: [{ op: "preventAttack" }] };
  return null;
}

/** 🆕 D318 — D316's PROGRAM, MOVED OUT OF ITS CALL SITE. Byte-for-byte the
    `optional` `attack.ts` assembled inline from D316 to D317; nothing about the
    shape changed, only WHERE it is built.

    🛑 WHY THE MOVE IS THE WHOLE POINT, AND IT IS NOT A TIDINESS ARGUMENT. A
    program assembled at its call site is invisible to every structural auditor in
    this repo. `programWalk.test.ts` builds its corpus from `deriveAttackEffect`
    over `FIXTURE_POOL` plus the registry plus the readings that are FED to it, and
    it can only be fed a reading-borne program if that program can be BUILT outside
    the file that runs it. D316's `optional.otherwise` was real, shipped and
    unreachable by that sweep for two slices, which is why the suite's carrier pin
    read `["optional", ["then"]]` while the op carried two arms — a pin measuring
    what the sweep can REACH, reported as what the union HAS.

    D317 hit the identical wall on the next sentence over and did not inherit it:
    it exported `bonusConsequentProgram` and its `coinFlipGate.otherwise` became
    the first producer that pin had seen in forty-eight slices. This is the same
    repair applied backwards, and it is `programPerHeads.ops`'s lesson (D150) at
    its fourth site. 🛑 THE OPERATIONAL FORM: IF A READING NEEDS A VALUE ONLY ONE
    FILE HAS — here the attack's printed `base`, which lives in the `damage` field
    — MAKE THE ASSEMBLER A PURE EXPORTED FUNCTION OF THAT VALUE.

    ⚠️ AND EXPORTING IT IS NECESSARY AND NOT SUFFICIENT, WHICH IS THE HALF THAT
    IS EASY TO SHIP GREEN AND DEAD. `FIXTURE_POOL` printed the sentence ZERO times
    (measured before the move, not after), so the sweep would have had nothing to
    build and the pin would have stood still with every line of this function
    covered. `fix-optionalboost` — Gurdurr `sv06-104` "Superpower"'s printed text,
    verbatim off the remote D1 — is the other half. */
export function optionalBoostProgram(
  reading: AttackOptionalBoost,
  base: number,
  note: string,
): EffectOp[] {
  const [then, otherwise] = boostedArms(base, reading.bonus, reading.ops);
  return [
    {
      op: "optional",
      // The WHOLE printed sentence, the op's own contract — it is what the confirm
      // dialog shows, and the player is being asked to agree to the drawback as
      // much as to the damage.
      note,
      then,
      otherwise,
    },
  ];
}

/** 🆕 D318 — THE TWO ARMS *"{decider}, this attack does {N} more damage, and
    {consequent}"* HAS IN EVERY SPELLING, BUILT ONCE.

    🛑 THIS EXISTS BECAUSE `precheck` REFUSED THE DUPLICATE, AND THE REFUSAL WAS
    RIGHT. `optionalBoostProgram` (above) and `bonusConsequentProgram` (below) are
    the SAME program with three different deciders — a confirm, a board condition
    and a coin — so both were about to spell the boosted `damageDefender` and the
    consequent splice byte for byte, and the mutation corpus reported it
    immediately: two D317 rows whose `find` had occurred exactly once went `2×`.
    **That is D317's own lesson arriving from the direction it did not predict** —
    it recorded *"a one-line `find` is only unique until somebody writes the same
    line"* about a line duplicated by accident, and here the duplicate was about to
    be written on purpose. ⚠️ THE FIX IS THE ONE THE CORPUS WAS ASKING FOR AND NOT
    THE ONE THAT WOULD HAVE SILENCED IT: widening the two rows' anchors would have
    kept two copies of one arm and pinned an ADJACENCY claim on top of them;
    sharing the construction leaves one occurrence, which is unique for the reason
    a mutation row wants — there is only one of it.

    🛑 AND THE FIRST DRAFT OF THIS DOC BLOCK QUOTED THOSE TWO LINES VERBATIM, WHICH
    PUT THE ANCHOR BACK — IN A COMMENT. `precheck` went quiet, because the row was
    at `1×` again and `1×` is the passing state; the occurrence was simply in the
    wrong place, and the mutant would have edited prose and SURVIVED. **`precheck`
    reports `0×` and `2×` and is structurally blind to `1×` AT THE WRONG SITE** —
    D210's finding (a doc comment spelling an action as a double-quoted literal
    satisfied a source-scan guard) in the one tool built to prevent it. The rule
    that falls out: **DESCRIBE CODE IN A DOC BLOCK, DO NOT REPRODUCE IT AT ITS OWN
    INDENTATION.**

    ⚠️ A TUPLE AND NOT AN OBJECT, WHICH IS NOT A STYLE CHOICE. Returning
    `{ then, otherwise }` would put an explicit `then:` KEY in this file and trip
    `lint/suspicious/noThenProperty`; destructuring a tuple gives both callers a
    LOCAL named `then`, which they splice by SHORTHAND, which the rule does not
    fire on. That is D317's measured trick, and it is what keeps three gate
    literals across two functions free of a suppression each.

    🛑 THE DECLINE ARM IS THE PRINTED BASE, NOT NOTHING — the one piece of
    behaviour this helper carries. Every printing of every spelling has a real
    printed base (`120+`, `50+`, `130+`, `140+`, `30+`), so an absent second arm
    would silently delete the whole attack on a "no", a tails or an un-evolved
    Active. */
function boostedArms(
  base: number,
  bonus: number,
  ops: readonly EffectOp[],
): [EffectOp[], EffectOp[]] {
  return [
    [{ op: "damageDefender", amount: base + bonus }, ...ops],
    [{ op: "damageDefender", amount: base }],
  ];
}

/** 🆕 D317 — *"…this attack does {N} more damage, and {consequent}"*: ONE
    decision buying BOTH a bigger hit and a second effect. SIX legal printings on
    TWO sentences (remote D1, `instr(attacks_json, 'more damage, and ') > 0`, whole
    column read, 2026-08-10 — 14 rows, 6 of them `legal_standard = 1`):

    * Hearthflame Mask Ogerpon ex `sv06-040`/`-192`/`-212`/`sv08.5-017`/`-148`
      (**5**, one card in five rarities) "Dynamic Blaze" (`140+`, index 1) —
      *"If your opponent's Active Pokémon is an Evolution Pokémon, this attack
      does 140 more damage, and discard all Energy from this Pokémon."*
    * Floragato `sv09-017` (**1**) "Magical Leaf" (`30+`) — *"Flip a coin. If
      heads, this attack does 30 more damage, and heal 30 damage from this
      Pokémon."*

    ⚠️ **THE WIDTH WAS SWEPT BEFORE THE ARM WAS WRITTEN AND IT IS EXACTLY TWO
    SENTENCES.** `'more damage, and '` returns nothing in `effect` or
    `abilities_json`; the comma-less spelling (`'more damage and '`) returns
    nothing in any column; and the reversed order (`'and this attack does '`)
    returns five rows that are a DIFFERENT family entirely (a cost paid up front
    and then a flat hit — Armarouge `sv08-034`, Bombirdier `sv09-101`, Zeraora
    `sv10-078`, Quagsire `svp-156`, Misty's Gyarados `sv10-049`), none of them
    carrying "more". The other 8 rows of the family are `legal_standard = 0`
    (Floette `sv01-092` prints Floragato's sentence byte-identically; Beedrill
    `sv03.5-015`, Tapu Koko ex `sv04-068`/`-222`/`-247` and Conkeldurr V
    `swsh10.5-040`/`-073`/`-074` print four more antecedent/consequent pairs), so
    the reach of this shape is wider than its census value of 6 — which is why
    both halves are CAPTURED rather than pinned.

    🛑 **THE NINTH READER, AND IT IS D316's SHAPE WITH THE DECIDER CHANGED.** That
    slice read *"You may do {N} more damage. If you do, …"* — a CONFIRM buying a
    bonus and a drawback. This is the same sentence with the player taken out of
    it: a BOARD FACT decides it on Ogerpon, a COIN on Floragato. The reading is
    therefore the same triple (a decider, a bonus, a consequent) and the program
    is the same gate, which is exactly why the two sentences are ONE arm and not
    two slices.

    🛑 **WHY THE WHOLE HIT MOVES INSIDE THE GATE — AND WHY THE OTHER ROUTE IS NOT
    MERELY UGLIER BUT WRONG ON FLORAGATO.** The tempting cheaper build is to leave
    the bonus in the pre-W/R fold (where `deriveAttackDamageBonus` already puts the
    BARE form of Ogerpon's antecedent, at 50/80/90 on three sibling printings) and
    hang the consequent off a separate gate program. It fails, for two reasons of
    different weight:

    * **THE COIN CANNOT BE FLIPPED TWICE.** `deriveAttackCoinFlip`'s
      `bonusOnHeads` takes its flip in attack.ts, in FRONT of §8.5; a
      `coinFlipGate` program takes its own at the interpreter's tail. One printed
      coin would become two draws, two `ATTACK_EFFECT_COIN_FLIP` rows and two
      independent answers — a board on which the bonus lands and the heal does
      not. There is no arrangement of two readers that makes one printed coin one
      flip, because the two sites are on opposite sides of the pipeline.
    * **AND IT NEEDS ONE SENTENCE READ BY TWO READERS**, which every doc block in
      this file denies out loud (*"at most one of the four ever fires on a given
      attack"*). That invariant is not decoration: it is what makes attack.ts's
      simulated-flags SUMS rather than choices.

    So the decision is taken ONCE, by one reader, and both arms deal ONE
    `damageDefender` through the full §8.5 pipeline — the yes arm at
    `base + bonus` with the consequent behind it, the no arm at the bare printed
    base. §8.5 is applied once per damage op (D316's argument, inherited whole and
    still the reason): Weakness DISTRIBUTES over a split hit, but Resistance and
    the defender's reduction are SUBTRACTIONS paid once per hit, the §8.1 survival
    clamp would be asked twice, and one printed number would emit two
    `DAMAGE_DEALT` rows.

    ⚠️ **WHAT ROUTE 1 GIVES UP, NAMED RATHER THAN GLOSSED.** `snipeActive` folds
    the attacker's pre-W/R bonus, the installed debuff, the always-on debuff,
    Weakness, Resistance and the target's reduction — but NOT
    `boostedAttackDamage`, D155's per-INDEX installed boost, which attack.ts reads
    at a site that has `index` in scope and the interpreter structurally does not.
    Unreachable on these six printings (the boost is installed by the attacker's
    OWN previous attack, and neither Ogerpon's "Wrathful Hearth" nor Floragato's
    only attack installs one), and it is the same price D316 paid at the same seam
    — recorded here so a future printing that CAN reach it is a known cost rather
    than a surprise.

    ⚠️ **THE CONSEQUENT IS DISPATCHED, NEVER INTERPRETED** — D316's rule verbatim.
    Both halves are matched whole against `^…$` anchors, so an unrecognised
    consequent returns null and the ENTIRE sentence stays on the loud
    `ATTACK_EFFECT_SKIPPED` path. Never a prefix match: a reader that swallowed the
    damage and dropped the discard would ship an Ogerpon whose printed cost
    silently vanished, which is strictly worse than not reading the card at all.

    ⚠️ **THE TWO CONSEQUENT VERBS ARE SPELLED LOWERCASE AT THE ANCHOR AND NOT AS A
    `[Dd]` / `[Hh]` CLASS** — D246's rule and D316's precedent one reader up: the
    capital on a bare anchor is exactly what keeps a whole-sentence reader off a
    mid-sentence clause, and a case class here would give that up in both
    directions at once. Neither consequent has an apostrophe slot to class; the
    ANTECEDENT does, and it carries the class through `boardConditionForClause`'s
    `literalClauseRow` fold (D136/D137), which is the site rather than a copy. */
export interface AttackBonusConsequent {
  /** What decides BOTH halves — a board fact read at declaration, or one coin
      taken by the gate the program carries. Never both, and never neither: the
      union is closed by the two anchors below. */
  decider: { kind: "boardCondition"; cond: BoardCondition } | { kind: "coinFlip" };
  /** The printed extra damage the YES arm adds to the attack's own printed base. */
  bonus: number;
  /** What the printed join — ", and …" or (D382) ". Then, …" — buys on the YES
      arm, in printed order. Named `ops` for `AttackOptionalBoost.ops`'s reason: it
      is a program reached through a READING, not a branch hanging off an
      `EffectOp` a walk can find. */
  ops: EffectOp[];
}

const BONUS_CONSEQUENT_CONDITION = /^If (.+), this attack does (  +) more damage, and (.+)$/;
/** 🆕🆕 D382 — the SAME condition form with the printed join spelled `. Then, `
    rather than `, and `: Chi-Yu `sv06-039` "Ground Melter" ({R}{C}, `60+`, index 1
    — confirmed by id against tcgdex) prints *"If a Stadium is in play, this attack
    does 60 more damage. Then, discard that Stadium."*

    🛑 **A SECOND ANCHOR AND NOT A WIDENED ONE, BECAUSE THE TWO JOINS ARE PROVABLY
    DISJOINT AND THE PROOF IS WORTH KEEPING.** Measured over `legalAttackCorpus()`:
    the `, and ` anchor matches ONE sentence (5 printings) and the `. Then, ` anchor
    matches ONE (1 printing), and neither matches the other's. An alternation
    `(?:, and |\. Then, )` would have collapsed that into a regex whose greed nobody
    can read off the page; two named constants keep the claim assertable, which
    `bonusConsequent.test.ts` §8 does in both directions.

    ⚠️ **AND THE `. Then, ` JOIN IS NOT WIDENED TO THE COIN FORM**, deliberately:
    `/^Flip a coin\. If heads, this attack does (\d+) more damage\. Then, /` returns
    **ZERO** sentences in the whole legal attack column, so a coin arm for it would
    be authoring a card rather than reading one (D190b's "exact map or flag"). */
const BONUS_CONSEQUENT_CONDITION_THEN =
  /^If (.+), this attack does (  +) more damage   Then, (.+)$/;
const BONUS_CONSEQUENT_COIN =
  /^Flip a coin   If heads, this attack does (  +) more damage, and (.+)$/;
const CONSEQUENT_DISCARD_ALL_SELF_ENERGY = /^discard all Energy from this Pokémon  $/;
const CONSEQUENT_HEAL_SELF = /^heal (  +) damage from this Pokémon  $/;
/** 🆕🆕 D382 — Ground Melter's consequent. LOWERCASE `discard` and the ANAPHORIC
    *"that Stadium"*, both load-bearing: `deriveAttackEffect`'s `DISCARD_STADIUM`
    reads the capitalised standalone imperative *"Discard a Stadium in play."*
    (D380) and returns null for this string, which is exactly why the consequent has
    to be dispatched here rather than delegated to that reader. */
const CONSEQUENT_DISCARD_STADIUM = /^discard that Stadium  $/;

/** The consequent half, dispatched over its closed anchor list — the ops the
    printed join buys, or null for a consequent this engine does not read. All
    THREE ops already shipped: `discardEnergy {from:"yourActive", count:"all"}` is
    `FLIP_TAILS_SELF_DISCARD_ALL`'s own op, `heal {target:"self"}` has run since
    0.x and `discardStadium` is D380's, so what this slice actually buys is a
    NUMBER — which of two amounts the single §8.5 hit uses — exactly as D316's
    did. */
function bonusConsequentOps(consequent: string): EffectOp[] | null {
  if (CONSEQUENT_DISCARD_ALL_SELF_ENERGY.test(consequent)) {
    return [
      { op: "discardEnergy", from: "yourActive", filter: { kind: "anyEnergy" }, count: "all" },
    ];
  }
  // 🆕🆕 D382 — the op ALONE, with no gate around it and no `optional`: the
  // antecedent this consequent hangs off is ALREADY `stadiumInPlay`, so the yes arm
  // is only ever reached on a board that has a Stadium to discard, and the printed
  // sentence carries no "you may". Wrapping it would be D380's stakeless dialog
  // with the stake removed twice over.
  if (CONSEQUENT_DISCARD_STADIUM.test(consequent)) return [{ op: "discardStadium" }];
  const heal = CONSEQUENT_HEAL_SELF.exec(consequent);
  if (heal !== null) {
    const amount = Number(heal[1]);
    // A printed 0 heals nothing — the guard every captured amount in this file
    // carries, and it keeps such a printing LOUD rather than silently claiming to
    // simulate a sentence with a no-op in it.
    return amount >= 1 ? [{ op: "heal", target: "self", amount }] : null;
  }
  return null;
}

/** Parse the bonus-plus-consequent sentence into its decider, its bonus and its
    consequent's ops, or null for anything else.

    THE NINTH READER of the same effect text, and disjoint from all eight. The
    COIN form is denied to `deriveAttackCoinFlip` by its consequent (that reader's
    `bonusOnHeads` anchor ends at *"more damage."*, so the trailing *", and …"*
    refuses it) and to `deriveAttackEffect` for the same reason from the other
    side. The CONDITION form is denied to `deriveAttackDamageBonus` by
    `CONDITIONAL_DAMAGE_BONUS`'s own `\.$`. Every one of those refusals is
    ASSERTED rather than assumed — see `bonusConsequent.test.ts` §1, which runs all
    eight over both printed sentences and requires null from each.

    ⚠️ THE COIN ANCHOR IS TRIED FIRST AND THE ORDER IS NOT ARBITRARY: the
    condition anchor's `If (.+)` would otherwise claim *"heads"* out of the coin
    sentence's second clause and hand it to `boardConditionForClause`, which would
    return null and REFUSE the whole thing — a silent loss of Floragato rather than
    a wrong answer, but a loss. Anchoring the coin form at `^Flip a coin\.` is what
    makes the two mutually exclusive; testing it first is what makes that
    independent of the condition anchor's greed.

    🆕🆕 **D382 — THE CONDITION FORM NOW HAS TWO PRINTED JOINS, AND THE `??` BELOW
    IS AN ORDER-INDEPENDENT FOLD RATHER THAN A PRECEDENCE.** Unlike the coin/condition
    pair above — where the order IS load-bearing — `, and ` and `. Then, ` are
    mutually exclusive by construction: the second anchor requires a literal `. `
    where the first requires a literal `, `, at the same offset in the same
    sentence. So no sentence can match both, the `??` can be read in either
    direction, and `bonusConsequent.test.ts` §8 asserts that rather than trusting
    it. ⚠️ **Which is why a mutant SWAPPING the two operands is a DECLARED
    EQUIVALENT SURVIVOR and not a gap** — see `scripts/mutation/mutants.ts`. */
export function deriveAttackBonusConsequent(text: string): AttackBonusConsequent | null {
  const effect = text.trim();
  const coin = BONUS_CONSEQUENT_COIN.exec(effect);
  if (coin !== null) {
    const bonus = Number(coin[1]);
    // A printed 0 adds nothing — the guard every arm of the damage-bonus family
    // carries, and here it is the whole reason the decision is worth taking.
    if (bonus < 1) return null;
    const ops = bonusConsequentOps(coin[2] ?? "");
    return ops === null ? null : { decider: { kind: "coinFlip" }, bonus, ops };
  }
  const condition =
    BONUS_CONSEQUENT_CONDITION.exec(effect) ?? BONUS_CONSEQUENT_CONDITION_THEN.exec(effect);
  if (condition === null) return null;
  // An UNMAPPED clause falls through to null and stays LOUD — `CONDITIONAL_DAMAGE_
                                                                                
                                                                              
                                                                           
  const cond = boardConditionForClause(condition[1] ?? "");
  if (cond === null) return null;
  const bonus = Number(condition[2]);
  if (bonus < 1) return null;
  const ops = bonusConsequentOps(condition[3] ?? "");
  return ops === null ? null : { decider: { kind: "boardCondition", cond }, bonus, ops };
}

                                                                          
                          

                                                                               
                                                                                   
                                                                                  
                                                                               
                                                                                  
                                                                                  
                                                                             
                                     

                                                                                   
                                                                                 
                                                                                 
                                                                                
                                                                               
                                                                       
export function bonusConsequentProgram(reading: AttackBonusConsequent, base: number): EffectOp[] {
                                                                               
                                                                                 
                                                                                 
                                                                         
                                                                               
                                                                                
                                                                              
    
                                                                                 
                                                                                
                                                                            
                                                                            
                                                                              
                            
  const [then, otherwise] = boostedArms(base, reading.bonus, reading.ops);
  return reading.decider.kind === "coinFlip"
    ? [{ op: "coinFlipGate", then, otherwise }]
    : [{ op: "conditionGate", cond: reading.decider.cond, then, otherwise }];
}

                                                                               
                                                                                 
                                                                                 
                                                   

                                                                             
                                                                                
                                                                          
                                                                             
             

                                                                              
                                                                                 
                                                                                   
                                                                                  
                                                                              
                                                                              
                                                                               
                                                                                  
                                                                           
                                                                            
                                                                                  
                                                                     

                                                                                
                                                                               
                                                                                   
                                                                                
                                                                                  
                                             

                                                                                 
                                                                                   
                                                                        
                                                                                    
                                                                                
                                                                              
                                                                            
                                                                                  
                                                                                   
                                                                              
                                                                                   
                                                                                   
                                        

                                                                                  
                                                                                  
                                        

                                                                                 
                                                                                 
                                                                                     
                                                                                     
                                                                                    
                                                                       
                                                                                  
                                                                                   
                                                                                     
                                                                                  
                                                                              
                                                                          

                                                                                    
                                                                                    
                                                                                      
                                                                               
                                                                                     
                                                                                       
                                                                                  
                                                                                    
                                                                              
                                                                                
                                                                          
                                                                                    

                                                                                 
                                                                                   
                                                                          
                          
export interface AttackOptionalCostBoost {
                                                                                   
                                                                                
                                                                               
                                                                         
  cond: BoardCondition;
                                                                                   
                                                                                   
                                                                           
  ops: EffectOp[];
                                                                                 
                                                                                     
                                                                               
                                                                                
                                                                                    
                                                                                
  payoff: AttackOptionalCostPayoff;
}

                                                                              
                                                              

                                                                                
                                                                                   
                                                                             
                                                                                   
                                                                                  
                                                                           
                                                                           
                                                                                    
                                                                             
                                                                                    
                                                                                  

                                                                                 
                                                                   
                                                                                    
                                                                                  
                                                                                 
                                                                                  
                                                                                
                                                 
export type AttackOptionalCostPayoff =
                                                                              
                                                                                  
                                                                                
                                                               
  | { kind: "moreDamage"; bonus: number }
                                                                           
                                                                             
                                                                                  
                                                                              
                                        

                                                                          
                                                                                  
                                                                                 
                                                                                   
                                                                                 
                                                                                   
                                                           

                                                                    
                                                                                   
                                                                                  
                                                             
                                                                                   
                                                                                  
                                                                                 
                                                                          

                                                                                
                                                                                    
                                                                              
                                                                                 
                                                                                   
                                                                             
  | { kind: "benchSnipe"; amount: number; count: number };

                                                                                
                                        

                                                                             
                                                                                    
                                                                                 
                                                                                    
                                                                                    
                                                                                 
                                                

                                                                              
                                                                                    
                                                                                  
                                                                                  
                                                                                    
                                                                                      
                                                                                      
                                                                                     
                                                                                      
                                                                              
                                                                                     
                                                                            

                                                                                      
                                                                                
                                                                            
                                                                                 
                                                                                     
                                                                                      
                                                    
const OPTIONAL_COST_CONNECTIVE = "(?:If you do|If you discarded any cards in this way)";
const OPTIONAL_COST_BOOST = new RegExp(`^You may (.+)  . ${OPTIONAL_COST_CONNECTIVE}, (.+)$`);
const OPTIONAL_COST_DISCARD_STADIUM = /^discard a Stadium in play$/;
                                                                                 
                                                                                      
                                                                                     
                                                                                     
                                                                                
                                                                             
const OPTIONAL_COST_DISCARD_HAND = /^discard your hand$/;
                                                                                  
                                                                                    
                                                                                  
                                                                                  
                                                                                    
                                                                                    
              
const OPTIONAL_COST_SHUFFLE_SELF_ENERGY =
  /^shuffle (\d+) Energy attached to this Pokémon into your deck$/;
const OPTIONAL_COST_PAYOFF_MORE_DAMAGE = /^this attack does (\d+) more damage\.$/;
                                                                             
                                                                                    
const OPTIONAL_COST_PAYOFF_BENCH_SNIPE = new RegExp(`^this ${ALSO_BENCHED_SNIPE_BODY}$`);

                                                                               
                                                                                  
                                                                   
                                                                                 
                                                                 

                                                                             
                                                                                    
                                                                         
                                                                                    
                                                                                 
                                                                                    
                                                                               
                                                                                 
                                                                                    
                                                                               
                                       
function optionalCostOps(cost: string): { cond: BoardCondition; ops: EffectOp[] } | null {
  if (OPTIONAL_COST_DISCARD_STADIUM.test(cost)) {
    return { cond: { kind: "stadiumInPlay" }, ops: [{ op: "discardStadium" }] };
  }
                                                                                 
                                                                             
                                                                                     
                                                                                    
                                                                                    
                                                                                
                                                             
    
                                                                           
                                                                                     
                                                                               
                                                                               
                                                                                 
                                                                           
                                                                                  
  if (OPTIONAL_COST_DISCARD_HAND.test(cost)) {
    return { cond: { kind: "yourHandNotEmpty" }, ops: [{ op: "discardHand" }] };
  }
  const shuffle = OPTIONAL_COST_SHUFFLE_SELF_ENERGY.exec(cost);
  if (shuffle !== null) {
    const count = Number(shuffle[1]);
                                                                                 
                                                                                
                                                                                  
            
    if (count < 1) return null;
    return {
      cond: { kind: "yourActiveEnergyAtLeast", count },
      ops: [
                                                                                   
                                                                                    
                                                                                  
                                                   
        { op: "discardEnergy", from: "yourActive", filter: { kind: "anyEnergy" }, count, to: "deck" },
                                                                                    
                                                                               
                              
        { op: "shuffleDeck" },
      ],
    };
  }
  return null;
}

                                                                                   
                                                                               
                                                                                   
                                                                    
function optionalCostPayoff(payoff: string): AttackOptionalCostPayoff | null {
  const more = OPTIONAL_COST_PAYOFF_MORE_DAMAGE.exec(payoff);
  if (more !== null) {
    const bonus = Number(more[1]);
                                                                                     
                                                                                     
                                                                       
    return bonus < 1 ? null : { kind: "moreDamage", bonus };
  }
  const snipe = OPTIONAL_COST_PAYOFF_BENCH_SNIPE.exec(payoff);
  if (snipe !== null) {
    const amount = Number(snipe[1]);
                                                                                   
                                                                                 
                         
    const count = Number(snipe[2]);
                                                                                   
                                                                                  
                                                                                       
                                                                                   
                                                                                        
                                                                                
                                                                                      
                                                                                     
                                                                                   
                                                                                    
                                                                                      
                                                          
                                                                                     
                                                                                     
                                                                                       
                                         
    if (snipe[5] !== undefined) return null;
                                                                                     
                                       
                                                                                       
                                                                                    
                                                                                  
                                                                                        
                                                                                         
                                                                                    
                                                                                      
                                                                                       
    if (snipe[4] !== undefined) return null;
                                                                                  
                                                                                       
                                                                                      
                                                                                    
                                                                                    
                                                                                    
                                                                                       
                                                                                 
                                                                                      
                                                                                       
    if (snipe[3] === "your") return null;
                                                                                     
                                                                     
    return amount < 1 || count < 1 ? null : { kind: "benchSnipe", amount, count };
  }
  return null;
}

                                                                                   
                                     

                                                                             
                                                                                  
                                                                              
                                                                               
                                                                                    
                                                                      
                                                                                 
                                                                              
                                                                                   
                                                                                    
                                                                                    
                     
export function deriveAttackOptionalCostBoost(text: string): AttackOptionalCostBoost | null {
  const match = OPTIONAL_COST_BOOST.exec(text.trim());
  if (match === null) return null;
  const cost = optionalCostOps(match[1] ?? "");
  if (cost === null) return null;
                                                                            
                                                                                 
                                                                                
                                                              
  const payoff = optionalCostPayoff(match[2] ?? "");
  return payoff === null ? null : { cond: cost.cond, ops: cost.ops, payoff };
}

                                                                              
                                              

                                                                           
                                                                                
                                                                                
                                                                                
                                                                               
                                                                                 
                                                                                    

                                                                               
                                                                                 
                                                                             
                                                                             
                                                                             
                                                                               
                                                            

                                                                                  
                                                                              
                                                                               
                                                                                  
                                                                                
                                                                                 
                                                                                   
                                                              
                                                                            
                                                                                
                                                                                   
                                                            

                                                                                
                                                                                
                                                                            
                                                                                
                                                  

                                                                              
                                                                                  
                                                                                  
                                                      
export function optionalCostBoostProgram(
  reading: AttackOptionalCostBoost,
  base: number,
  note: string,
): EffectOp[] {
  if (reading.payoff.kind === "benchSnipe") {
    return costSnipeProgram(reading, reading.payoff.amount, reading.payoff.count, note);
  }
  const [boosted, otherwise] = boostedArms(base, reading.payoff.bonus, []);
  const then = [...reading.ops, ...boosted];
                                                                                   
                                                                            
  const ask: EffectOp = {
    op: "optional",
                                                                                 
                                                                                     
    note,
    then,
    otherwise,
  };
                                                                                 
                                                                                    
                                                                  
                                                                                    
                                                                               
                                                                               
                                                                                    
                                                                              
                                                                             
  const [, vacantZone] = boostedArms(base, reading.payoff.bonus, []);
                                                                                
                                                                               
                                                                                   
                                                                               
                                                                             
                                                                  
  return [
    {
      op: "conditionGate",
      cond: reading.cond,
                                                                                                                                                
      then: [ask],
                                                                                   
                                                     
      otherwise: vacantZone,
    },
  ];
}

                                                                              
                                                                                   
                                                

                                                                             
                                                                                     
                                                                          
                                                                                     
                                                                                     
                                                                                   
                                                                                
                                                                                    
                                                                        

                                                                                    
                                                                              
                                                                              
                                                                                    
                                                                                   
                 

                                                                     
                                                                                   
                                                                                   
                                                                                  
                                                                                 
              
function costSnipeProgram(
  reading: AttackOptionalCostBoost,
  amount: number,
  count: number,
  note: string,
): EffectOp[] {
                                                                                
                                                                                    
  const then: EffectOp[] = [
    ...reading.ops,
                                                                                  
                                                                                    
                                                                            
                                                                                     
                                                                                    
                                                                                  
                                                                                   
    { op: "damageChosen", target: "opponentBench", amount, count, source: "attack", deals: true },
  ];
  const offer: EffectOp = { op: "optional", note, then };
  return [
    {
      op: "conditionGate",
                                                                                  
                                                                             
                                                                                   
                                                              
      cond: reading.cond,
                                                                                                                                                
      then: [offer],
    },
  ];
}

                                                                                  
                                                       

                                                                                   
                                                                           
                                                                                     
                                  
                                                                                     
                                                                   
                                                                               
                                                                               

                                                                                  
                                                                                     
                                                                                   
                                                                                  
                                                                                
                                                                               
                                                                                 
                                                                              

                                                                                   
                                                                                   
                                                                              
                                                                                    
                                                                             
                                                                                     
                                                                                  

                                                                                
                                                                                   
                                                                              
                                                                                     
                                                                                   
                                                         

                                                                                
                                                                                
                                                                                 
                                                                                  
                                                                                     
                                                                                 
                                                                                     
           

                                                                                     
                                                                                  
                                                                                    
                                                                              
                                                                                   
                         
export interface AttackBenchDiscardScaledBoost {
                                                                             
                                                                                    
                                                                                   
                            
  kind: "benchDiscard";
                                                                                    
                                                                               
  cap: number;
                                                                                      
  filter: CardFilter;
                                                                                 
                                                                                  
                                                               
  per: number;
}

                                                                             
                                                                                        
                                     

                                                                                      
                                                                                   
                                                                                 
                                                                                        
                                                                                       
                                                                                 

                                                                                 
                                                                                      
                                                                                      
                                                                                         
                                                                                     
                                                                                   
                                                                    
                                                                          
                                                                                       
                    

                                                                             
                                                                                  
                                                                          
                                                                                    
                                                                                      

                                                                                      
                                                                                      
                                                                                
                                                                                     
                                                  

                                                                              
                                                                                   
                                                                                         
                                                                                       
                                                                                      
                                                                                     
                                                                                         
                                                                                    
                                                                                
export interface AttackEachDeckMillScaledBoost {
  kind: "eachDeckMill";
                                                                                    
                                                                        
  per: number;
}

                                                                                
                                                                                  
                                                                                     
                                                                                  
export type AttackDiscardScaledBoost =
  | AttackBenchDiscardScaledBoost
  | AttackEachDeckMillScaledBoost;

                                                                                    
                                                                                      
                                                                                   
                                                                                    
const BENCH_DISCARD_SCALED_BOOST =
  /^You may discard up to (\d+) (Basic )?Energy from your Benched Pokémon\. This attack does (\d+) more damage for each card you discarded in this way\.$/;
                                                                                      
                                                                                          
                                                                                         
                                                                                          
                                                                            
const EACH_DECK_MILL_SCALED_BOOST =
  /^Discard the top card of each player['’]s deck   This attack does (  +) more damage for each Energy card discarded in this way  $/;

/** Parse the Bench-discard additive boost into its ceiling, its filter and its
    per-card damage, or null for anything else.

    THE ELEVENTH READER of the same effect text, and disjoint from all ten. Its
    leading words deny it `deriveAttackEffect`'s whole-sentence anchors (including
    `ENERGY_DISCARD_SCALED_DAMAGE`, whose own `does (  +) damage for each` refuses the
    printed `more`), both scaling readers' `^This attack does` / `^If`, the coin
    family's `^Flip a coin`, the requirement family's `^If` and the suppression
    family's `^This attack's damage`. ⚠️ **THE TWO IT DOES *NOT* SEPARATE FROM BY ITS
    LEADING WORDS ARE `deriveAttackOptionalBoost` AND `deriveAttackOptionalCostBoost`,
    which share `^You may ` with it** — the three are separated by the WORD AFTER IT
    (`OPTIONAL_DAMAGE_BOOST` reads `^You may do`, `OPTIONAL_COST_BOOST` reads a cost
    clause followed by a printed `If you do,` which this sentence does not carry) and
    by their payoffs. attack.ts owns the read site, beside its three siblings'. */
export function deriveAttackDiscardScaledBoost(text: string): AttackDiscardScaledBoost | null {
  // 🆕🆕 D490 — the two-deck mill, asked FIRST purely for legibility: the two anchors
  // are structurally disjoint (`^You may discard up to` against `^Discard the top card of
  // each player`), so no string reaches both and no order here can change an answer.
  const mill = EACH_DECK_MILL_SCALED_BOOST.exec(text.trim());
  if (mill !== null) {
    const perMilled = Number(mill[1]);
    // ONE printed number, ONE positivity guard — D145's standing rule. A printed 0 per
                                                                                         
                                                                            
    return perMilled < 1 ? null : { kind: "eachDeckMill", per: perMilled };
  }
  const match = BENCH_DISCARD_SCALED_BOOST.exec(text.trim());
  if (match === null) return null;
  const cap = Number(match[1]);
  const per = Number(match[3]);
                                                                                
                                                                                   
                                                                                     
                                                                                   
  if (cap < 1 || per < 1) return null;
  return {
    kind: "benchDiscard",
    cap,
    per,
                                                                                 
                                                                                    
                                                                           
    filter: match[2] === undefined ? { kind: "anyEnergy" } : { kind: "basicEnergy" },
  };
}

                                                                                
                 

                                                                                   
                                                                                 
                                                                               
                                                                                    
                                                                                  
                                                                                     

                                                                                   
                                                                                 
                                                                                 
                                                                                  
                         

                                                                               
                                                                                     
                                                                                     
                                                                            
export function discardScaledBoostProgram(
  reading: AttackDiscardScaledBoost,
  base: number,
): EffectOp[] {
                                                                               
                                                                                        
                                                                                        
  switch (reading.kind) {
    case "benchDiscard":
      return [
        {
          op: "discardEnergy",
                                                                                         
                                                                                       
          from: "yourBench",
          filter: reading.filter,
                                                                                           
                                                                               
          count: "any",
          cap: reading.cap,
          recordAs: "discarded",
        },
        { op: "damageDefender", base, per: reading.per, count: "discarded" },
      ];
    case "eachDeckMill":
      return [
                                                                                      
                                                                                      
                                                                                       
                                                                                     
                                                                                       
                               
        { op: "discardDeckTop", whose: "eachPlayer", count: 1, recordAs: "discarded" },
                                                                                        
                                                                                       
                                                                                       
                                                                                        
                                                                                       
                                                 
        {
          op: "damageDefender",
          base,
          per: reading.per,
          count: "discarded",
          countFilter: { kind: "anyEnergy" },
        },
      ];
  }
}

                                                                              
                                                                                   
                                              

                                                                                  
                                                                               
                                                                           
                                                                               
                                                                        

                                                                               
                                                                              
                                                                               
                                                                              
                                                                                   
                                                                             
                                                                            
                                                    

                                                                                 
                                                                                  
                                                                                
                                                                                 
                                                                                
                                                                           
                                                                                 
                                                                                  
               
const ATTACK_GATE_CLAUSES = [
  "If you go second, you can't use this attack during your first turn.",
  "If you go first, you can use this attack during your first turn.",
  "You can use this attack only if you go second, and only during your first turn.",
  "You can use this attack only if this Pokémon used Rollout during your last turn.",
] as const;

                                                                               
                                                                      
                                                                                  
                                                  
export type AttackGateClause = (typeof ATTACK_GATE_CLAUSES)[number];

                                                                              
                                                                                  
                                                                            
                                                                            
                                                                              
const ATTACK_GATE_SECOND_PLAYERS_FIRST_TURN: BoardCondition = {
  kind: "allOf",
  conditions: [{ kind: "youGoSecond" }, { kind: "yourFirstTurn" }],
};

                                                                                  
                                                                                   
                                                                                   
                                                                              
                                                                                 
                                                                  

                                                                                  
                                                                                    
                                                                             
                                                                                    
                                                                              
                                                                                    
                                                                                   
                                                                                    
                                                                                   
                                                                               
                                                                                 
                                                                              
                                                                                             
                                                                                  
                                                                                      

                                                                               
                                                                               
                                                                                    
                                                                                
                                                                                   
                                                                                   
                                                         

                                                                                 
                                                                               
                                                                                    
                                                                                
                                                                                 
                                                                                    
                                                                              
const ATTACK_GATE_CLAUSE_GATES: Record<AttackGateClause, AttackTimingGate> = {
  "If you go second, you can't use this attack during your first turn.": {
    kind: "barredIf",
    condition: ATTACK_GATE_SECOND_PLAYERS_FIRST_TURN,
  },
  "If you go first, you can use this attack during your first turn.": {
    kind: "firstTurnExempt",
  },
  "You can use this attack only if you go second, and only during your first turn.": {
    kind: "onlyIf",
    condition: ATTACK_GATE_SECOND_PLAYERS_FIRST_TURN,
  },
  "You can use this attack only if this Pokémon used Rollout during your last turn.": {
    kind: "onlyIf",
    condition: { kind: "yourActiveUsedAttackLastTurn", attack: "Rollout" },
  },
};

                                                                                 
                                                                                
                                                                             
                                                                                
                                                                                  
                                                    

                                                                                  
                                                                                   
                                                                              
                                                                                
                                                                               
                                                                                  
                                             

                                                                               
                                                                                 
                                                                                 
                                                                                   
                                                                                  
                                                                                 
                                                                            
                            

                                                                               
                                                                         
                                                                             
                                                                                   
                                                                           
                                                                              
                                                                           
                                                                                 
                                                                              
                                                                                  
                                                                             

                                                                              
                                                                                
           
                                                                                     
                                                                                   
                                                                             
                                                                                  
                  
                                                                             
                                                                   
                                                                                  
                                                                                 
                                            
                                                                              
                                                                                 
                                                                                 
                                                

                                                                                
                                                                                
                                                                               
                                             
                                                          
                                                                                  
                                                                               
                                                                                  
                                                               

                                                                               
                                                                     
export function splitAttackGateClause(
  text: string,
): { clause: AttackGateClause; body: string } | null {
  const trimmed = text.trim();
  for (const clause of ATTACK_GATE_CLAUSES) {
                                                                               
                                                                               
                                                                                
                                                                                
                                                                              
                                                                                 
                                                                                
                                                 
      
                                                                                 
                                                                                 
                                                                                 
                                                                                
                                                                                
                                                                               
                                                                               
                                                                
                                                                                   
                                                                      
      
                                                                               
                                                                           
                                                                                 
    if (trimmed === clause) return { clause, body: "" };
    if (!trimmed.startsWith(`${clause} `)) continue;
    const body = trimmed.slice(clause.length + 1).trim();
                                                                                 
                                                                     
    return { clause, body };
  }
  return null;
}

                                                                            
                                                                                    
                                                                                   
                                                                           
                                                                          

                                                                                    
                                                                                  
                                                                                   
                                                                                    
                                                                                   
                                                                                 
                                                                                   
                                                                                  
                                                                             
                                                                                 

                                                                                    
                                                                          
                                                                   
                                                                                      
                                                                              
                                                                                
                                                                                   
                                                                                  
                                                                               
                                                                    
                                                                               
                                                                                     
                                                                                  
                                                                          
                                                                                 
                                                                                     
                                                                                    
                                                               
                                                                                    
                                                                                   
                                                                                  
                                                                                     
                                                                                 
                                                                                    
                                                                                   
                                                               

                                                                                    
                                                                                    
                                                                                
                                                     

                                                                                
                                                                                
                                                                         
                                                                                    
                                                                                   
                                                                                     
                                                                              
                                                                                    
                                                                                     
                                                                                 
                                                                                    
                                                                                  
                                                                                      
                                                            
export function timingGateFromAttackText(text: string | undefined): AttackTimingGate | undefined {
  if (text === undefined) return undefined;
  const split = splitAttackGateClause(text);
  return split === null ? undefined : ATTACK_GATE_CLAUSE_GATES[split.clause];
}

                                                                        
                                                                                  
                                                                               
                                                                                 
                                                 

                                                                             
                                                                                 
                                                                                 
                                                                                
                                                                     
                                                                                   
                                                                             
                                                                            
                                       
const ATTACK_WHOLE_SENTENCE_READERS: readonly ((text: string) => unknown)[] = [
  deriveAttackEffect,
  deriveAttackDamageBonus,
  deriveAttackDamagePenalty,
  deriveAttackDamageMultiplier,
  deriveAttackCoinFlip,
  deriveAttackRequirement,
  deriveAttackDamageSuppression,
  deriveAttackOptionalBoost,
  deriveAttackBonusConsequent,
  deriveAttackOptionalCostBoost,
  deriveAttackDiscardScaledBoost,
                                                                              
                                                                                
                                                                                 
                                                                                 
                                                               
                                                                             
                                                                               
                                                                                  
                                                                                   
                                                                               
                                                                
  deriveAttackCancelRequirement,
                                                                               
                                                                                
                                                                                 
                                                                              
                                                                                
                                                                             
                                                                                
                                                                          
                                                                               
                                                                     
  deriveAttackPreDamage,
];

                                                                                
                                                                          
function claimedByAnyReader(text: string): boolean {
  return ATTACK_WHOLE_SENTENCE_READERS.some((read) => read(text) !== null);
}

                                                                              
                                                                               
                                                                                   
                                                                                     
const COMPOUND_CLAUSE_BREAK = /(?<=\.)\s+(?=[A-Z(])/;

                                                                              
                                                                            
                                                                                 

                                                                               
                                                                               
                                                                            
                                                                                 
                                                                                  
                                                                                  
                                                                   
                                                                                 
                                                                                
                                      

                                                                                    
                                                                                
                                                                                
                                                                               

                                                                                 
                                                                                   
                                                                              
                                                                         
                                                                              
                                           

                                                                           
                                                                             
                                                       
                                                                     
                                                                                     
                                                                                 
                                                                           
                                                                                  
                                   

                                                                                
                                                                                   
                                                                             
                                                                                
                                                                        
                                                                             
                                                                               
                                                                              
                                                            

                                                                                   
                                                                               
                                                                                  
                                                                                 
                                                                                  
                                                                                  

                                                                                   
                                                                                
                     
export function splitAttackTrailingClause(text: string): { head: string; tail: string } | null {
  const trimmed = text.trim();
                                                                                  
                                             
  if (claimedByAnyReader(trimmed)) return null;
  const parts = trimmed.split(COMPOUND_CLAUSE_BREAK);
  if (parts.length < 2) return null;
  const tail = parts[parts.length - 1] ?? "";
  const head = parts.slice(0, -1).join(" ");
                                                                               
                                                                                  
                                                                                
  if (deriveAttackEffect(tail) === null) return null;
  if (!claimedByAnyReader(head)) return null;
  return { head, tail };
}

                                                                                
                                                                                   
                                                                              
                                                                                 
                                        

                                                                                 
                                                                                  
                                                                                  
                                                                               
                                                                                
                                                                               
                                                                                 
                                                                        
                                                                                  
                                                                             
                                                                               
                                                                                  
                                                        
function attachedEnergyFilter(
  token: string | undefined,
): BasicEnergyType | "special" | "basic" | null | undefined {
  return token === undefined ? null : literalClauseRow(CLAUSE_ENERGY_TOKENS, token);
}

                                                                            
                                                                
                                
function statusOf(word: string | undefined): StatusName {
  return STATUS_OF_WORD[(word ?? "Asleep") as StatusWord];
}

                                                                              
                                                                         

                                                                              
                                                                               
                                                                             
                                                                                 
                                                                                   
                                                                                     
                                                                                    
                                                                                    
                                                                                 
                                                                                  
                                                        

                                                                            
                                                                                   
                                                                                    
                                                                                 
                                                                              
                                                            

                                                                                   
                                                                                    
                                                                               
                                                                                 
                                                                                    
                                                                                 
                                                                                 
                                                                                  
                                                                                
                                                                            
                                                                                   
                 
function defenderStatusOps(words: (string | undefined)[]): EffectOp[] | null {
  const statuses = words.map(statusOf);
  const slots = statuses.map((s) => CONDITION_SLOT[s]);
  if (new Set(slots).size !== slots.length) return null;
  return statuses.map((status): EffectOp => ({ op: "applyStatus", target: "defender", status }));
}

                                                                                
                                             
  
                                                                                 
                                                                             
                                                                                   
                                                                                  
                                                                            
                                  
  
                                                                                  
                                                                                   
                                                                                  
                                                                                   
                                                                               
                                                                                 
                                                                                  
                                                                                   
                                                                              
                                                      
  
                                                                                 
                                                                              
                                                                                  
                                                                                   
                                                                             
                                                                        
                               
  
                                                                               
                                                                                
                                                                               
                                                                                      
                                                                                    
                                                                                     
                                                                                 
                                                                                 
                                                                                    
                                                                            
                                                                        
  
                                                                             
                                                                             
                                                                                  
                                                                                  
                                                                               
                                                                              
                                                                                   
                                                                                  
                                                                              
  
                                                                                   
                                                                                
                                                                                     
                                                                                    
                                                                                     
                                                                             
                                                                                 
                                                                                  
                                                                                     
                                                                                 
                                                                                  
                                                                                     
                                                                              
                                                                                  
                                                                  
  
                                                                               
                                                                                   
                                                                                    
                                                                               
                                                                                
                                                                            
                                                    
  
                                                                                     
                                                                                  
                                                                              
                                                                               
                                                                                    
                                                                                    
                                                                                     
                                                                                  
                                                                                   
                                                                                 
                                                                                 
                                  

                                                                              
                                                                           
                                                         

                                                                               
                                                                               
                                                                                   
                                                                              
                                                                                
                                                                                  
                                                                               
                                                                              
                                                                                  
                                                                                 
                                                                 

                                                                            
                                                                                 
                                                                             
                                                                               
                                                                                
                                                                                
export type AttackPreDamage =
                                                                                   
                                     
  | { kind: "discardOpponentActiveTools" }
                                                                            
                                                                                 
                                                                                  
                                                      
  | { kind: "discardOpponentActiveToolsAndSpecialEnergy" }
                                                                                 
                                                                              
                                                                       
  | { kind: "discardOwnToolsElseCancel" }
                                                                                   
                                                                                 
                                                      
  | { kind: "discardOpponentActiveToolsThenParalyze" };

                                                                             
                                                                               
                                                                                   
                                                                         
                                                                                   
                                                                              
                                                                                  
                                                                              

                                                                                  
                                                                                  
                                                                               
                                                                            
                                                                                
                                                                            
                    

                                                                                 
                                                                                  
                                                                           
                                                                             
                                                                               
                                                                                 
                                                                         
const ATTACK_PRE_DAMAGE_TOOL_DISCARD =
  /^Before doing damage, discard all Pokémon Tools from your opponent['’]s Active Pokémon  $/;

/** Row 71 — the SECOND ZONE. `Tools and Special Energy` is one noun phrase over two
    attachment kinds, and both come off the same body. */
const ATTACK_PRE_DAMAGE_TOOL_AND_SPECIAL_DISCARD =
  /^Before doing damage, discard all Pokémon Tools and Special Energy from your opponent['’]s Active Pokémon\.$/;

                                                                                    
                                                                                 
                                                                                    
const ATTACK_PRE_DAMAGE_OWN_TOOL_DISCARD_OR_NOTHING =
  /^Before doing damage, discard all Pokémon Tools from this Pokémon\. If you can['’]t discard any, this attack does nothing  $/;

/** Row 74 — row 73's act plus a consequent conditioned on its RESULT. Anchored whole
    for row 72's reason: *"in this way"* is a §9.2 back-reference and is false of any
    string that does not carry the act it refers to. */
const ATTACK_PRE_DAMAGE_TOOL_DISCARD_THEN_PARALYZE =
  /^Before doing damage, discard all Pokémon Tools from your opponent['’]s Active Pokémon\. If you discarded a Pokémon Tool in this way, your opponent['’]s Active Pokémon is now Paralyzed  $/;

/** The *"Before doing damage, …"* family, whole-sentence anchored — **4 sentences /
    8 legal printings**, measured over `legalAttackCorpus()` (the committed
    `legal_standard = 1` attack column: 640 sentences / 1,732 printings): row 73 at 5
    printings (D428) plus rows 71, 72 and 74 at 1 each (D429). `null` for every other
    string, including the fifth *"before doing damage"* row in the column, whose
    clause is the SECOND sentence and is already served by `deriveAttackRequirement`.

    ⚠️ ONE reader for the whole family rather than four, so the ATTACK READER
    SURFACE stays at **13** across this slice — the census figures move by printings
    and not by instrument shape. */
export function deriveAttackPreDamage(text: string): AttackPreDamage | null {
  const trimmed = text.trim();
  if (ATTACK_PRE_DAMAGE_TOOL_DISCARD.test(trimmed)) return { kind: "discardOpponentActiveTools" };
  if (ATTACK_PRE_DAMAGE_TOOL_AND_SPECIAL_DISCARD.test(trimmed)) {
    return { kind: "discardOpponentActiveToolsAndSpecialEnergy" };
  }
  if (ATTACK_PRE_DAMAGE_OWN_TOOL_DISCARD_OR_NOTHING.test(trimmed)) {
    return { kind: "discardOwnToolsElseCancel" };
  }
  if (ATTACK_PRE_DAMAGE_TOOL_DISCARD_THEN_PARALYZE.test(trimmed)) {
    return { kind: "discardOpponentActiveToolsThenParalyze" };
  }
  return null;
}
