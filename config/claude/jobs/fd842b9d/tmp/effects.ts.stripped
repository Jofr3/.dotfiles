const SELF_ENERGY_ATTACHED_CLAUSE = /^this Pokémon has any (.+) Energy attached$/;
const CLAUSE_ENERGY_TOKENS: ReadonlyMap<string, BasicEnergyType | "special" | "basic"> = new Map([
  ...Object.entries(ENERGY_TYPE_BY_CODE).map(
    ([code, type]) => [`{${code}}`, type] as [string, BasicEnergyType | "special" | "basic"],
  ),
  ...Object.entries(ENERGY_TYPE_BY_NAME).map(
    ([name, type]) => [name, type] as [string, BasicEnergyType | "special" | "basic"],
  ),
  ["Special", "special"] as [string, BasicEnergyType | "special" | "basic"],
                                                                              
                                                                                   
                                                                                     
                                                                                     
                                                                                      
                                                                    
                                                                           
                                                          

                                                                                      
                                                                                
                                                                                     
                                                                                 
                                                                       
                                                                                
                                                                               

                                                                                 
                                                                      
                                                                                   
                                                                                   
                                                                                   
                                                                                  
                                                                                    
                                                                                    
                                                                                     
                                                             

                                                                               
                                                                                    
                                                                                   
                                                                       
  ["Basic", "basic"] as [string, BasicEnergyType | "special" | "basic"],
]);

                                                                                
                                                                                
                                                                       

                                                                              
                                                                                 
                                                                            
                                                                            
                                                                               
                                                                              
                                                                     

                                                                            
                                                                             
                                                                      
                                                                           
                                                                             
                                                                                 
                                                                                 
                                                                           

                                                                               
                                                                                
                                                            

                                                                              
                                                                               
                                                                                 
                                                                              
                                                                                 
const OPPONENT_ACTIVE_TYPE_CLAUSE = /^your opponent['’]s Active Pokémon is a (.+) Pokémon$/;
/** 🆕🆕 D367 — BOTH NOTATIONS, WHICH CLOSES AN ASYMMETRY BETWEEN TWO SIBLING
    TEMPLATES RATHER THAN ADDING VOCABULARY.

    🛑 **THE TWO PARAMETERISED CLAUSES IN THIS FAMILY DISAGREED ABOUT HOW MANY
    NOTATIONS THE CATALOG PRINTS, AND ONE OF THEM WAS RIGHT.**
    `CLAUSE_ENERGY_TOKENS`, twenty lines up, is built from the CODE map AND the
    NAME map and says why in its own doc block: *"Both notations are carried
    because the pool prints both and they are split cleanly by SET … a code-only
    parser would silently skip a whole set the moment one of its cards prints the
    shape."* This map was built from `POKEMON_TYPES` alone — the spelled-out names
    and nothing else — so it was the NAME-only mirror image of the parser that
    paragraph warns about, and the pool had already printed the shape it cannot
    see: **`{P}` on Bronzor `sv05-068`/`-170` "Mirror Attack" (+30) and `{D}` on
    Arcanine `sv10-028` "Punishing Fang" (+100), 3 legal printings, refused by ALL
    NINE readers at D366's head.**

    ⚠️ **ZERO NEW VOCABULARY, AND ZERO NEW MAP.** `POKEMON_TYPE_BY_CODE` already
    exists forty lines up, is already TOTAL over `POKEMON_TYPES` (the nine energy
    codes plus `N` → Dragon and `C` → Colorless) and is already pinned against it
    by `pokemonTypeCodesAreCanonical`. Spreading it here is the same construction
    `CLAUSE_ENERGY_TOKENS` uses, so the three maps cannot drift and a type added to
    `BASIC_ENERGY_TYPES` is admitted in BOTH notations by construction.

    ⚠️ **`{C}` AND `{N}` ARE CARRIED THOUGH NO PRINTING SPELLS THEM IN THIS CLAUSE**,
    for the reason `POKEMON_TYPE_BY_CODE`'s own block gives: `{C}` as a printed
    TYPE ON A BODY is unambiguous (only `{C}` as an ENERGY is the provision
    fallback that must stay out), and a notation map total over its vocabulary
    cannot rot the way a hand-kept alternation does.

    ⚠️ THE CLAUSE PATTERN IS UNCHANGED AND STILL LOOSE (`(.+)`), so "Stage 1",
    "Tera" and "Evolution" still reach this lookup and still MISS it — they are not
    types, they fall through to null, and they stay LOUD. That is what makes the
    map, and not the regex, the vocabulary. */
const CLAUSE_POKEMON_TYPES: ReadonlyMap<string, PokemonType> = new Map([
  ...POKEMON_TYPES.map((type) => [type, type] as [string, PokemonType]),
  ...Object.entries(POKEMON_TYPE_BY_CODE).map(
    ([code, type]) => [`{${code}}`, type] as [string, PokemonType],
  ),
]);

/** 🆕 D370 — the family's THIRD parameterised clause, and the FIRST that reads a
    type on a variable-size set: "If you have any <type> Pokémon on your Bench,
    this attack does N more damage." — **2 legal printings**, printed `{M}`.

    ⚠️ **ZERO NEW VOCABULARY.** It shares `CLAUSE_POKEMON_TYPES` with the pattern
    directly above rather than carrying its own map, for the reason
    `deriveAttackBonusConsequent` shares `CONDITIONAL_DAMAGE_CLAUSES`: a token
    meaning "Metal" in one clause of this family must mean Metal in every other
    one. That sharing is also what makes the round trip work across NOTATIONS —
    `conditionNote` spells the prose name (D118's rule: a brace code is a card-face
    glyph and a tooltip is read by a person), and the re-derived sentence lands on
    the same member through the map's OTHER half, which D367 added.

    ⚠️ **THE TRAP IS THE SAME SENTENCE ONE TOKEN OVER.** *"you have any Tera
    Pokémon on your Bench"* is in the corpus at 1 legal printing and `Tera` is not
    a `Card.types` value (D207). The capture is deliberately loose so the refusal
    happens at the MAP: `Tera` misses, the clause falls through to null, and the
    sentence stays LOUD. A `(Grass|Fire|…)` alternation here would refuse it at the
    anchor instead — the same answer today, and a hand-kept list that rots the day
    a type is added to the schema.

    The printed word is "any", so the predicate is EXISTENTIAL: an empty Bench is
    false because an existential over an empty set cannot be true, not because a
    convention was chosen (D369's distinction). */
const YOUR_BENCH_TYPE_CLAUSE = /^you have any (.+) Pokémon on your Bench$/;

/** 🆕 D371 — the family's FOURTH parameterised clause, and the first that reads a
    printed DEFENSIVE column rather than an identity one: "If your opponent's
    Active Pokémon has <type> Resistance, this attack does N more damage." —
    **2 legal printings**, printed `{F}`.

    ⚠️ **ZERO NEW VOCABULARY.** It shares `CLAUSE_POKEMON_TYPES` with the two
    patterns above for their reason verbatim: a token meaning "Fighting" in one
    clause of this family must mean Fighting in every other one, and the sharing is
    what makes the note's round trip work ACROSS NOTATIONS — the card prints `{F}`,
    `conditionNote` answers `Fighting` (D118), and the re-derived sentence lands on
    the same member through the map's spelled-out half.

    ⚠️ **THE APOSTROPHE CLASS IS `['’]`, NOT `'`** — D136's hardening, carried in
    this pattern's own source exactly as `OPPONENT_ACTIVE_TYPE_CLAUSE` carries it
    six lines up. The clause spells a possessive, the pool holds zero U+2019 today,
    and a catalog re-ingest that normalised the punctuation would otherwise
    un-derive both printings silently. The template pass is handed the RAW clause
    (see `literalClauseRow`), so the class is the only thing standing here.

    ⚠️ THE CAPTURE IS LOOSE (`(.+)`) for the reason the two patterns above are:
    the MAP is the vocabulary and not the regex. "Fighting-type", "Colorless" as a
    printed Resistance token that no schema value spells, or any future banner
    reach this lookup and MISS it, so the sentence falls through to null and stays
    on the loud `ATTACK_EFFECT_SKIPPED` path. */
const OPPONENT_ACTIVE_RESISTANCE_CLAUSE =
  /^your opponent['’]s Active Pokémon has (.+) Resistance$/;

/** 🆕 D390 — the family's FIFTH parameterised clause, and the first that reads a
    type over an OPPONENT'S WHOLE BOARD: "If your opponent has any <type> Pokémon
    in play, this attack does N more damage." — **1 legal printing**, printed
    `{W}` (Electivire `sv05-054` "Short-Circuit Knuckle", {C}{C}, `40+`).

    ⚠️ **ZERO NEW VOCABULARY.** It shares `CLAUSE_POKEMON_TYPES` with the three
    patterns above for their reason verbatim: a token meaning "Water" in one clause
    of this family must mean Water in every other one, and the sharing is what makes
    the note's round trip work ACROSS NOTATIONS — the card prints `{W}`,
    `conditionNote` answers `Water` (D118), and the re-derived sentence lands on the
    same member through the map's spelled-out half.

    ⚠️ **NO APOSTROPHE CLASS, AND THAT IS THE CHARACTER THAT DECIDES.** The two
    patterns above spell a POSSESSIVE ("your opponent's Active Pokémon") and carry
    D136's `['’]` because a re-ingest normalising the punctuation would un-derive
    them silently. This clause spells "your opponent **has**" and holds no
    apostrophe at all, so there is nothing to class — the same split
    `clauseApostrophe.test.ts` keeps measuring between the ZONE readings and the
    Active-Pokémon ones.

    ⚠️ THE CAPTURE IS LOOSE (`(.+)`) for the reason the three patterns above are:
    the MAP is the vocabulary and not the regex. The trap is PRINTED and sits one
    token away — *"your opponent has any Future Pokémon in play"* (Slither Wing
    `sv06.5-026`, 1 legal printing) is byte-identical apart from the token, and
    `Future` is a banner no ingested column classifies (D204/D205). It reaches this
    lookup, MISSES it, falls through to null and stays LOUD, which is the whole
    reason the alternation is not hand-kept.

    🛑 AND IT IS THE FIFTH ANCHORED PATTERN, WHICH MADE THE APPEND-LAST CLAIM WORTH
    EXECUTING RATHER THAN RESTATING — see `boardConditionForClause` below and
    `clauseTemplateAnchors.test.ts`, which was written at the PREVIOUS head, with
    this pattern's shape carried as an unbuilt row, so the guard is older than the
    thing it guards. */
const OPPONENT_IN_PLAY_TYPE_CLAUSE = /^your opponent has any (.+) Pokémon in play$/;

/** THE APOSTROPHE FOLD (D137) — the LITERAL-TABLE half of the hardening D136 gave
    the regexes, and the ONE site every exact lookup on printed text goes through.

    D136 gave three patterns the `['’]` class that every sibling reading the same
    noun phrase already carried, so a catalog re-ingest normalising straight
    apostrophes to U+2019 could not silently un-derive their sentences. The
    LITERAL tables carry the identical exposure — SEVEN of their twenty-one rows
    spell a possessive or a contraction ("your opponent's Active Pokémon is
    Poisoned", "this Pokémon didn't move from the Bench to the Active Spot this
    turn", and five more) — and a Map key CANNOT carry a character class: it is
    one exact string of bytes or it is nothing. So the hardening has to move off
    the KEY and onto the LOOKUP, which is this function.

    THE FOLD IS A FALLBACK, NOT A NORMALISATION PASS. The clause as printed is
    tried FIRST and always wins; only when that misses is U+2019 folded to U+0027
    and the table asked a second time. That ordering is what makes the change
    provably conservative — it can turn a MISS into a hit and can never turn a hit
    into a DIFFERENT hit, so no clause any row already owns is re-interpreted —
    and it leaves a future row keyed with a curly apostrophe reachable by its own
    bytes rather than shadowed by the fold.

    IT FOLDS THE APOSTROPHE AND NOTHING ELSE. No lowercasing, no trimming beyond
    what the readers already do, and emphatically no Unicode normalisation of the
    é in `Pokémon`: the tables' own doc blocks commit to a REAL U+00E9 and to a
    matcher with no /i, and those commitments are load-bearing (`Poisoned`,
    `Special Condition`, `Benched`, `Active` and `Evolution` are CAPITALISED as
    printed and told apart from ordinary words by nothing else). A wider fold
    would be a different and much larger design call, because it would owe a
    row-by-row argument that no two distinct printed clauses COLLIDE under it. The
    apostrophe needs no such survey: U+2019 and U+0027 are the same punctuation
    mark in two encodings, no printed clause in the pool is distinguished from
    another by which one it uses, and the pool holds zero U+2019 today —
    re-verified against the local D1 at D137, 0 of 978 rows in `effect`,
    `attacks_json`, `abilities_json` and `name`, against 359 cards carrying the
    straight form in `attacks_json`.

    THE TEMPLATE PASS IS DELIBERATELY NOT ROUTED THROUGH HERE. The anchored
    patterns (SELF_ENERGY_ATTACHED_CLAUSE, OPPONENT_ACTIVE_TYPE_CLAUSE and every
    skeleton above them) carry `['’]` in their own source and match the RAW
    clause. Folding before them would be harmless but redundant; folding INSTEAD
    of the class would move a documented, greppable property of each regex into a
    caller the regex cannot see. Two mechanisms, one per pass, each visible at the
    site where it applies. What reaches THIS function out of a template is the
    CAPTURE — an energy token, a type name — which is why the two token maps are
    routed through it as well even though their closed, schema-derived
    vocabularies can never hold an apostrophe: the rule is "every exact lookup on
    printed text", not "every exact lookup that needs it today", so a table added
    by a later slice INHERITS the hardening instead of having to remember it.

    Four tables, five call sites, and that is the whole census. The only exact
    lookup on printed text that does not come through here is
    `deriveAttackEffect`'s ENERGY_TYPE_BY_CODE / ENERGY_TYPE_BY_NAME pair, which
    are `Record`s rather than Maps and are indexed with a capture from
    TYPED_SELF_DISCARD — a regex whose alternation IS those two key sets, so an
    apostrophe cannot reach them by construction. */
const CURLY_APOSTROPHE = "’";
const STRAIGHT_APOSTROPHE = "'";
/** D154 — the SAME fold, applied to a CAPTURE rather than to a table lookup, and
    exported because the site that consumes the capture is in another file.

    ⚠️ THE THIRD PLACE THE APOSTHROPE RULE LIVES, AND THE FIRST WHERE THE PRINTED
    TEXT IS THE VALUE RATHER THAN THE KEY. D136/D137 built two mechanisms: `['’]`
    inside every anchored pattern (the sentence's own punctuation) and
    `literalClauseRow` below (an exact lookup in a table). `preventAttackUse`
    (D154) captures an attack's NAME out of the sentence and carries it in the op —
    so the punctuation now travels INTO a derived value, and D137's contract ("the
    two spellings must produce the SAME value, never merely a non-null one") is
    only true if the capture is normalised. Greedent ex sv03-179's "Slip 'n' Roll"
    is the one printing in the pool that makes the difference visible: under a
    punctuation-normalising re-ingest the sentence and the attack's own `name`
    would BOTH curl, so the op must fold and so must the site that matches it
    against the card (interpreter.ts). Folding one and not the other is the
    half-fix D137 warned about, wearing a proper noun.

    The catalog prints ZERO curly apostrophes today (re-verified at D154 against
    the local D1: 0 of 978 rows across `effect`, `attacks_json` and
    `abilities_json`), so this is the same standing insurance the class is — and
    `clauseApostrophe.test.ts` drives it on the one sentence that can show it. */
export function foldApostrophes(text: string): string {
  return text.includes(CURLY_APOSTROPHE)
    ? text.replaceAll(CURLY_APOSTROPHE, STRAIGHT_APOSTROPHE)
    : text;
}
function literalClauseRow<T>(table: ReadonlyMap<string, T>, clause: string): T | undefined {
  const exact = table.get(clause);
  if (exact !== undefined) return exact;
  // The `includes` guard is not an optimisation: it states that the second lookup
  // exists ONLY for text carrying a curly apostrophe, so a clause that misses for
  // any other reason misses exactly once and stays LOUD.
  return clause.includes(CURLY_APOSTROPHE)
    ? table.get(clause.replaceAll(CURLY_APOSTROPHE, STRAIGHT_APOSTROPHE))
    : undefined;
}

/** The printed clause between the leading "If " and the ", this attack does" →
    a `BoardCondition`, or null when nothing claims it (which keeps the sentence
    on the loud ATTACK_EFFECT_SKIPPED path — never a silent 0).

    Two passes, in this order and no other: the LITERAL table first, then the
    parameterised patterns. Literals win by construction, so adding a template
    can never re-interpret a clause a row already owns.

    Every exact lookup below goes through `literalClauseRow` (D137), which retries
    a miss with U+2019 folded to U+0027 — the literal-table equivalent of the
    `['’]` class the two patterns carry in their own source. The patterns
    themselves are handed the RAW clause on purpose; see that function. */
function boardConditionForClause(clause: string): BoardCondition | null {
  const literal = literalClauseRow(CONDITIONAL_DAMAGE_CLAUSES, clause);
  if (literal !== undefined) return literal;
  const selfEnergy = SELF_ENERGY_ATTACHED_CLAUSE.exec(clause);
  if (selfEnergy !== null) {
    const energy = literalClauseRow(CLAUSE_ENERGY_TOKENS, selfEnergy[1] ?? "");
    if (energy !== undefined) return { kind: "yourActiveHasEnergyAttached", energy };
  }
  const activeType = OPPONENT_ACTIVE_TYPE_CLAUSE.exec(clause);
  if (activeType !== null) {
    const type = literalClauseRow(CLAUSE_POKEMON_TYPES, activeType[1] ?? "");
    if (type !== undefined) return { kind: "opponentActiveHasType", type };
  }
  // 🆕 D370 — the same lookup on the same map, one zone and one seat over. It is
  // LAST because the three patterns are mutually exclusive at their anchors and
  // order therefore decides nothing here; adding it at the end keeps that true by
  // construction, since a pattern that could claim a clause an earlier one owns
  // would have to share its anchor and none of these do.
  const benchType = YOUR_BENCH_TYPE_CLAUSE.exec(clause);
  if (benchType !== null) {
    const type = literalClauseRow(CLAUSE_POKEMON_TYPES, benchType[1] ?? "");
    if (type !== undefined) return { kind: "yourBenchHasType", type };
  }
  // 🆕 D371 — the same lookup on the same map, one COLUMN over: this one reads the
  // opponent's Active Pokémon's printed Resistance rather than its type. Appended
  // LAST for D370's reason, still true at four patterns: they are mutually
                                                                               
                                                                                   
                                     
  const activeResistance = OPPONENT_ACTIVE_RESISTANCE_CLAUSE.exec(clause);
  if (activeResistance !== null) {
    const type = literalClauseRow(CLAUSE_POKEMON_TYPES, activeResistance[1] ?? "");
    if (type !== undefined) return { kind: "opponentActiveHasResistance", type };
  }
                                                                                 
                                                                                    
                                                                                  
                                                                                   
                                                                                  
                                                                                  
                                                                                 
                                                                                   
                                                                                   
                                                                            
                                                                                
                                                                             
                                                                             
  const inPlayType = OPPONENT_IN_PLAY_TYPE_CLAUSE.exec(clause);
  if (inPlayType !== null) {
    const type = literalClauseRow(CLAUSE_POKEMON_TYPES, inPlayType[1] ?? "");
    if (type !== undefined) return { kind: "opponentInPlayHasType", type };
  }
  return null;
}

                                                                                 
                                                                                 
                                                                              
  
                                                                                
                                                                      
                                                                                
                                                                               
                                                                                
                                                                               
                      
                                                                                 
                                                                                
                                                                            
                                                                            
                                                                                  
                                                                                
                                                                                
                                                                               
                                                                                        
                                                                           
                                                                             
                                                                               
                                                                                 
                                        
  
                                                                               
                                                                           
                                                                           
                                                                                  
                                                                     
                                                                            
                                                                             
                                                                                
                                                                                 
                                                                                
                                                                                           
                                                                                 
                                                                                 
                                                                  
  
                                                                              
                                                                                  
                                                                                 
                                                                                
                                                                              
                                                                            
                                                                                  
                                                                                
                                                               
  
                                                                              
                                                                              
                                                                                  
                                                                              
                                                                                 
  
                                                                         
                                                                                 
  
                                                                                 
                                                                             
                                                                                
                                                                         
                                                                           
                                                                             
                                                                               
                                                                             
                                                                                   
                                     
  
                                                                                
                                                                        
                                                                            
                                                                            
                                                                                  
                                                                              
                                                                                 
                                                                              
                                                                         
                                        
  
                                                                              
                                          
                                                                                   
                                                                                
                                                                             
                                                                               
                                                                                   
                                                                         
                                                                               
                                                                       
                                                                                
                                                                              
                                                                                
                                                                                 
                                                                              
                                                                   
const ATTACK_DOES_NOTHING = /^If (.+?), this attack does nothing\.(?: (.+))?$/;
                                                                             
                                                                                 
                                                                                 
                                                                     

                                                                                 
                                                                               
                                                                                  
                                                                
                                                                            
                                                                                 
                                                                                   
                                                                                  
                                                                       
                                                                                   
                                                                                 
                                                                                
                                                                         
                                                                       
                                                                                   
                                                                                   
                                                                                 
                                                                             
                                                                              
                                                                    

                                                                                
                                                                                 
                                                                             
                                                                                  
                                                                               
                                                                            
                                                                                
                                                                                 
                                                                                
                                                                                   
                                                                                   
                                                                                   
                                                                                   
                                                                               
                  
                                                                                
                                                                              
                                                                                  
                                                                                   
                                                                        
                
const ATTACK_REQUIREMENT_CLAUSES = new Map<string, BoardCondition>([
                                                                                 
                                                                                    
                                                                                 
                                                                         
    
                                                                             
                                                                            
                                                                           
                                                                                 
                                                                             
                                                                             
                                                                                
                                                                               
                                              
  [
    "this Pokémon didn't move from the Bench to the Active Spot this turn",
    { kind: "yourActivePromotedThisTurn" },
  ],
                                                                     
                                                                                
                                                                              
                                                                                
                                                                                 
                                                                              
                                                                                
                                                                                 
                                                            
    
                                                                              
                                                                                 
                                                                            
                                                                          
                                                                                
                                                                                
                                                                             
                                           
  [
    "your opponent's Active Pokémon has no damage counters on it before this attack does damage",
    { kind: "opponentActiveDamaged" },
  ],
                                                                         
                                                                               
                                                                                 
                                                                                
                                                                               
                                                                               
                                                                                
                                        
    
                                                                                 
                                                                                
                                                                                  
                                                                                  
                                                                             
    
                                                                            
                                                                                
                                                                                
                                                                                
                                                                              
  [
    "your opponent's Active Pokémon isn't a Pokémon ex",
    { kind: "opponentActiveIsEx" },
  ],
                                                                                  
                                                                          
                                                                                  
                                                                       
                                                               
    
                                                                               
                                                                                  
                                                                                  
                                                                                 
                                                                                 
                                                                         
                                                                                 
                         
  [
    "you don't have the same number of cards in your hand as your opponent",
    { kind: "handSizesEqual" },
  ],
                                                                                 
                                                                            
                                                                                   
                                                              
    
                                                                               
                                                                                   
                                                                                   
                                                                                 
                                                                                
                                                                           
                                                                             
                                                                           
    
                                                                                
                                                                                
                                                                                 
                        
  [
    "your opponent doesn't have exactly 3 or 4 Prize cards remaining",
    { kind: "opponentPrizesRemaining", counts: [3, 4] },
  ],
                                                                                
                                                                            
                                                                          
                                                                                   
                                                             
    
                                                                               
                                                                                
                                                                                  
                                                                                  
                                                                                
                                                                                
                                                                       
    
                                                                                  
                                                                            
                                                                                  
                                                                                  
                                              
    
                                                                                
                                                                                   
                                                                        
                                                                               
                                                                                
                                                               
    
                                                                                   
                                                                                  
                                                                                 
                                                                                  
                                                                  
  [
    "you don't have Uxie and Azelf on your Bench",
    {
      kind: "allOf",
      conditions: [
        { kind: "yourBenchHasNamed", name: "Uxie" },
        { kind: "yourBenchHasNamed", name: "Azelf" },
      ],
    },
  ],
                                                                          
                                                                                  
                                                                                  
                                                                                  
                                                          
    
                                                                                
                                                                              
                                                                                   
                                                                                   
                                                                                 
    
                                                                             
                                                                     
                                                                              
                                                                                  
                                                      
    
                                                                                  
                                                                                   
                                                                          
  ["you have 4 or fewer Benched Pokémon", { kind: "yourBenchAtLeast", count: 5 }],
                                                                                
                                                                                
                                                                              
                                                                            
                                                                               
                                                                                   
                  
    
                                                                                 
                                                                            
                                                                                   
          
    
                                                                                
                                                                                
                                                                   
    
                                                                             
                                                                                
                                                                                
                                                                           
  ["your opponent's Active Pokémon isn't Burned", { kind: "opponentActiveBurned" }],
                                                                               
                                                                                
                                                                                     
                                                                            
                                                                                 
                                                                                   
                                                                        
    
                                                                                     
                                                                                    
                                                                                 
                           
    
                                                                               
                                                                                    
                                                                                 
                                        
    
                                                                                  
                                                          
  ["there is no Stadium in play", { kind: "stadiumInPlay" }],
                                                                               
                                                                                 
                                                                                  
                                                                            
                                                                    
    
                                                                               
                                                                                
                                                                                
                                                                              
                                                                                
                                                                                 
           
    
                                                                             
                                                                              
                                                                               
                                                                                 
                                                                                 
    
                                                                                
                                                                                   
                                                                                
                    
  ["you don't have exactly 3 cards in your hand", { kind: "yourHandExactly", count: 3 }],
]);

                                                                               
                                                                               
                                                                  

                                                                              
                                                                               
                                                                             
                                                                                
                                                                         
                               

                                                                            
                                                                              
                                                                                
                                                                                  
                                                                                 
                                                                           
export function deriveAttackRequirement(text: string): BoardCondition | null {
  const nothing = ATTACK_DOES_NOTHING.exec(text.trim());
  if (nothing === null) return null;
  return literalClauseRow(ATTACK_REQUIREMENT_CLAUSES, nothing[1] ?? "") ?? null;
}

                                                                         
                                                                           
                                                                                 
                                                            

                                                                               
                                                                               
                                                                          
                                                                                  
                                                                            
                                                                           
                                                                                  
                                                                                  
                                                                                  
                                                                                  
                                                   

                                                                             
                                                                                  
                                                                                
                                                                                  
                                                     

                                                                            
                                                                         
                                                                                       
                                                                                  
                                                                                 
                                                                                  
                                                                                 
                                                                                  
                                                                                
                      

                                                                            
                                                                                 
                                
export function splitAttackRequirementClause(
  text: string,
): { clause: string; body: string } | null {
  const trimmed = text.trim();
  const nothing = ATTACK_DOES_NOTHING.exec(trimmed);
  if (nothing === null) return null;
  const body = (nothing[2] ?? "").trim();
                                                                                
                                                                                 
                                                                    
  if (body === "") return null;
                                                                                 
                                                                              
                                                        
  if (literalClauseRow(ATTACK_REQUIREMENT_CLAUSES, nothing[1] ?? "") === undefined) return null;
  return { clause: `If ${nothing[1] ?? ""}, this attack does nothing.`, body };
}

                                                                                 
                                                                             
                                                                              
                                                  
  
                                                                          
                                                                                 
                                                                               
                                                                                       
  
                                                                                
                                                                                      
                                                                                    
                                                                                    
                                                                                      
                                                                                     
                                                                                      
                                                                                
                                                                              
                                 
  
                                                                                     
                                                                                  
                                                                                      
                                                                                     
                                                                                
                              
  
                                                                                    
                                                                                 
                                                                                     
                                                      
                                                                                  
                                                                                   
                                                                                     
                                                 
                                                                               
const ENERGY_CODES = Object.keys(ENERGY_TYPE_BY_CODE).join("");
const HAND_BASIC_ENERGY_COST = new RegExp(
  `^Discard (?:(  d+) Basic   {([${ENERGY_CODES}])  } Energy cards|(a) Basic   {([${ENERGY_CODES}])  } Energy card) from your hand  .$`,
);
const HAND_BASIC_ENERGY_COST_KO = new RegExp(
  `^Discard (  d+) Basic   {([${ENERGY_CODES}])  } Energy cards from your hand, and Knock Out your opponent['’]s Active Pokémon  .$`,
);

                                                                           
                                                                               
                                                                                 
                               
  
                                                        
                                                                                                   
                              
                                                                                                                        
  
                                                                                 
                                                                                
                                                                                   
                                                                                    
                                                                              
                                                                                   
  
                                                                              
                                                                               
                                                                                   
                                                                          
                                                                          
                                                                              
                                                                                   
                                 
  
                                                                                
                                                     
  
                                                                                  
                                                                                     
                                                                                
                                                                                    
                                                                
  
                                                                                     
                                                                                    
                                                                                  
                                                                                      
                                                                                    
                                                                                      
                                                                                      
                                                                                            
                                                                                    
                                         
  
                                                                               
                                                                                   
                                                                                  
                                                                                 
  
                                                                                    
                                 
                                                                                     
                                                                                    
                                                                                     
                                                                                      
                                                                                   
                                                                        
                                                                                   
                                                                                      
                                                                                     
                                                                                      
                        
  
                                                                                  
                                                                               
                                                             
                                                                                 
                                                                              
  
                                                                                   
                                                                                  
                                                                               
                                                                                  
             
const ATTACK_CANCEL_TRAILING =
  /^(.+\.) (If you can['’]t(?: discard   + cards in this way)?, this attack does nothing  )$/;

/** 🆕🆕 D417 — the printed HEAD SENTENCE an anaphoric *"If you can't,"* points
    back at → the POSITIVE board fact that head's action REQUIRES.

    🛑 **KEYED ON THE HEAD AND NOT ON THE CLAUSE, AND THE ANAPHOR FORCES IT.** The
    clause is byte-identical on every printing of this family — it carries no
    referent of its own, which is what "anaphoric" means — so a table keyed on it
    could hold exactly ONE row and would answer every member of the family with
    that row's condition. *"If you can't,"* means **a Stadium is in play** behind
    Eternatus's discard and **a Basic {G} Energy card in hand** behind Ogerpon's.
    The referent IS the head, so the head is the key.

    ⚠️ 🆕🆕 **D420 — HEAD-KEYING SURVIVES THE WIDENED ANCHOR, AND D417's OWN STATED
    REASON FOR DOUBTING IT DISSOLVES.** The anchor now also admits the NAMED-REFERENT
    spelling *"If you can't discard 6 cards in this way,"*, so the clause is no longer
    byte-identical across the family and the sentence above is scoped to the BARE
    form. That does not move the key: the named clause restates **only the COUNT**,
    never the FILTER and never the ZONE — *"6 cards"*, not *"6 Basic {G} Energy cards
    from your hand"* — and *"in this way"* is the phrase that sends the manner back to
    the head. So the head is still the whole referent for every board fact, and the
    one thing the clause repeats is guarded against the key it repeats (§2 of
    `handEnergyCancel.test.ts`).

    ⚠️ **THAT IS ALSO WHAT MAKES A SECOND MEMBER COST A ROW AND NOTHING ELSE.**
    D380's bar: *"a split built for one card serves one card, and it must be
    GENERAL OVER ITS BODY the way `splitAttackRequirementClause` is general over
    its leading one."* The anchor, the splitter, the reader and the site are all
    blind to WHICH head is printed; the only card-specific byte in this slice is
    the key below.

    🛑🛑 **D420 — THE NEXT SENTENCE OF THIS BLOCK WAS FALSE WHEN D417 WROTE IT, AND
    IT IS A TRAP. IT IS LEFT VISIBLE AND MARKED AS A CORRECTION (D178) RATHER THAN
    DELETED.** It read:

        *"A successor who wants Ogerpon adds
        `["Discard a Basic {G} Energy card from your hand.", { kind: … }]` and stops —
        no anchor, no arm, no branch at the site."*

    **THAT SENTENCE IS TRUE ONLY BECAUSE ETERNATUS'S HEAD WAS ALREADY CLAIMED BY
    `deriveAttackEffect` (`discardStadium`, D380). OGERPON'S WAS NOT.** A row ALONE
    makes `resolvedByAnyReader` answer TRUE for the printing — the reader surface
    includes `deriveAttackCancelRequirement`, so `BUILT.attack` STEPS — while the
    attack itself still falls to the loud `ATTACK_EFFECT_SKIPPED` path, because
    `attack.ts` re-runs the readers over the SPLIT HEAD and no reader claims it. That
    is a census inflation with no behaviour behind it: D407's **"built but dead"**, and
    the ONE failure mode this table can produce silently.

    ✅ **THE CORRECTED RULE.** A row costs a row and nothing else **iff the head it
    keys is a sentence some reader already claims**. Otherwise the row and an
    `deriveAttackEffect` ARM are ONE decision and must land together — which is exactly
    what D420 does for all three of its heads, and which is why `effectSimulated`'s
    `cancelSplit === null` conjunct (attack.ts) exists: it is the term that keeps an
    unclaimed head LOUD instead of letting the requirement vouch for it.

    ⚠️ **AND D420 DOES NOT MAKE THAT CONJUNCT LIVE — IT MAKES IT UNNECESSARY AGAIN,
    WHICH IS THE CORRECTED RULE BEING OBEYED RATHER THAN TESTED.** All four heads in
    this table are now claimed by `deriveAttackEffect`, so `cancelSplit !== null` still
    IMPLIES `program !== null` and removing the conjunct would still move no assertion
    in the repo. It stays written from the RULE (D130/D205), and the row that would
    drive it is exactly the row this correction forbids.

    A `Map` for `CONDITIONAL_DAMAGE_CLAUSES`' reason: arbitrary printed text must
    not reach `Object.prototype`. Read through `literalClauseRow` (D137) like every
    other exact lookup in this file, so a U+2019 reprint of a key folds — this
    key spells no apostrophe and no é, so the fold is inert on it today and live
    the moment a row needs it.

    ⚠️ Deliberately shares no lookup with `ATTACK_REQUIREMENT_CLAUSES`: that table
    is keyed on a printed NEGATIVE clause under a leading consequent, this one on a
    printed IMPERATIVE SENTENCE under a trailing one. Two shapes, two vocabularies,
    one helper (D137's rule). */
const ATTACK_CANCEL_HEADS = new Map<string, BoardCondition>([
  // 🆕🆕 D417 — Eternatus `sv08-141` "World Ender" ({R}{D}{D}, 230), **1 legal
  // printing**. `discardStadium` (D380) already reads this head as a program and
  // `stadiumInPlay` (D378) already answers it as a board fact, so this row buys
  // NEITHER an op NOR a `BoardCondition` member — it buys the JOIN between the
  // two, which is the anaphor's whole content.
    
                                                                               
                                                                                
                                                                       
  ["Discard a Stadium in play.", { kind: "stadiumInPlay" }],
                                                                                  
                                                                                  
    
                                                                                
                                                                                
                                                                                    
                                                                                    
                                  
    
                                                                                     
                                                                                     
                                                                                    
                                                                                      
                                                                               
    
                                                                                  
                                                                              
                                                                                       
  [
    "Discard 6 Basic {G} Energy cards from your hand, and Knock Out your opponent's Active Pokémon.",
    { kind: "yourBasicEnergyInHandAtLeast", energy: "Grass", count: 6 },
  ],
  [
    "Discard 2 Basic {G} Energy cards from your hand.",
    { kind: "yourBasicEnergyInHandAtLeast", energy: "Grass", count: 2 },
  ],
  [
    "Discard a Basic {G} Energy card from your hand.",
    { kind: "yourBasicEnergyInHandAtLeast", energy: "Grass", count: 1 },
  ],
]);

                                                                                 
                                                                                     
                                                                            
                                          

                                                                         
                                                                                    
                                                                                  
                                                       
export function attackCancelHeadRows(): readonly (readonly [string, BoardCondition])[] {
  return [...ATTACK_CANCEL_HEADS];
}

                                                                          
                                                                                 
                                                                                  
                                                                                   
                                               

                                                                             
                                                                                  
                                                                                 
                                                                                  
                                                                           
                                                                             
                                                                             
                                                                   

                                                                                   
                                                                                   
                                                                       

                                                                                  
                                                                                
                                                                             
                                                                                   
                                                                                   
                                                                                 
                                                                                   
                                                                               
                                  

                                                                               
                                                                                  
                                          
export function splitAttackCancelClause(
  text: string,
): { head: string; clause: string } | null {
  const trimmed = text.trim();
  const cancel = ATTACK_CANCEL_TRAILING.exec(trimmed);
  if (cancel === null) return null;
  const head = (cancel[1] ?? "").trim();
                                                                                 
                                                                            
                                                                                
                                             
  if (head === "") return null;
                                                                                
                                                   
  if (literalClauseRow(ATTACK_CANCEL_HEADS, head) === undefined) return null;
  return { head, clause: cancel[2] ?? "" };
}

                                                                             
                                                                                   
                                                                                
                  

                                                                              
                                                                                   
                                                                        

                                                                                 
                                                                                
                                                                             
                                                                                   
                                                           
export function deriveAttackCancelRequirement(text: string): BoardCondition | null {
  const split = splitAttackCancelClause(text);
  if (split === null) return null;
  return literalClauseRow(ATTACK_CANCEL_HEADS, split.head) ?? null;
}

                                                                                 
                                                                                 
                                                                                 
                                                                                
                                                                                  
                                                                                  
  
                                                                                
                                                                              
                                                                      
                                                                                 
                                                                                
                                                                
                                                                                 
                                                                                
                                                                       
  
                                                                                
                                                                            
                                                                             
                                                                      
  
                                                                               
                                                                             
                                                                               
                   
                                                                                  
                                                                         
                                                       
                                                                                 
                                                                              
                                            
                                                                                   
                                                                                 
                                                                                
                                                                                     
                                                                                 
                                                                                 
                                                                               
          
const ATTACK_COIN_BONUS = /^Flip a coin\. If heads, this attack does (\d+) more damage\.$/;
const ATTACK_COIN_CANCEL = /^Flip a coin\. If tails, this attack does nothing\.$/;
                                                                                   
                                                                                   
                                                                                     
                                                                                 
                                                                                  
                                                                                   
                                                                                     
                                                                                  
                                                                                    
                                                                               
                                                  
  
                                                                                 
                                                                                      
                                                                                       
                                                                                       
                                                                                    
                                                                                      
                                                                                   
                                                                              
                                                                              
                                                                                     
                                                                                     
                                                                         
  
                                                                                
                                                                                  
                                                                               
                                                                               
                                                                                  
                                                                                  
                                                                                  
                                                                                
                                                                                  
                                                                      
const ATTACK_COIN_CANCEL_THEN_PREVENT =
  /^Flip a coin\. If tails, this attack does nothing\. If heads, during your opponent['’]s next turn, prevent all damage from and effects of attacks done to this Pokémon  $/;

// The MULTI-FLIP COUNT FOLD (D127) — "Flip N coins. This attack does D damage for
// each heads." — 22 printings on ONE regex, N ∈ {2 (12 prints), 3 (9), 4 (1)},
// D ∈ {10, 20, 30, 40, 50, 60, 70, 80, 100}. The SAME seam D126 built, with a
// bounded LOOP where D126 took a single draw, and it needs neither a new event nor
// a new site: N flips are announced as N `ATTACK_EFFECT_COIN_FLIP` rows in order
// (the event already carries exactly one `CoinFace`, so a sequence of them is the
// only reading that does not invent an aggregate the wire cannot express).
//
// IT IS A MULTIPLY PRINTING, NOT AN ADDITIVE ONE. Every one of the 22 carries a
// printed "D×" damage marker whose digits ARE the per-heads D — so `attack.ts`
// must DROP the printed base exactly as it does for `deriveAttackDamageMultiplier`,
// or a 2-heads "30×" Double Hit would deal 30 + 60 instead of 60. The word that
// tells the two families apart is "more", and the pool's two "more" variants are
                                                                                 
                                                                               
                                                                                  
                                                                         
  
                                                                                 
                                                                              
                                                                                   
                                                                    
  
                                                                                  
                                                                                   
                                                                               
                                                                               
                                                                            
                                                                     
const ATTACK_COIN_MULTI = /^Flip (\d+) coins\. This attack does (\d+) damage for each heads\.$/;

                                                                              
                                                                      
                                                                         
                                                                            
  
                                                                                
                                                                                 
                                                                                   
                                                                                
                                                                                
                                                                             
                                                                                    
                                                                                   
                                                                                   
                                                                        
  
                                                                                    
                                                                                    
                                                                          
                                                                                  
                                                               
const ATTACK_COIN_MULTI_BONUS =
  /^Flip (\d+) coins\. This attack does (\d+) more damage for each heads\.$/;

                                                                         
                                                                                   
                                                                                  
                                                                                   
                                             
                                                                              
                                                               
                                                                               
                                                               
                                                                                
                                                                   
  
                                                                            
                                                                                    
                                                                                      
                                                                                     
                                                                                   
                                                                           
                                                                                   
                                                                           
  
                                                                                   
                                                                                    
                                                                                   
                                                                                    
                                    
  
                                                                                 
                                                                                     
                                                                             
                                                                                      
                                                                                   
                                                                                    
                                                                                     
                               
  
                                                                                     
                                                                                  
                                                                                 
                                                                                     
                                                                                 
                                                                                
                                                                           
  
                                                                                    
                                                                                    
                                                                                
                                                                                     
                                                                                     
                                                                
const ATTACK_COIN_MULTI_THRESHOLD_STATUS = new RegExp(
  `^Flip (  d+) coins  . This attack does (  d+) damage for each heads  . If (?:(either|both)|at least (  d+)) of them (?:is|are) (heads|tails),  s+your opponent['’]s Active Pokémon is now (${STATUS_WORDS})  .$`,
);

                                                                                    
                                                                                       
                                                                                   
                                                                                 
                              
const FLIP_THRESHOLD_WORDS: Record<string, number> = { either: 1, both: 2 };

                                                                                    
                                                                                 
                                                                                   
                                                                                          
                                                                                   
                                                                               
                                                                                    
                                                                                 
                                                                                    
                                                                                   
  
                                                                                   
                                                                                  
                                                                                    
                                                                                  
                                                         
  
                                                                                   
                                                                                   
                                                                                  
                                                                                 
                                                                                 
                                                                                
                                                        
const ATTACK_COIN_PER_ENERGY =
  /^Flip a coin for each (?:(.+) )?Energy attached to this Pokémon\. This attack does (\d+) damage for each heads\.$/;

                                                                          
                                                                                         
                                                                            
                                                                                 
                                                                                   
                                                                                 
                                              
  
                                                                                    
                                                                                   
                                                       
                                                                                            
                                                                                              
                                                                                              
                                                                                              
                                                                                              
                                                                                              
                                                                                      
                                                                            
                                                                                      
                                                                                      
                                                                                 
                                                                                    
                                                                                      
                                                                                 
                       
  
                                                                           
                                                                               
                                                                                       
                                                                            
                                                                              
                                                                                    
                                                                                      
                                                                                  
                                                                                     
                                                                                   
                                                                                  
            
  
                                                                                  
                                                                                    
                                                                                 
                                                                                     
                                                                                      
                                                                                     
                                                                                   
                                                                     
const ATTACK_COIN_PER_BOTH_ACTIVES_ENERGY =
  /^Flip a coin for each Energy attached to both Active Pokémon\. This attack does (\d+) damage for each heads\.$/;

                                                                              
                                                                                  
                                                                            
                                                                               
                                                                                
                                                                                 
                                                                             
                                                                                
                                                                               
                                 
  
                                                                                  
                                                                                   
                                                                             
                                                                             
                                                                            
                                                                                  
                                                                           
                                                                             
                                                                                 
                                                                                
                                                        
  
                                                                                  
                                                                            
                                                                                
                                                                             
                                                                                  
                                                                             
                                                                               
                                                                              
                                                                             
           
  
                                                                              
                                                                    
                                                                                 
                                                                                 
                                                                                  
                                                                                   
                                                                  
                                                                             
                                                                       
                                                                          
  
                                                                                   
                                                                                    
                                                                                   
                                                                                  
  
                                                                                
                                                                         
                                                                            
                                                                               
                                                                               
                                                                            
                                                                               
                                                                                  
                                                                                  
                                                                            
                                                                                
                                             
const ATTACK_COIN_PER_BODY_IN_PLAY =
  /^Flip a coin for each ([^.]+) you have in play\. This attack does (\d+) damage for each heads\.$/;

                                                                                 
                                                                                
                                                                            
                                                                                   
                                                 
                                                                                  
                                                                              
                                                                           
                                                                                 
                                                                
                                                                              
                                                                           
  
                                                                                
                                                                                
                                                                              
                                                                                 
                                                                       
                                                                                 
                                                                             
                                                                                
                                                                     
  
                                                                                 
                                                                                 
                                                                                 
                                                                                 
                                    
  
                                                                                
                                                                            
                                                                                 
                                                                               
                                                                                
                                                                              
                                                                           
                                       
