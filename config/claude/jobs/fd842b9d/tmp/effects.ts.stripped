  readonly riders: { toSelf?: true; benchOnly?: true; targetType?: PokemonType };
  readonly anyWay: boolean;
                                                                                
                                                                                 
                                                                         
                                                                              
                                                                          
                                                             
  readonly toEach?: true;
}
