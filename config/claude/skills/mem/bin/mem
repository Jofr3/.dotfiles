/**
 * Minimal flag parser: enough for this CLI, and it *rejects* unknown options
 * rather than folding them into the memory text — `mem add use pnpm --whi ...`
 * silently storing "--whi ..." as part of the fact is exactly the kind of
 * quiet corruption a memory store must not have.
 */
function parseFlags(argv, { booleans = [], values = [] } = {}) {
  const flags = {};
  const positional = [];

  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '--') {
      positional.push(...argv.slice(i + 1));
      break;
    }
    if (!arg.startsWith('--')) {
      positional.push(arg);
      continue;
    }

    const eq = arg.indexOf('=');
    const name = eq === -1 ? arg.slice(2) : arg.slice(2, eq);

    if (booleans.includes(name)) {
      if (eq !== -1) throw new Error(`--${name} takes no value.`);
      flags[name] = true;
    } else if (values.includes(name)) {
      const value = eq === -1 ? argv[(i += 1)] : arg.slice(eq + 1);
      if (value === undefined) throw new Error(`--${name} needs a value.`);
      flags[name] = value;
    } else {
      throw new Error(`unknown option '--${name}'.`);
    }
  }

  return { flags, positional };
}

const ADD_BOOLEANS = ['global', 'project', 'pin', 'staged', 'no-dedup', 'json'];
const ADD_VALUES = [
  'why', 'kind', 'scope', 'source', 'session',
  'salience', 'confidence', 'expires-in', 'threshold', 'cwd',
];

function numberFlag(flags, name) {
  if (flags[name] === undefined) return undefined;
  const n = Number(flags[name]);
  if (!Number.isFinite(n)) throw new Error(`--${name} must be a number, got '${flags[name]}'.`);
  return n;
}

/** Turn the parsed flags into addMemory()'s input. Throws on contradictions. */
function addInput(flags, text) {
  if (flags.global && flags.project) throw new Error('--global and --project contradict each other.');
  if (flags.scope && (flags.global || flags.project)) {
    throw new Error('--scope conflicts with --global/--project — use one or the other.');
  }
  const days = numberFlag(flags, 'expires-in');
  if (days !== undefined && days <= 0) throw new Error('--expires-in must be a positive number of days.');

  return {
    text,
    why: flags.why,
    kind: flags.kind,
    scope: flags.scope ?? (flags.global ? 'global' : 'project'),
    status: flags.staged ? 'staged' : 'active',
    sourceKind: flags.source,
    sourceSession: flags.session,
    salience: numberFlag(flags, 'salience'),
    confidence: numberFlag(flags, 'confidence'),
    pinned: flags.pin === true,
    expiresAt: days === undefined ? null : Date.now() + Math.round(days * DAY_MS),
  };
}

/**
 * Store one memory. Exit 2 rather than 1 when the text was rejected as a
 * credential, so a hook or script can tell "you gave me a secret" apart from
 * "mem is broken" without parsing the message.
 */
async function add(argv) {
  const paths = resolvePaths();
  let result;
  let json = false;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: ADD_BOOLEANS, values: ADD_VALUES });
    json = flags.json === true;

    const text = positional.join(' ').trim();
    if (text === '') throw new Error('nothing to store. Usage: mem add <text> [options]');

    const threshold = numberFlag(flags, 'threshold');
    result = await addMemory(addInput(flags, text), {
      paths,
      cwd: flags.cwd,
      dedup: flags['no-dedup'] !== true,
      ...(threshold === undefined ? {} : { threshold }),
    });
  } catch (err) {
    console.error(`mem add: ${err.message}`);
    return err.code === 'MEM_SECRET_DETECTED' ? 2 : 1;
  }

  const { row, nearest, similarity, changes, action, eventId } = result;

  if (json) {
    // The embedding is 1.5 KB of float noise; the row is otherwise the memory.
    const { emb, ...rest } = row;
    const near = nearest ? { id: nearest.id, uid: nearest.uid, similarity } : null;
    console.log(JSON.stringify({ action, memory: rest, changes, similarity, nearest: near, eventId }, null, 2));
    return 0;
  }

  console.log(renderAdd(result));
  return 0;
}

const SEARCH_BOOLEANS = ['global', 'project', 'json', 'explain', 'no-gate'];
const SEARCH_VALUES = ['limit', 'threshold', 'coverage', 'status', 'cwd', 'scope'];

/**
 * Retrieve. Exits 0 with no results when nothing clears the gate — that is the
 * designed answer on an unrelated query, not a failure, and a hook that treated
 * it as one would be wrong on most prompts.
 */
async function search(argv) {
  const paths = resolvePaths();
  const now = Date.now();
  let found;
  let json = false;
  let explain = false;

  try {
    const { flags, positional } = parseFlags(argv, {
      booleans: SEARCH_BOOLEANS,
      values: SEARCH_VALUES,
    });
    json = flags.json === true;
    explain = flags.explain === true;

    const query = positional.join(' ').trim();
    if (query === '') throw new Error('nothing to search for. Usage: mem search <query> [options]');
    if (flags.global && flags.project) throw new Error('--global and --project contradict each other.');

    const limit = numberFlag(flags, 'limit');
    if (limit !== undefined && (!Number.isInteger(limit) || limit < 1)) {
      throw new Error('--limit must be a positive whole number.');
    }
    const threshold = numberFlag(flags, 'threshold');
    const coverage = numberFlag(flags, 'coverage');

    found = await searchDetail(query, {
      paths,
      cwd: flags.cwd,
      scope: flags.scope ?? (flags.global ? 'global' : 'project'),
      now,
      gate: flags['no-gate'] !== true,
      ...(flags.status ? { statuses: flags.status.split(',').map((s) => s.trim()) } : {}),
      ...(limit === undefined ? {} : { limit }),
      ...(threshold === undefined ? {} : { threshold }),
      ...(coverage === undefined ? {} : { coverage }),
    });
  } catch (err) {
    console.error(`mem search: ${err.message}`);
    return 1;
  }

  const { results, stats, terms, query } = found;

  if (json) {
    console.log(JSON.stringify({ query, terms, count: results.length, results, stats }, null, 2));
    return 0;
  }

  console.log(renderSearch(found, { now, explain }));
  return 0;
}

// ---------------------------------------------------------------- curation --
//
// list/show/forget/pin never embed anything, so they stay fast and keep working
// with no model cached. Only `import` needs the model, because it re-embeds.

/** Split a comma-separated flag into trimmed, non-empty values. */
function listFlag(value) {
  if (value === undefined) return undefined;
  const parts = value.split(',').map((s) => s.trim()).filter((s) => s !== '');
  if (parts.length === 0) throw new Error('a comma-separated list cannot be empty.');
  return parts;
}

/**
 * Which memories a command looks at. `list` and `export` differ in default
 * (see manage.mjs) but share the flags, so --global means the same thing in
 * both.
 */
function scopeFlags(flags, fallback) {
  const chosen = ['global', 'project', 'all'].filter((name) => flags[name] === true);
  if (chosen.length > 1) throw new Error(`--${chosen[0]} and --${chosen[1]} contradict each other.`);
  if (flags.global) return 'global';
  if (flags.project) return 'project-only';
  if (flags.all) return 'all';
  return fallback;
}

/** The project key, resolved only when the chosen scope actually needs it. */
function projectKeyFor(scope, flags) {
  if (scope !== 'project' && scope !== 'project-only') return null;
  return resolveProjectKey({ cwd: flags.cwd }).projectKey;
}

function pinnedFlag(flags) {
  if (flags.pinned && flags.unpinned) throw new Error('--pinned and --unpinned contradict each other.');
  if (flags.pinned) return true;
  if (flags.unpinned) return false;
  return null;
}

function positiveInt(flags, name, { min = 1 } = {}) {
  const n = numberFlag(flags, name);
  if (n === undefined) return undefined;
  if (!Number.isInteger(n) || n < min) {
    throw new Error(`--${name} must be a whole number of at least ${min}.`);
  }
  return n;
}

const LIST_BOOLEANS = ['global', 'project', 'all', 'pinned', 'unpinned', 'json'];
const LIST_VALUES = [
  'status', 'kind', 'sort', 'limit', 'offset', 'cwd', 'min-strength', 'max-strength',
];

/**
 * What is actually in the store. Unlike `search`, this hides nothing it was not
 * asked to hide — an expired or tombstoned row is listed and marked, because the
 * whole point of an inspection surface is to show what retrieval will not.
 */
async function list(argv) {
  const paths = resolvePaths();
  const now = Date.now();
  let found;
  let json = false;
  let scope;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: LIST_BOOLEANS, values: LIST_VALUES });
    if (positional.length > 0) {
      throw new Error(`unexpected argument '${positional[0]}' — did you mean 'mem search'?`);
    }
    json = flags.json === true;
    scope = scopeFlags(flags, 'project');

    found = await listMemories({
      paths,
      now,
      scope,
      projectKey: projectKeyFor(scope, flags),
      statuses: listFlag(flags.status) ?? ['active'],
      kinds: listFlag(flags.kind),
      pinned: pinnedFlag(flags),
      sort: flags.sort ?? 'updated',
      // `--max-strength 0.15 --sort strength` is how you look at what the
      // pruning ladder is about to reach, before anything automatic does.
      minStrength: numberFlag(flags, 'min-strength') ?? null,
      maxStrength: numberFlag(flags, 'max-strength') ?? null,
      limit: positiveInt(flags, 'limit') ?? 20,
      offset: positiveInt(flags, 'offset', { min: 0 }) ?? 0,
    });
  } catch (err) {
    console.error(`mem list: ${err.message}`);
    return 1;
  }

  const { rows, total } = found;

  if (json) {
    console.log(JSON.stringify({ total, count: rows.length, scope, memories: rows }, null, 2));
    return 0;
  }

  console.log(renderList({ rows, total, scope }, { now }));
  return 0;
}

async function show(argv) {
  const paths = resolvePaths();
  const now = Date.now();
  let found;
  let json = false;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: ['json'], values: ['events'] });
    json = flags.json === true;
    if (positional.length === 0) throw new Error('which memory? Usage: mem show <id|uid>');
    const events = positiveInt(flags, 'events', { min: 0 }) ?? 10;
    found = [];
    for (const ref of positional) found.push(await showMemories(ref, { paths, now, events }));
  } catch (err) {
    console.error(`mem show: ${err.message}`);
    return 1;
  }

  if (json) {
    console.log(JSON.stringify({ count: found.length, memories: found }, null, 2));
    return 0;
  }
  console.log(renderShow(found, { now }));
  return 0;
}

/**
 * PLAN's pruning ladder from the outside: archive by default, purge only when a
 * human types --hard. Exit 1 when a ref does not resolve — unlike `search`,
 * "nothing matched" here means the command did not do what was asked.
 */
async function forget(argv) {
  const paths = resolvePaths();
  const now = Date.now();
  let results;
  let json = false;
  let hard = false;

  try {
    const { flags, positional } = parseFlags(argv, {
      booleans: ['hard', 'restore', 'force', 'json'],
      values: ['reason'],
    });
    json = flags.json === true;
    hard = flags.hard === true;
    if (positional.length === 0) throw new Error('which memory? Usage: mem forget <id|uid> [--hard]');

    results = await forgetMemories(positional, {
      paths,
      now,
      hard,
      restore: flags.restore === true,
      force: flags.force === true,
      reason: flags.reason ?? null,
    });
  } catch (err) {
    console.error(`mem forget: ${err.message}`);
    return 1;
  }

  if (json) {
    console.log(JSON.stringify({ results }, null, 2));
    return 0;
  }

  console.log(renderForget(results));
  return 0;
}

async function pin(argv) {
  const paths = resolvePaths();
  let results;
  let json = false;
  let on = true;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: ['off', 'json'], values: [] });
    json = flags.json === true;
    on = flags.off !== true;
    if (positional.length === 0) throw new Error('which memory? Usage: mem pin <id|uid> [--off]');
    results = await pinMemories(positional, on, { paths });
  } catch (err) {
    console.error(`mem pin: ${err.message}`);
    return 1;
  }

  if (json) {
    console.log(JSON.stringify({ results }, null, 2));
    return 0;
  }

  console.log(renderPin(results, on));
  return 0;
}

/**
 * PLAN's second usefulness signal, by hand: "the injected block asks Claude to
 * note ids it acted on → `mem touch <id>`". The echo heuristic in the Stop hook is
 * the automatic one and covers most turns; this is for the turn where the memory
 * shaped the answer without leaving its words in it.
 *
 * It prints the halflife rather than the count, because the count is not the
 * point: what changed is how long this memory now survives without being used
 * again.
 */
async function touchCmd(argv) {
  const paths = resolvePaths();
  let results;
  let json = false;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: ['json'], values: [] });
    json = flags.json === true;
    if (positional.length === 0) throw new Error('which memory? Usage: mem touch <id|uid> […]');
    results = await touchMemories(positional, { paths });
  } catch (err) {
    console.error(`mem touch: ${err.message}`);
    return 1;
  }

  if (json) {
    console.log(JSON.stringify({ results }, null, 2));
    return 0;
  }

  console.log(renderTouch(results));
  return 0;
}

// ------------------------------------------------------------------- prune --
//
// PLAN's pruning ladder by rule rather than by hand: rung 2 (archive — stale, TTL
// expired, dead project scope) and rung 3 (tombstone). Rung 1 is decay, which is
// continuous and needs no command; rung 4 is `forget --hard`, which only a human
// ever types.
//
// DRY RUN BY DEFAULT, and that is not caution for its own sake. PLAN: "a
// false-positive prune is an *invisible* failure. You never notice the memory that
// should have been there." So the default output is a list of what *would* happen,
// with the evidence for each row, and `--apply` is a second decision.

const PRUNE_BOOLEANS = ['apply', 'json'];
const PRUNE_VALUES = ['rule', 'limit', 'strength', 'min-age', 'grace', 'tombstone-after'];

/** `#12  0.08  91d  0/3  use tabs, not spaces` — one candidate row. */
function pruneRow(row) {
  return [
    `#${row.id}`,
    row.strength === undefined || row.strength === null ? '' : row.strength.toFixed(2),
    row.age_days === undefined || row.age_days === null ? '' : `${Math.round(row.age_days)}d`,
    `${row.useful_count ?? 0}/${row.injected_count ?? 0}`,
    clip(row.text, 60),
  ];
}

function describeScopePlan(scopes) {
  const interesting = scopes.filter((s) => s.action !== 'none');
  if (interesting.length === 0) return [];
  return [
    '',
    'project scopes',
    ...table([
      ['action', 'active', 'grace', 'project', 'why'],
      ...interesting.map((s) => [
        s.action,
        String(s.active ?? 0),
        s.days_left === null ? '—' : `${s.days_left}d left`,
        clip(s.project_key, 46),
        s.why,
      ]),
    ]),
  ];
}

async function pruneCmd(argv) {
  const paths = resolvePaths();
  let result;
  let json = false;
  let apply = false;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: PRUNE_BOOLEANS, values: PRUNE_VALUES });
    if (positional.length > 0) throw new Error(`unexpected argument '${positional[0]}'.`);
    json = flags.json === true;
    apply = flags.apply === true;

    const rules = listFlag(flags.rule);
    if (rules) {
      for (const rule of rules) {
        if (!RULES.includes(rule)) {
          throw new Error(`unknown rule '${rule}' — expected one of: ${RULES.join(', ')}.`);
        }
      }
    }

    result = await prune({
      paths,
      apply,
      ...(rules ? { rules } : {}),
      ...(positiveInt(flags, 'limit') === undefined ? {} : { limit: positiveInt(flags, 'limit') }),
      ...(unitFlag(flags, 'strength') === undefined ? {} : { strength: unitFlag(flags, 'strength') }),
      ...(numberFlag(flags, 'min-age') === undefined ? {} : { minAgeDays: numberFlag(flags, 'min-age') }),
      ...(numberFlag(flags, 'grace') === undefined ? {} : { graceDays: numberFlag(flags, 'grace') }),
      ...(numberFlag(flags, 'tombstone-after') === undefined
        ? {}
        : { afterDays: numberFlag(flags, 'tombstone-after') }),
    });
  } catch (err) {
    console.error(`mem prune: ${err.message}`);
    return 1;
  }

  if (json) {
    console.log(JSON.stringify(result, null, 2));
    return 0;
  }

  const { counts, archive, tombstone, scopes, truncated } = result;
  const verb = apply ? 'Archived' : 'Would archive';
  const lines = [];

  for (const bucket of archive) {
    if (bucket.rows.length === 0) continue;
    lines.push(
      `${verb} ${bucket.rows.length} — ${bucket.reason}`,
      ...table([['id', 'str', 'age', 'use/inj', 'text'], ...bucket.rows.map(pruneRow)]).map((l) => `  ${l}`),
      '',
    );
  }

  if (tombstone.length > 0) {
    lines.push(
      `${apply ? 'Tombstoned' : 'Would tombstone'} ${tombstone.length} — long-archived rows lose` +
        ' their vector; text and history stay',
      ...table([
        ['id', 'archived', 'ago', 'text'],
        ...tombstone.map((r) => [
          `#${r.id}`,
          day(r.archived_at),
          r.archived_days_ago === null || r.archived_days_ago === undefined
            ? '?'
            : `${Math.round(r.archived_days_ago)}d`,
          clip(r.text, 60),
        ]),
      ]).map((l) => `  ${l}`),
      '',
    );
  }

  lines.push(...describeScopePlan(scopes));

  const nothing = counts.archived === 0 && counts.tombstoned === 0 && counts.flag === 0 && counts.revive === 0;
  lines.push(
    '',
    nothing
      ? 'Nothing to prune. Everything active is either strong, useful, young or pinned.'
      : `${counts.archived} to archive (${counts.expired} expired, ${counts['dead-scope']} dead scope,` +
        ` ${counts.stale} stale) · ${counts.tombstoned} to tombstone · ${counts.flag} scope` +
        `${counts.flag === 1 ? '' : 's'} to flag`,
  );
  if (truncated.length > 0) {
    lines.push(`Hit the ${result.limit}-row budget on: ${truncated.join(', ')} — run again for the rest.`);
  }
  if (!apply && !nothing) {
    lines.push("Nothing changed. Re-run with --apply, or inspect a row with 'mem show <id>'.");
  }
  if (apply && counts.tombstoned > 0) {
    lines.push("Restoring a tombstone needs 'mem forget <id> --restore' then 'mem reembed --tombstoned'.");
  }

  console.log(lines.join('\n'));
  return 0;
}

// ------------------------------------------------------------------- stats --
//
// PLAN's "Knowing whether it's working" — the section exists because every other
// number in this plugin is about one memory and none of them answer "is my memory
// rotting". Read-only: it opens the database with fileMustExist and never
// migrates, so running it to look at numbers cannot change anything.

const STATS_BOOLEANS = ['json', 'no-ladder'];
const STATS_VALUES = ['cwd', 'worst', 'pair-limit'];

function statsScanLines(scan) {
  if (scan.note) return [`  ${scan.note}`];
  return [
    `  active scan          ${String(scan.active_ms).padStart(7)} ms over ${scan.active_rows} rows` +
      `   (${scan.project_key ?? 'globals only'})`,
    `  every-row scan       ${String(scan.all_ms).padStart(7)} ms over ${scan.all_rows} rows`,
    `  pruning is worth     ${scan.speedup === null ? 'n/a' : `${scan.speedup}×`}` +
      '   — PLAN measured 24.7 ms → 3.0 ms at 20k rows, 2k active',
  ];
}

async function statsCmd(argv) {
  let report;
  let json = false;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: STATS_BOOLEANS, values: STATS_VALUES });
    if (positional.length > 0) throw new Error(`unexpected argument '${positional[0]}'.`);
    json = flags.json === true;

    report = await stats({
      paths: resolvePaths(),
      cwd: flags.cwd,
      ladder: flags['no-ladder'] !== true,
      ...(positiveInt(flags, 'worst') === undefined ? {} : { worst: positiveInt(flags, 'worst') }),
      ...(positiveInt(flags, 'pair-limit') === undefined
        ? {}
        : { rowLimit: positiveInt(flags, 'pair-limit') }),
    });
  } catch (err) {
    console.error(`mem stats: ${err.message}`);
    return 1;
  }

  if (json) {
    console.log(JSON.stringify(report, null, 2));
    return 0;
  }

  const s = report.status;
  const u = report.usefulness;
  const lines = [
    `${report.store.path}  ·  schema v${report.schema_version}` +
      (report.pending_migrations.length ? `  (pending: v${report.pending_migrations.join(', v')})` : '') +
      `  ·  ${((report.store.bytes ?? 0) / 1e6).toFixed(1)} MB` +
      (report.store.wal_bytes ? ` + ${(report.store.wal_bytes / 1e6).toFixed(1)} MB wal` : ''),
    '',
    'rows',
    `  active ${s.active}   staged ${s.staged}   archived ${s.archived}   superseded ${s.superseded}` +
      `   ·   ${s.total} total`,
    `  pinned ${s.pinned}   tombstoned ${s.tombstoned}   expired but still active ${s.expired_active}`,
    '',
    'scan time — the number that matters',
    ...statsScanLines(report.scan),
    '',
    `duplicate pairs ≥ ${report.duplicates.threshold}`,
    `  ${report.duplicates.pairs} outstanding over ${report.duplicates.sampled} active rows` +
      (report.duplicates.exact ? '' : ` (sampled — ${report.duplicates.note})`),
    ...report.duplicates.worst.slice(0, 3).map(
      (p) => `    ${p.similarity}  #${p.a} / #${p.b}  ${clip(p.a_text, 34)}  ‖  ${clip(p.b_text, 34)}`,
    ),
    '',
    'injected : useful  — the over-general-slop signature',
    `  ${u.injections} injections produced ${u.usefuls} usefuls` +
      `${u.ratio_overall === null ? '' : ` (${u.ratio_overall})`}` +
      `   ·   median row ${u.ratio_p50 ?? 'n/a'}   ·   ${u.never_useful} of ${u.injected_rows} never useful`,
    ...u.worst.slice(0, 5).map(
      (r) => `    ${String(r.injected_count).padStart(4)} injected, 0 useful  ${clip(r.text, 56)}`,
    ),
    '',
    `never injected — ${report.never_injected.total} rows (${report.never_injected.active} active)`,
    `  ${report.never_injected.buckets.map((b) => `${b.label} ${b.n}`).join('   ')}`,
    '',
    'mean cosine to a sample — the other slop detector',
    report.slop.scored === 0
      ? '  not enough embedded rows to measure'
      : `  p50 ${report.slop.p50}   p90 ${report.slop.p90}   max ${report.slop.max}` +
        `   over ${report.slop.scored} rows against ${report.slop.sample}`,
    ...report.slop.worst.slice(0, 3).map((r) => `    ${r.mean_cos}  #${r.id}  ${clip(r.text, 56)}`),
  ];

  if (report.ladder) {
    const r = report.ladder.rules;
    lines.push(
      '',
      'what the pruning ladder can reach now',
      `  ${r.stale} stale (strength < ${report.ladder.thresholds.strength}, never useful,` +
        ` older than ${report.ladder.thresholds.min_age_days}d)   ${r.expired} expired` +
        `   ${r['dead-scope']} in a dead scope   ${r.tombstone} to tombstone`,
      ...describeScopePlan(report.ladder.scopes),
    );
  }

  lines.push(
    '',
    'consolidation runs',
    `  proposed ${report.consolidation.proposed}   accepted ${report.consolidation.accepted}` +
      `   undone ${report.consolidation.undone}   ·   ${report.consolidation.runs} run ids in the log`,
    ...(report.consolidation.note ? [`  ${report.consolidation.note}`] : []),
    '',
    `${report.elapsed_ms} ms`,
  );

  console.log(lines.join('\n'));
  return 0;
}

// --------------------------------------------------------------- maintain --
//
// PLAN's tier 1 as one reversible run, and the undo for it. This is the command
// the SessionStart hook fires detached, so its default has to be "apply" — see
// the header of src/maintain.mjs for why that is the opposite of `mem prune`'s
// default and what makes it safe.

const MAINTAIN_BOOLEANS = ['dry-run', 'force', 'json', 'quiet', 'no-backup', 'status'];
const MAINTAIN_VALUES = ['limit', 'strength', 'min-age', 'grace', 'tombstone-after', 'run-id', 'interval'];

const bytes = (n) =>
  n === null || n === undefined
    ? 'n/a'
    : n < 1024
      ? `${n} B`
      : n < 1024 * 1024
        ? `${Math.round(n / 1024)} kB`
        : `${(n / 1024 / 1024).toFixed(1)} MB`;

/** "3h ago" / "in 19h". Both directions, because `next` is in the future. */
const relTime = (at, now) => {
  if (at === null || at === undefined) return 'never';
  const mins = Math.round(Math.abs(now - at) / 60000);
  const span = mins < 60 ? `${mins} min` : mins < 48 * 60 ? `${Math.round(mins / 60)}h` : `${Math.round(mins / 1440)}d`;
  return at <= now ? `${span} ago` : `in ${span}`;
};

function runsTable(runs, now) {
  if (!runs?.length) return [];
  return [
    '',
    'runs in the log',
    ...table([
      ['run', 'when', 'events', 'what', ''],
      ...runs.map((r) => [
        r.run_id,
        relTime(r.last_at, now),
        String(r.events),
        Object.entries(r.by_event).map(([e, n]) => `${e} ${n}`).join(' · '),
        r.undone ? 'undone' : '',
      ]),
    ]),
  ];
}

function maintainStatusLines(status, now) {
  const lines = [
    `store        ${status.store}${status.exists ? '' : '   (does not exist yet)'}`,
    `last run     ${status.last_run ? `${status.last_run.run_id}   ${relTime(status.last_run.at, now)}` : 'never'}`,
    `due          ${status.due.due ? `yes — ${status.due.why}` : `no — ${status.due.why}, next run ${relTime(status.due.nextAt, now)}`}`,
  ];
  if (status.lock) lines.push(`lock         ${status.lock}   (a run is in progress)`);
  return [...lines, ...runsTable(status.runs, now)];
}

async function maintainCmd(argv) {
  const paths = resolvePaths();
  let result;
  let json = false;
  let quiet = false;
  let dryRun = false;

  try {
    const { flags, positional } = parseFlags(argv, {
      booleans: MAINTAIN_BOOLEANS,
      values: MAINTAIN_VALUES,
    });
    if (positional.length > 0) throw new Error(`unexpected argument '${positional[0]}'.`);
    json = flags.json === true;
    quiet = flags.quiet === true;
    dryRun = flags['dry-run'] === true;

    const interval = numberFlag(flags, 'interval');
    if (interval !== undefined && interval < 0) throw new Error('--interval must not be negative.');

    if (flags.status) {
      const status = await maintenanceStatus({
        paths,
        ...(interval === undefined ? {} : { minIntervalMs: interval * 3600 * 1000 }),
      });
      const now = Date.now();
      if (json) console.log(JSON.stringify(status, null, 2));
      else console.log(maintainStatusLines(status, now).join('\n'));
      return 0;
    }

    result = await maintain({
      paths,
      dryRun,
      force: flags.force === true,
      backup: flags['no-backup'] !== true,
      ...(flags['run-id'] === undefined ? {} : { runId: flags['run-id'] }),
      ...(interval === undefined ? {} : { minIntervalMs: interval * 3600 * 1000 }),
      ...(positiveInt(flags, 'limit') === undefined ? {} : { limit: positiveInt(flags, 'limit') }),
      ...(unitFlag(flags, 'strength') === undefined ? {} : { strength: unitFlag(flags, 'strength') }),
      ...(numberFlag(flags, 'min-age') === undefined ? {} : { minAgeDays: numberFlag(flags, 'min-age') }),
      ...(numberFlag(flags, 'grace') === undefined ? {} : { graceDays: numberFlag(flags, 'grace') }),
      ...(numberFlag(flags, 'tombstone-after') === undefined
        ? {}
        : { afterDays: numberFlag(flags, 'tombstone-after') }),
    });
  } catch (err) {
    // --quiet is for the detached hook: it must not write to a terminal nobody
    // is watching, but a genuine failure still belongs on stderr, where the
    // hook's debug log picks it up.
    console.error(`mem maintain: ${err.message}`);
    return 1;
  }

  if (json) {
    console.log(JSON.stringify(result, null, 2));
    return 0;
  }
  if (quiet) return 0;

  const c = result.counts;
  if (result.skipped) {
    console.log(
      result.skipped === 'throttled'
        ? `Nothing to do — ${result.why} (${relTime(result.last_run?.at, result.now)}).` +
            ' Pass --force to run anyway, or --dry-run to see what it would do.'
        : `Skipped — ${result.why}.`,
    );
    return 0;
  }

  const lines = [`${result.dry_run ? 'Would maintain' : 'Maintained'} ${paths.dbPath}   run ${result.run_id}`];
  for (const step of result.steps) {
    const detail =
      step.step === 'decay'
        ? `${step.weak_active} active rows under strength ${step.threshold}`
        : step.step === 'usage'
          ? `${step.useful_since} useful, ${step.injected_since} injected ` +
            // No previous run means the window is the whole store, and saying
            // "since the last run" would be a lie on exactly the first pass.
            (step.since === null ? 'in total (no previous run to compare against)' : 'since the last run')
          : step.step === 'prune'
            ? `${step.counts.archived} to archive · ${step.counts.tombstoned} to tombstone` +
              ` · ${step.counts.flag} scope${step.counts.flag === 1 ? '' : 's'} to flag`
            : step.step === 'checkpoint'
              ? step.skipped
                ? 'skipped (dry run)'
                : `${step.ms} ms, wal ${bytes(step.wal_before)} → ${bytes(step.wal_after)}`
              : '';
    lines.push(`  ${step.step.padEnd(11)}${detail || step.skipped || ''}`);
    if (step.note) lines.push(`  ${''.padEnd(11)}${step.note}`);
    // Whether tier 2 is due. Said here because this is the step that just counted
    // the unjudged pairs, and "there are 7 waiting" reads very differently
    // alongside "and nothing is going to look at them for another five days".
    if (step.consolidation?.due) {
      lines.push(`  ${''.padEnd(11)}consolidation is due (${step.consolidation.why}) — run \`mem consolidate\``);
    }
    if (step.step === 'prune' && step.truncated?.length > 0) {
      lines.push(`  ${''.padEnd(11)}hit the row budget on: ${step.truncated.join(', ')} — the next run takes the rest`);
    }
  }

  // Past tense only when it happened: a dry run's summary line reading "2026
  // archived" is the one place this output could be read as a report of damage.
  lines.push(
    '',
    (result.dry_run
      ? `would archive ${c.archived} · tombstone ${c.tombstoned} · flag ${c.flagged} scope` +
        `${c.flagged === 1 ? '' : 's'} · revive ${c.revived}`
      : `${c.archived} archived · ${c.tombstoned} tombstoned · ${c.flagged} scope` +
        `${c.flagged === 1 ? '' : 's'} flagged · ${c.revived} revived`) +
      `   (${result.elapsed_ms} ms)`,
  );
  if (result.migration_backup) {
    lines.push(
      `migrated the schema from v${result.migration_backup.from} (v${result.migration_backup.pending.join(', v')})` +
        ` — copy first at ${result.migration_backup.path}`,
    );
  }
  if (result.backup) {
    lines.push(`backup of ${result.backup.memories} memories → ${result.backup.path}`);
  }
  lines.push(
    result.dry_run
      ? "Nothing changed. Drop --dry-run to apply, or run 'mem prune' to see the rows themselves."
      : c.archived + c.tombstoned + c.flagged + c.revived === 0
        ? 'Nothing needed doing.'
        : `Reverse all of it with:  mem undo ${result.run_id}`,
  );

  console.log(lines.join('\n'));
  return 0;
}

// ------------------------------------------------------------------- undo --
//
// PLAN: "Every consolidation run gets a run_id; every action writes a
// memory_events row carrying enough prior state to invert it. `mem undo <run_id>`
// reverses an entire run." The maintenance tier writes the same shape, so this is
// one command for both.

const UNDO_BOOLEANS = ['json', 'dry-run', 'last', 'list'];

/**
 * What one reversed action was about, in whatever terms it has.
 *
 * Tier 1's inversions are all about a memory or a project key; tier 2's are also
 * about a pair (`withdrew-proposal`), a relation (`unlinked`) or a set of rows
 * (`unstamped`, one event for four hundred of them). Reaching for `u.id` alone
 * printed "undefined" for the watermark, which is how a summary line stops being
 * read at all.
 */
function undoneSubject(u) {
  if (u.action === 'unstamped') return `${u.rows} rows back in the detection queue`;
  if (u.project_key) return u.project_key;
  const who = u.id === undefined ? '' : `#${u.id}`;
  const what = u.text ? clip(u.text, 56) : (u.pair ?? (u.rel ? `${u.rel} → #${u.dst}` : ''));
  return [who, what].filter(Boolean).join('  ');
}

async function undoCmd(argv) {
  const paths = resolvePaths();
  let result;
  let json = false;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: UNDO_BOOLEANS, values: [] });
    json = flags.json === true;

    if (flags.list) {
      const status = await maintenanceStatus({ paths });
      if (json) console.log(JSON.stringify(status.runs, null, 2));
      else if (status.runs.length === 0) console.log('No runs recorded in this store.');
      else console.log(runsTable(status.runs, Date.now()).slice(1).join('\n'));
      return 0;
    }

    if (positional.length > 1) throw new Error(`one run id at a time, got ${positional.length}.`);
    const ref = flags.last ? 'last' : positional[0];
    if (!ref) throw new Error("which run? Give a run id, or --last (see 'mem undo --list').");

    result = await undo(ref, { paths, dryRun: flags['dry-run'] === true });
  } catch (err) {
    console.error(`mem undo: ${err.message}`);
    return 1;
  }

  if (json) {
    console.log(JSON.stringify(result, null, 2));
    return result.complete ? 0 : 1;
  }

  const lines = [];
  if (result.dry_run) {
    lines.push(
      `Would reverse ${result.would_undo.filter((e) => e.invertible).length} of ${result.events}` +
        ` actions from ${result.run_id}.`,
      ...table([
        ['event', 'memory', ''],
        ...result.would_undo.slice(0, 20).map((e) => [e.event, e.memory_id === null ? '—' : `#${e.memory_id}`,
          e.invertible ? '' : 'no inverse implemented']),
      ]),
    );
  } else {
    const actions = result.undone.reduce((acc, u) => ({ ...acc, [u.action]: (acc[u.action] ?? 0) + 1 }), {});
    lines.push(
      result.undone.length === 0
        ? `Nothing left to reverse in ${result.run_id}` +
            (result.already_undone > 0 ? ` — ${result.already_undone} actions were already undone.` : '.')
        : `Reversed ${result.undone.length} of ${result.events} actions from ${result.run_id}:` +
            `  ${Object.entries(actions).map(([a, n]) => `${n} ${a}`).join(', ')}`,
      ...table(
        result.undone.slice(0, 20).map((u) => [u.action, undoneSubject(u)]),
      ).map((row) => `  ${row}`),
      // Said out loud: a list that stops at twenty without saying so reads like
      // the whole of what happened.
      ...(result.undone.length > 20 ? [`  … and ${result.undone.length - 20} more`] : []),
    );
    if (result.undone.some((u) => u.model_changed)) {
      lines.push(
        '',
        'Some vectors were recomputed with a different model than the one that made them —',
        'the text is the same, the numbers are not. See the untombstoned events in mem show.',
      );
    }
    if (result.blocked.length > 0) {
      lines.push(
        '',
        `${result.blocked.length} could not be reversed (the store moved on, or a vector is missing):`,
        ...result.blocked.slice(0, 10).map(
          (b) => `  ${b.event.padEnd(14)}${b.memory_id === null ? '—' : `#${b.memory_id}`}  ${b.why}`,
        ),
        ...(result.blocked.length > 10 ? [`  … and ${result.blocked.length - 10} more`] : []),
        'Re-running the same undo picks up whatever becomes possible later.',
      );
    }
    if (result.unsupported.length > 0) {
      lines.push(
        '',
        `${result.unsupported.length} events have no inverse implemented: ` +
          [...new Set(result.unsupported.map((e) => e.event))].join(', '),
      );
    }
    if (result.embed_error) lines.push('', `embedding failed: ${result.embed_error}`);
    // Keyed on the event, not on the action: `restored` is also what undoing a
    // supersession writes, and telling somebody the ladder is about to re-archive
    // a memory it never touched is worse than saying nothing.
    if (result.undone.some((u) => u.event === EVENT_ARCHIVED)) {
      lines.push(
        '',
        'These rows still match the rules that archived them, so the next maintenance run will',
        'archive them again. `mem pin <id>` or `mem touch <id>` is what changes that answer.',
      );
    }
  }

  console.log(lines.join('\n'));
  return result.complete ? 0 : 1;
}

// ------------------------------------------------------------------- pairs --
//
// PLAN's "Contradiction handling", mechanical half: what a judge would be asked
// next, and the receipts that stop it being asked twice. Listing is read-only
// (`fileMustExist`, no migration); the one write is a verdict typed by a human,
// which is also how somebody says "these two are fine, stop showing me them".

const PAIRS_BOOLEANS = ['json', 'project', 'cached'];
const PAIRS_VALUES = ['cwd', 'limit', 'changed-limit', 'threshold', 'why'];

function pairsLines(report) {
  const scope = report.project_key === null ? 'every scope' : `${report.project_key} + globals`;
  const lines = [
    `candidate pairs ≥ ${report.threshold}   ·   ${scope}`,
    `  ${report.changed.examined} of ${report.changed.total} changed rows examined` +
      ` against ${report.eligible} in scope   (${report.ms} ms)`,
  ];

  if (report.pairs.length === 0) {
    lines.push(
      report.eligible < 2
        ? '  not enough embedded active memories to pair anything'
        : report.changed.total === 0
          ? '  nothing has changed since the last consolidation — no pair can have a new answer'
          : '  nothing within the threshold',
    );
  } else {
    lines.push(
      '',
      ...table(
        report.pairs.map((p) => [
          String(p.similarity),
          `#${p.a} / #${p.b}`,
          p.scope === 'global' ? 'global' : (p.project_key ?? ''),
          `${clip(p.a_text, 38)}  ‖  ${clip(p.b_text, 38)}`,
        ]),
      ).map((row) => `  ${row}`),
    );
  }

  if (report.cached_skipped > 0) {
    lines.push(
      '',
      `${report.cached_skipped} pair${report.cached_skipped === 1 ? '' : 's'} already judged` +
        ' — skipped until one of the two memories is restated',
    );
  }
  if (report.truncated) {
    lines.push(`showing ${report.pairs.length} of ${report.fresh} unjudged pairs — --limit takes more.`);
  }
  if (report.changed.truncated) {
    lines.push(
      `hit the changed-row budget (${report.changed.examined} of ${report.changed.total}) —` +
        ' the oldest watermarks went first, so the next run takes the rest',
    );
  }
  lines.push('Nothing here is judged: cosine cannot tell a duplicate from a contradiction.');
  return lines;
}

function cachedLines(entries) {
  if (entries.length === 0) return ['No pair has been judged yet.'];
  return [
    'judged pairs — detection skips these while both memories stay as they are',
    ...table([
      ['pair', 'verdict', 'when', 'sim', 'run'],
      ...entries.map((e) => [
        `#${e.a} / #${e.b}`,
        e.verdict ?? '(unreadable)',
        day(e.at),
        e.similarity === null ? '' : String(e.similarity),
        e.run_id ?? '',
      ]),
    ]),
  ];
}

async function pairsCmd(argv) {
  const paths = resolvePaths();
  let json = false;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: PAIRS_BOOLEANS, values: PAIRS_VALUES });
    json = flags.json === true;
    const limit = positiveInt(flags, 'limit');
    const threshold = unitFlag(flags, 'threshold');

    // `mem pairs <verdict> <a> <b>` — the only write. A verdict about a pair the
    // detector never offered is still legitimate: a human can look at two
    // memories and settle them without a judge ever running.
    if (positional.length > 0) {
      const [verdict, a, b, ...rest] = positional;
      if (!VERDICTS.includes(verdict)) {
        throw new Error(`'${verdict}' is not a verdict. Use one of ${VERDICTS.join(', ')}.`);
      }
      if (b === undefined || rest.length > 0) {
        throw new Error(`usage: mem pairs ${verdict} <id|uid> <id|uid> [--why <text>]`);
      }
      if (!KEEP_BOTH_VERDICTS.includes(verdict)) {
        throw new Error(
          `'${verdict}' changes both memories, and recording it here would not — ` +
            'that is what `mem consolidate` is for. Only ' +
            `${KEEP_BOTH_VERDICTS.join(', ')} can be recorded by hand.`,
        );
      }

      const result = await withDb(async (conn) => {
        const [left, right] = await resolveRefs(conn, [a, b]);
        return judgePair({ conn, a: left.id, b: right.id, verdict, why: flags.why ?? null });
      }, { paths });

      if (json) console.log(JSON.stringify(result, null, 2));
      else {
        console.log(
          `#${result.a} / #${result.b} recorded as ${result.verdict}` +
            (result.replaced ? ` (was ${result.replaced.verdict})` : '') +
            '. Detection will skip it until one of them is restated.',
        );
      }
      return 0;
    }

    if (flags.cached) {
      if (!existsSync(paths.dbPath)) {
        console.log(`No store at ${paths.dbPath} yet.`);
        return 0;
      }
      const entries = await withDb((conn) => readPairCache(conn, { limit: limit ?? 100 }), {
        paths,
        readonly: true,
        runMigrations: false,
      });
      if (json) console.log(JSON.stringify({ cached: entries }, null, 2));
      else console.log(cachedLines(entries).join('\n'));
      return 0;
    }

    const report = await pairs({
      paths,
      ...(flags.project ? { projectKey: resolveProjectKey({ cwd: flags.cwd }).projectKey } : {}),
      ...(limit === undefined ? {} : { limit }),
      ...(positiveInt(flags, 'changed-limit') === undefined
        ? {}
        : { changedLimit: positiveInt(flags, 'changed-limit') }),
      ...(threshold === undefined ? {} : { threshold }),
    });

    if (json) console.log(JSON.stringify(report, null, 2));
    else if (report.exists === false) console.log(`No store at ${report.store} yet.`);
    else console.log(pairsLines(report).join('\n'));
    return 0;
  } catch (err) {
    console.error(`mem pairs: ${err.message}`);
    return 1;
  }
}

// ------------------------------------------------------------ consolidate --
//
// PLAN's tier 2: judge the pairs `mem pairs` found, apply what is safe, park the
// rest for `mem review`, all under one run id `mem undo` can reverse.
//
// DRY RUN BY DEFAULT, which is the opposite of `mem maintain` and is PLAN's own
// line ("`mem consolidate` dry-runs by default"). The preview still spawns the
// judge — see src/consolidate.mjs for why — so it is not free, and the output
// says what it would have done rather than what it did.

const CONSOLIDATE_BOOLEANS = ['apply', 'json', 'project', 'duplicates-only', 'no-backup', 'force'];
const CONSOLIDATE_VALUES = ['limit', 'changed-limit', 'threshold', 'batch', 'model', 'margin', 'cwd', 'run-id'];

/** One line per judged pair: what it is, where it went, and why it did not go further. */
function planLines(report) {
  if (report.planned.length === 0) return [];
  return table([
    ['', 'pair', 'class', 'what', 'why not'],
    ...report.planned.map((p) => [
      p.route === 'apply' ? (report.dry_run ? 'would' : 'did') : 'review',
      `#${p.a} / #${p.b}`,
      p.class,
      p.action === 'none' ? 'record it and change neither' : describePlan(p),
      whyReviewed(p),
    ]),
  ]).map((row) => `  ${row}`);
}

/**
 * Why a plan is waiting for a human. Three different answers, and conflating them
 * is how somebody concludes the guard is broken: a guard fired on THIS pair, or
 * contradictions always wait (policy, whatever the rows look like), or the class
 * is simply not one this run was told it could apply.
 */
function whyReviewed(p) {
  if (p.guard) return p.guard.reason;
  if (p.route !== 'review') return '';
  return p.class === 'contradiction' ? 'contradictions are always reviewed' : `${p.class} is not auto-applied here`;
}

function describePlan(p) {
  if (p.action === 'merge') return `merge #${p.loser} into #${p.survivor}`;
  if (p.action === 'supersede') return `retire #${p.loser}, superseded by #${p.survivor}`;
  if (p.action === 'refine') return `#${p.specific} refines #${p.general}`;
  if (p.action === 'relate') return `link #${p.a} and #${p.b} as related`;
  return p.action;
}

function consolidateLines(report) {
  if (report.throttled) {
    const due = report.due ?? {};
    return [
      `Nothing done — ${report.why}.`,
      ...table([
        ['  last pass', report.last_run?.run_id ?? 'never', relTime(report.last_run?.at ?? null, report.now)],
        ['  next due', relTime(report.next_at, report.now), `or at ${due.newThreshold} new memories (${due.newSince} so far)`],
      ]),
      '',
      'Nothing was judged, so this cost nothing. --force runs it anyway.',
    ];
  }

  const d = report.detected;
  const c = report.counts;
  const lines = [
    `${report.dry_run ? 'Would consolidate' : 'Consolidated'} ${report.store}   run ${report.run_id}`,
    `  detected   ${d.fresh} unjudged of ${d.candidates} candidate pairs ≥ ${report.threshold}` +
      `   (${d.changed.examined} of ${d.changed.total} changed rows against ${d.eligible} in scope)`,
    `  judged     ${report.judged} in ${report.calls} call${report.calls === 1 ? '' : 's'}` +
      `   ${Object.entries(report.by_class).filter(([, n]) => n > 0).map(([k, n]) => `${k} ${n}`).join(' · ') || '—'}`,
  ];

  if (report.planned.length > 0) lines.push('', ...planLines(report));

  if (d.truncated) {
    lines.push(
      '',
      `showing ${d.offered} of ${d.fresh} unjudged pairs — --limit takes more, and the watermark was not advanced.`,
    );
  }
  if (report.errors.length > 0) {
    lines.push(
      '',
      `${report.errors.length} judge call${report.errors.length === 1 ? '' : 's'} failed:`,
      ...report.errors.slice(0, 3).map((e) => `  ${e.code ?? 'error'}  ${clip(e.message, 100)}`),
    );
  }
  if (report.unjudged.length > 0) {
    lines.push(
      `${report.unjudged.length} pair${report.unjudged.length === 1 ? '' : 's'} came back unjudged —` +
        ' they are not cached, so the next run offers them again.',
    );
  }
  if (report.skipped.length > 0) {
    lines.push(
      '',
      `${report.skipped.length} could not be resolved (a row moved since it was detected):`,
      ...report.skipped.slice(0, 5).map((s) => `  ${s.key}  ${s.why}`),
    );
  }

  lines.push('');
  if (report.dry_run) {
    lines.push(
      `${report.planned.filter((p) => p.route === 'apply').length} would be applied · ` +
        `${report.planned.filter((p) => p.route === 'review').length} would go to mem review`,
      'Nothing changed — not even the verdicts, so this run silenced no pair.',
      'Pass --apply to act on it.',
    );
  } else {
    lines.push(`${c.applied} applied · ${c.proposed} waiting in mem review   (${report.elapsed_ms} ms)`);
    if (report.backup) lines.push(`backup of ${report.backup.memories} memories → ${report.backup.path}`);
    if (report.stamped?.blocked?.length > 0) {
      lines.push(
        `watermark not advanced: ${report.stamped.blocked.join('; ')} — the next run picks the rest up.`,
      );
    } else if (report.stamped?.stamped) {
      lines.push(`watermark advanced on ${report.stamped.stamped} rows.`);
    }
    if (c.applied + c.proposed === 0) lines.push('Nothing needed doing.');
    else lines.push(`Reverse all of it with:  mem undo ${report.run_id}`);
  }
  return lines;
}

async function consolidateCmd(argv) {
  const paths = resolvePaths();
  let json = false;
  let report;

  try {
    const { flags, positional } = parseFlags(argv, {
      booleans: CONSOLIDATE_BOOLEANS,
      values: CONSOLIDATE_VALUES,
    });
    if (positional.length > 0) throw new Error(`unexpected argument '${positional[0]}'.`);
    json = flags.json === true;

    if (!existsSync(paths.dbPath)) {
      if (json) console.log(JSON.stringify({ store: paths.dbPath, exists: false }, null, 2));
      else console.log(`No store at ${paths.dbPath} yet.`);
      return 0;
    }

    const threshold = unitFlag(flags, 'threshold');
    const margin = unitFlag(flags, 'margin');

    report = await consolidate({
      paths,
      apply: flags.apply === true,
      force: flags.force === true,
      backup: flags['no-backup'] !== true,
      duplicatesOnly: flags['duplicates-only'] === true,
      ...(flags['run-id'] === undefined ? {} : { runId: flags['run-id'] }),
      ...(flags.project ? { projectKey: resolveProjectKey({ cwd: flags.cwd }).projectKey } : {}),
      ...(positiveInt(flags, 'limit') === undefined ? {} : { limit: positiveInt(flags, 'limit') }),
      ...(positiveInt(flags, 'changed-limit') === undefined
        ? {}
        : { changedLimit: positiveInt(flags, 'changed-limit') }),
      ...(threshold === undefined ? {} : { threshold }),
      ...(margin === undefined ? {} : { margin }),
      ...(positiveInt(flags, 'batch') === undefined ? {} : { batchSize: positiveInt(flags, 'batch') }),
      ...(flags.model === undefined ? {} : { judgeOpts: { model: flags.model } }),
    });
  } catch (err) {
    console.error(`mem consolidate: ${err.message}`);
    return 1;
  }

  if (json) console.log(JSON.stringify(report, null, 2));
  else console.log(consolidateLines(report).join('\n'));
  // A pass that could not judge everything it found is not a failure of the
  // command, but it is not a clean run either: the exit code is what a weekly
  // cron reads, and "some batches errored" has to be visible there.
  return report.errors.length > 0 ? 1 : 0;
}

// ------------------------------------------------------------------ review --
//
// The triage surface for everything the store *proposes* rather than knows:
// staged auto-captures today, consolidation proposals from phase 5b later. One
// command with three verbs, because PLAN's exit test for phase 4 is a promote
// rate and nobody measures a rate over a workflow that takes four commands.

const REVIEW_BOOLEANS = ['global', 'project', 'all', 'json'];
const REVIEW_VALUES = ['limit', 'offset', 'cwd', 'threshold'];

function unitFlag(flags, name) {
  const n = numberFlag(flags, name);
  if (n === undefined) return undefined;
  if (n < 0 || n > 1) throw new Error(`--${name} must be between 0 and 1.`);
  return n;
}

async function reviewList(argv) {
  const paths = resolvePaths();
  const now = Date.now();
  let queue;
  let json = false;
  let scope;

  try {
    const { flags, positional } = parseFlags(argv, {
      booleans: REVIEW_BOOLEANS,
      values: REVIEW_VALUES,
    });
    if (positional.length > 0) {
      throw new Error(
        `unknown verb '${positional[0]}' — expected promote, edit or discard, or no argument to list.`,
      );
    }
    json = flags.json === true;
    // Every project by default, unlike `list`. A queue that hides items is worse
    // than no queue: you clear what you can see and the rest rots unreviewed.
    scope = scopeFlags(flags, 'all');

    queue = await reviewQueue({
      paths,
      now,
      scope,
      projectKey: projectKeyFor(scope, flags),
      limit: positiveInt(flags, 'limit') ?? 20,
      offset: positiveInt(flags, 'offset', { min: 0 }) ?? 0,
      ...(unitFlag(flags, 'threshold') === undefined ? {} : { threshold: unitFlag(flags, 'threshold') }),
    });
  } catch (err) {
    console.error(`mem review: ${err.message}`);
    return 1;
  }

  const { items, total, totals } = queue;

  if (json) {
    console.log(JSON.stringify({ total, totals, count: items.length, scope, items }, null, 2));
    return 0;
  }

  console.log(renderQueue({ items, total }, { now }));
  return 0;
}

async function reviewVerb(verb, argv) {
  const paths = resolvePaths();
  const now = Date.now();
  let results;
  let json = false;

  try {
    const { flags, positional } = parseFlags(argv, {
      booleans: ['json', 'no-merge'],
      values: ['reason', 'threshold'],
    });
    json = flags.json === true;
    if (positional.length === 0) {
      throw new Error(`which item? Usage: mem review ${verb} <ref> […]`);
    }
    const opts = {
      paths,
      now,
      merge: flags['no-merge'] !== true,
      reason: flags.reason ?? null,
      ...(unitFlag(flags, 'threshold') === undefined ? {} : { threshold: unitFlag(flags, 'threshold') }),
    };
    results = verb === 'promote' ? await promoteItems(positional, opts) : await discardItems(positional, opts);
  } catch (err) {
    console.error(`mem review ${verb}: ${err.message}`);
    return 1;
  }

  if (json) {
    // Named explicitly: `run_id` rides on the array as a non-index property and
    // JSON.stringify serialises arrays by index, so it would vanish here.
    console.log(JSON.stringify({ run_id: results.run_id, results }, null, 2));
    return 0;
  }
  console.log(renderReviewResults(results));
  // The point of the id: triage is reversible now, and nobody guesses a run id.
  if (results.length > 0) console.log(`\nReverse it with:  mem undo ${results.run_id}`);
  return 0;
}

const EDIT_BOOLEANS = ['promote', 'global', 'project', 'json', 'no-merge'];
const EDIT_VALUES = ['text', 'why', 'kind', 'salience', 'confidence', 'cwd', 'threshold'];

async function reviewEdit(argv) {
  const paths = resolvePaths();
  const now = Date.now();
  let result;
  let json = false;

  try {
    const { flags, positional } = parseFlags(argv, { booleans: EDIT_BOOLEANS, values: EDIT_VALUES });
    json = flags.json === true;
    if (positional.length === 0) throw new Error('which item? Usage: mem review edit <ref> --text "…"');
    if (positional.length > 1) {
      throw new Error('edit takes one item — rewriting several to the same text would collapse them.');
    }
    if (flags.global && flags.project) throw new Error('--global and --project contradict each other.');

    const changes = {
      ...(flags.text === undefined ? {} : { text: flags.text }),
      ...(flags.why === undefined ? {} : { why: flags.why }),
      ...(flags.kind === undefined ? {} : { kind: flags.kind }),
      ...(unitFlag(flags, 'salience') === undefined ? {} : { salience: unitFlag(flags, 'salience') }),
      ...(unitFlag(flags, 'confidence') === undefined
        ? {}
        : { confidence: unitFlag(flags, 'confidence') }),
      ...(flags.global ? { scope: 'global' } : {}),
      ...(flags.project ? { scope: 'project' } : {}),
    };

    result = await editItem(positional[0], changes, {
      paths,
      now,
      cwd: flags.cwd,
      promote: flags.promote === true,
      merge: flags['no-merge'] !== true,
      ...(unitFlag(flags, 'threshold') === undefined ? {} : { threshold: unitFlag(flags, 'threshold') }),
    });
  } catch (err) {
    console.error(`mem review edit: ${err.message}`);
    return err.code === 'MEM_SECRET_DETECTED' ? 2 : 1;
  }

  if (json) {
    console.log(JSON.stringify(result, null, 2));
    return 0;
  }
  console.log(
    [result.edit, result.promote].filter(Boolean).map(describeReviewResult).join('\n'),
  );
  return 0;
}

function reviewCmd(argv) {
  const verb = argv[0];
  if (verb === 'promote' || verb === 'discard') return reviewVerb(verb, argv.slice(1));
  if (verb === 'edit') return reviewEdit(argv.slice(1));
  return reviewList(argv);
}

// ----------------------------------------------------------------- transfer --

const EXPORT_BOOLEANS = ['global', 'project', 'all'];
const EXPORT_VALUES = ['out', 'status', 'kind', 'cwd'];

/**
 * PLAN countermeasure #7. Everything by default — archived rows, staged rows,
 * every project — because a backup that quietly omits what retrieval hides is
 * worse than no backup.
 */
async function exportCmd(argv) {
  const paths = resolvePaths();
  let result;
  let out;

  try {
    const { flags, positional } = parseFlags(argv, {
      booleans: EXPORT_BOOLEANS,
      values: EXPORT_VALUES,
    });
    if (positional.length > 0) throw new Error(`unexpected argument '${positional[0]}'.`);
    out = flags.out;
    const scope = scopeFlags(flags, 'all');

    result = await exportJsonl({
      paths,
      scope,
      projectKey: projectKeyFor(scope, flags),
      statuses: listFlag(flags.status),
      kinds: listFlag(flags.kind),
    });
  } catch (err) {
    console.error(`mem export: ${err.message}`);
    return 1;
  }

  if (out === undefined) {
    // No trailing newline of its own: serialise() already ends every record with
    // one, and process.stdout.write keeps `mem export | mem import` byte-exact.
    process.stdout.write(result.text);
    return 0;
  }

  writeFileSync(out, result.text);
  console.error(`Exported ${result.count} ${result.count === 1 ? 'memory' : 'memories'} to ${out}`);
  return 0;
}

async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString('utf8');
}

/**
 * Import is keyed on uid and does no semantic dedup — see transfer.mjs. Existing
 * uids are skipped unless --update, so re-running an import is a no-op rather
 * than a way to double the store.
 */
async function importCmd(argv) {
  const paths = resolvePaths();
  let result;
  let json = false;
  let source;

  try {
    const { flags, positional } = parseFlags(argv, {
      booleans: ['update', 'dry-run', 'skip-invalid', 'json'],
      values: [],
    });
    json = flags.json === true;
    if (positional.length > 1) throw new Error('one file at a time, or pipe JSONL on stdin.');

    const file = positional[0];
    if ((file === undefined || file === '-') && process.stdin.isTTY) {
      throw new Error('nothing to import. Usage: mem import <file>, or pipe JSONL in.');
    }
    source = file === undefined || file === '-' ? 'stdin' : file;
    const text = source === 'stdin' ? await readStdin() : readFileSync(file, 'utf8');

    result = await importJsonl(text, {
      paths,
      source,
      mode: flags.update ? 'update' : 'skip',
      dryRun: flags['dry-run'] === true,
      skipInvalid: flags['skip-invalid'] === true,
    });
  } catch (err) {
    console.error(`mem import: ${err.message}`);
    return err.code === 'MEM_SECRET_DETECTED' ? 2 : 1;
  }

  if (json) {
    console.log(JSON.stringify(result, null, 2));
    return 0;
  }

  const lines = [
    `${result.dryRun ? 'Would import' : 'Imported'} ${result.total} records from ${source}: ` +
      `${result.inserted} added, ${result.updated} updated, ${result.skipped} already present.`,
  ];
  if (result.generatedUids > 0) {
    lines.push(`  ${result.generatedUids} had no uid and were given a new one.`);
  }
  if (result.linked > 0) lines.push(`  ${result.linked} supersession links restored.`);
  if (result.unresolved.length > 0) {
    lines.push(`  ${result.unresolved.length} supersession links point outside this file.`);
  }
  if (result.invalid.length > 0) {
    lines.push(
      `  ${result.invalid.length} skipped as invalid:`,
      ...result.invalid.map((i) => `    ${i.message}`),
    );
  }
  console.log(lines.join('\n'));
  return 0;
}

// Read-only by design: doctor reports what is there, it does not create it.
// `mem init` is the command that creates the database, the way `mem install`
// is the command that installs the dependencies.
/**
 * Walk the whole hook path once, in a fresh process, and time each leg: this is
 * the number PLAN budgets at ~300ms. Runs before any other doctor probe so the
 * measurements are genuinely cold. Reports `null` for legs it cannot run rather
 * than creating a database or downloading a model to make them measurable.
 */
async function measureColdPath(paths, { depsOk, modelReady, dbExists }) {
  const timings = {
    startupMs: round(STARTUP_MS),
    importMs: null,
    modelLoadMs: null,
    embedMs: null,
    dbOpenMs: null,
    emptyQueryMs: null,
    candidates: null,
    totalMs: null,
    notes: [],
  };

  if (!depsOk) {
    timings.notes.push("dependencies not installed — run 'mem install'");
    return timings;
  }

  let vector = null;
  if (!modelReady) {
    timings.notes.push("embedding model not cached — run 'mem warm'");
  } else {
    try {
      const t0 = performance.now();
      await loadTransformers({ paths });
      const t1 = performance.now();
      await loadExtractor({ paths, offline: true });
      const t2 = performance.now();
      vector = await embed(PROBE_TEXT, { paths, offline: true });
      const t3 = performance.now();
      timings.importMs = round(t1 - t0);
      timings.modelLoadMs = round(t2 - t1);
      timings.embedMs = round(t3 - t2);
    } catch (err) {
      timings.notes.push(`embedding failed: ${err.message}`);
    }
  }

  if (!dbExists) {
    timings.notes.push("database not created — run 'mem init'");
  } else {
    let conn;
    try {
      const t0 = performance.now();
      conn = await openDb({ paths, readonly: true, runMigrations: false });
      timings.dbOpenMs = round(performance.now() - t0);

      if (vector) {
        const t1 = performance.now();
        timings.candidates = (await vectorProbe(conn, vector)).length;
        timings.emptyQueryMs = round(performance.now() - t1);
      }
    } catch (err) {
      timings.notes.push(`database probe failed: ${err.message}`);
    } finally {
      if (conn) await conn.close().catch(() => {});
    }
  }

  const legs = [
    timings.startupMs,
    timings.importMs,
    timings.modelLoadMs,
    timings.embedMs,
    timings.dbOpenMs,
    timings.emptyQueryMs,
  ];
  if (legs.every((leg) => leg !== null)) {
    timings.totalMs = round(legs.reduce((sum, leg) => sum + leg, 0));
  }
  return timings;
}

async function doctor(argv) {
  const paths = resolvePaths();
  const embedding = embedStatus(paths);
  const timings = await measureColdPath(paths, {
    depsOk: depsReady(paths),
    modelReady: embedding.cached && embedding.depsReady,
    dbExists: existsSync(paths.dbPath),
  });

  const report = {
    version: readVersion(paths.pluginRoot),
    node: process.version,
    platform: `${process.platform}-${process.arch}`,
    paths: {
      pluginRoot: paths.pluginRoot,
      dataDir: paths.dataDir,
      dataDirSource: paths.dataDirSource,
      dbPath: paths.dbPath,
      modelsDir: paths.modelsDir,
      nodeModulesDir: paths.nodeModulesDir,
    },
    exists: {
      dataDir: existsSync(paths.dataDir),
      db: existsSync(paths.dbPath),
      models: existsSync(paths.modelsDir),
      nodeModules: existsSync(paths.nodeModulesDir),
    },
    deps: depStatus(paths),
    db: await dbStatus(paths),
    embedding,
    // "Did maintenance actually run?" is the question a detached tier invites,
    // and the answer has to be somewhere a human looks. Read-only, and reports
    // exists:false rather than creating anything on a machine with no store.
    maintenance: depsReady(paths) ? await maintenanceStatus({ paths }).catch(() => null) : null,
    timings,
  };

  if (argv.includes('--json')) {
    console.log(JSON.stringify(report, null, 2));
    return 0;
  }

  const mark = (ok) => (ok ? 'yes' : 'no');
  console.log(
    [
      `mem ${report.version}   node ${report.node}   ${report.platform}`,
      '',
      `plugin root    ${report.paths.pluginRoot}`,
      `data dir       ${report.paths.dataDir}  (from ${report.paths.dataDirSource})`,
      `database       ${report.paths.dbPath}`,
      `models cache   ${report.paths.modelsDir}`,
      `deps           ${report.paths.nodeModulesDir}`,
      '',
      `data dir present    ${mark(report.exists.dataDir)}`,
      `database present    ${mark(report.exists.db)}`,
      `models present      ${mark(report.exists.models)}`,
      '',
      'dependencies (pinned)',
      ...report.deps.map(
        (d) => `  ${d.name.padEnd(28)}${d.wanted.padEnd(10)}${describeDep(d)}`,
      ),
      report.deps.every((d) => d.status === 'ok') ? '' : "\nRun 'mem install' to install them.",
      'database',
      `  schema              ${describeSchema(report.db)}`,
      `  tables              ${report.db.tables.join(', ') || '—'}`,
      `  memories            ${report.db.memories ?? '—'}`,
      needsInit(report.db) ? "\nRun 'mem init' to create or migrate it." : '',
      'embedding model',
      `  model               ${report.embedding.model}  (${report.embedding.dim}d)`,
      `  cache               ${report.embedding.cacheDir}`,
      `  cached              ${describeModelCache(report.embedding)}`,
      report.embedding.cached ? '' : "\nRun 'mem warm' to download it.",
      'maintenance (fires detached at SessionStart)',
      ...(report.maintenance === null || !report.maintenance.exists
        ? ['  never run — no store to maintain yet']
        : [
            `  last run            ${report.maintenance.last_run
              ? `${report.maintenance.last_run.run_id}  ${relTime(report.maintenance.last_run.at, Date.now())}`
              : 'never'}`,
            `  due now             ${report.maintenance.due.due ? 'yes' : `no — next run ${relTime(report.maintenance.due.nextAt, Date.now())}`}`,
            ...(report.maintenance.lock ? [`  lock held           ${report.maintenance.lock}`] : []),
          ]),
      '',
      'cold path (this process)',
      ...describeTimings(report.timings),
      ...report.timings.notes.map((n) => `  note: ${n}`),
    ].join('\n'),
  );
  return 0;
}

function describeModelCache(embedding) {
  if (!embedding.cached) {
    const missing = embedding.files.filter((f) => !f.present).length;
    return `no (${missing}/${embedding.files.length} files missing)`;
  }
  return `yes (${(embedding.bytes / 1e6).toFixed(1)} MB)`;
}

function describeTimings(t) {
  const rows = [
    ['node + imports', t.startupMs],
    ['transformers import', t.importMs],
    ['model load', t.modelLoadMs],
    ['single embed', t.embedMs],
    ['db open', t.dbOpenMs],
    [
      t.candidates === null ? 'vector query' : `vector query (${t.candidates} hits)`,
      t.emptyQueryMs,
    ],
  ];
  const line = (label, ms) =>
    `  ${label.padEnd(23)}${ms === null ? 'n/a' : `${ms.toFixed(1)} ms`}`;

  return [
    ...rows.map(([label, ms]) => line(label, ms)),
    `  ${'-'.repeat(30)}`,
    line('hook budget', t.totalMs),
  ];
}

function describeDep(d) {
  if (d.status === 'ok') return 'installed';
  if (d.installed === null) return 'not installed';
  return `installed ${d.installed} — expected ${d.wanted}`;
}

function needsInit(db) {
  return !db.exists || db.pending.length > 0;
}

function describeSchema(db) {
  if (!db.exists) return `not created — expected v${db.latestVersion}`;
  if (db.error) return `unreadable — ${db.error}`;
  if (db.pending.length > 0) {
    return `v${db.schemaVersion}, pending: v${db.pending.join(', v')}`;
  }
  return `v${db.schemaVersion} (current)`;
}

function install(argv) {
  const paths = resolvePaths();
  let changed;
  try {
    changed = ensureDeps(undefined, { paths });
  } catch (err) {
    console.error(`mem: ${err.message}`);
    return 1;
  }

  const result = { installed: changed, deps: depStatus(paths) };
  if (argv.includes('--json')) {
    console.log(JSON.stringify(result, null, 2));
    return 0;
  }
  console.log(
    changed.length === 0
      ? 'Dependencies already installed.'
      : `Installed: ${changed.join(', ')}`,
  );
  return 0;
}

async function init(argv) {
  const paths = resolvePaths();
  let result;
  try {
    result = await initDb({ paths });
  } catch (err) {
    console.error(`mem: ${err.message}`);
    return 1;
  }

  if (argv.includes('--json')) {
    console.log(JSON.stringify({ ...result, dbPath: paths.dbPath }, null, 2));
    return 0;
  }
  console.log(
    result.applied.length === 0
      ? `Database already at schema v${SCHEMA_VERSION}: ${paths.dbPath}`
      : `Migrated ${paths.dbPath}: v${result.from} -> v${result.to} (applied v${result.applied.join(', v')})`,
  );
  return 0;
}

// Downloading ~23 MB the first time a hook fires would blow the latency budget,
// so the download gets its own command — the way `mem install` owns npm.
async function warm(argv) {
  const paths = resolvePaths();
  let result;
  try {
    result = await warmModel({ paths });
  } catch (err) {
    console.error(`mem: ${err.message}`);
    return 1;
  }

  if (argv.includes('--json')) {
    console.log(JSON.stringify(result, null, 2));
    return 0;
  }
  console.log(
    [
      result.downloaded
        ? `Downloaded ${EMB_MODEL} to ${result.cacheDir}`
        : `${EMB_MODEL} already cached in ${result.cacheDir}`,
      `Loaded in ${result.loadMs.toFixed(0)} ms, embedded ${result.dim} dimensions in ${result.embedMs.toFixed(0)} ms.`,
    ].join('\n'),
  );
  return 0;
}

// Changing the pinned model in embed.mjs makes every stored row invisible to
// search — retrieval filters on emb_model so it never compares vectors from two
// different spaces. This is how the store catches up.
async function reembedCmd(argv) {
  const paths = resolvePaths();
  const json = argv.includes('--json');
  const dryRun = argv.includes('--dry-run') || argv.includes('-n');
  // Off by default: a row that is still archived was tombstoned on purpose, and
  // this only ever touches the ones somebody restored out of it.
  const tombstoned = argv.includes('--tombstoned');

  let result;
  try {
    result = await reembed({
      paths,
      dryRun,
      tombstoned,
      // Long enough to look stuck otherwise: a few thousand rows is a few
      // thousand forward passes. Silent under --json.
      onProgress: json ? undefined : ({ done, total }) =>
        process.stderr.write(`\rembedding ${done}/${total}`),
    });
  } catch (err) {
    console.error(`mem: ${err.message}`);
    return 1;
  }
  if (!json && result.pending > 0 && !dryRun) process.stderr.write('\r\x1b[K');

  if (json) {
    console.log(JSON.stringify(result, null, 2));
    return 0;
  }

  const stamps = result.after
    .map((s) => `  ${s.emb_model ?? '(none)'} ${s.emb_dim ?? '?'}d — ${s.n} row${s.n === 1 ? '' : 's'}` +
      (s.tombstoned > 0 ? ` (${s.tombstoned} tombstoned${tombstoned ? '' : ', left alone'})` : ''))
    .join('\n');

  const what = result.restored > 0
    ? `${result.pending} of ${result.total} memories (${result.stale} stale,` +
      ` ${result.restored} restored from a tombstone)`
    : `${result.stale} of ${result.total} memories`;

  if (result.pending === 0) {
    console.log(
      `All ${result.total} memories already embedded with ${result.model}.\n${stamps}` +
        (tombstoned ? '' : "\nRows restored out of a tombstone need --tombstoned to be refilled."),
    );
  } else if (dryRun) {
    console.log(`${what} would be re-embedded with ${result.model}:\n${stamps}`);
  } else {
    console.log(`Re-embedded ${result.reembedded} of ${result.total} memories with ${result.model}.\n${stamps}`);
  }
  return 0;
}

// ------------------------------------------------------------------- tuning --
//
// A build command that happens to live in the shipped CLI, because PLAN names it
// `mem tune`. It reads the fixture store from build/seed.mjs and never the user's
// own — a tuning run against a store with four memories in it would report a
// precision of 1.00 and mean nothing.

const TUNE_BOOLEANS = ['json', 'full'];
const TUNE_VALUES = ['coverage', 'spawns', 'limit', 'harness', 'data'];

/** `31/31  1.00  0.87   0/21   2.1` — one sweep row. */
function tuneRow(r, mark) {
  return (
    `  ${mark} ${r.threshold.toFixed(3)}   ` +
    `${String(`${r.hits}/${r.positives}`).padStart(6)}  ` +
    `${r.hit_rate.toFixed(2)}   ${r.recall.toFixed(2)}   ${r.precision.toFixed(2)}   ` +
    `${String(`${r.admits}/${r.negatives}`).padStart(6)}` +
    `${r.lexical_admits > 0 ? `(${r.lexical_admits} lex)` : '      '}  ` +
    `${r.mean_items.toFixed(2)}`
  );
}

/**
 * The rows worth reading: every threshold where the outcome moved, plus the two
 * that matter. Forty grid points where nothing changes for ten of them is a table
 * nobody reads, and the sweep's shape is in --json for anything that wants it all.
 */
function tuneTable(report, full) {
  const { sweep } = report;
  const keep = (r, i) => {
    if (full || i === 0 || i === sweep.length - 1) return true;
    if (r.threshold === report.gate.committed || r.threshold === report.recommend.shipped) return true;
    const prev = sweep[i - 1];
    return r.hits !== prev.hits || r.admits !== prev.admits;
  };

  const marks = (r) =>
    r.threshold === report.recommend.shipped ? '★' : r.threshold === report.gate.committed ? '←' : ' ';

  return [
    '  threshold      hits  hit   rec    prec   admits         items',
    ...sweep.filter(keep).map((r) => tuneRow(r, marks(r))),
  ].join('\n');
}

function tuneLatency(latency) {
  const line = (name, t, note = '') =>
    t === null
      ? `  ${name.padEnd(7)}not measured`
      : `  ${name.padEnd(7)}p50 ${String(t.p50).padStart(6)} ms   p95 ${String(t.p95).padStart(6)} ms` +
        `   max ${String(t.max).padStart(6)} ms   n=${t.n}${note}`;
  return [
    line('embed', latency.embed),
    line('query', latency.query),
    line(
      'hook',
      latency.hook,
      latency.hook ? `  cold spawns, ${latency.hook.injected} injected` : '',
    ),
  ].join('\n');
}

async function tuneCmd(argv) {
  let report;
  let json = false;
  let full = false;

  try {
    const { flags } = parseFlags(argv, { booleans: TUNE_BOOLEANS, values: TUNE_VALUES });
    json = flags.json === true;
    full = flags.full === true;

    const coverage = numberFlag(flags, 'coverage');
    const spawns = numberFlag(flags, 'spawns');
    const limit = numberFlag(flags, 'limit');
    if (spawns !== undefined && (!Number.isInteger(spawns) || spawns < 0)) {
      throw new Error('--spawns must be a whole number (0 skips the hook timing).');
    }

    const base = resolvePaths();
    report = await tune({
      paths: base,
      ...(flags.harness ? { harness: flags.harness } : {}),
      ...(flags.data ? { storePaths: { ...base, dataDir: flags.data, dbPath: join(flags.data, 'mem.db') } } : {}),
      ...(coverage === undefined ? {} : { coverage }),
      ...(spawns === undefined ? {} : { spawns }),
      ...(limit === undefined ? {} : { limit }),
      onProgress: json ? undefined : ({ done, total }) => process.stderr.write(`\rprobing ${done}/${total}`),
    });
  } catch (err) {
    console.error(`mem tune: ${err.message}`);
    return 1;
  }
  if (!json) process.stderr.write('\r\x1b[K');

  if (json) {
    console.log(JSON.stringify(report, null, 2));
    return 0;
  }

  const { harness, store, band, recommend: pick, committed, recommended } = report;
  const lines = [
    `${harness.cases} cases — ${harness.positives} positive over ${harness.expected_memories} memories,` +
      ` ${harness.negatives} that must retrieve nothing`,
    `  ${Object.entries(harness.by_tier).map(([t, n]) => `${t} ${n}`).join(' · ')}`,
    `against ${store.memories} memories (${store.retrievable} retrievable) · ${store.model} ${store.dim}d`,
    `gate: vector threshold swept, lexical coverage ${report.gate.coverage}, cap ${report.gate.limit}`,
    '',
    'band (raw cosine, on the scoped path)',
    `  worst relevant   ${band.worst_relevant}  "${band.worst_relevant_prompt}"`,
    `  best irrelevant  ${band.best_irrelevant}  "${band.best_irrelevant_prompt}"`,
    `  separation       ${band.separation}`,
    '',
    tuneTable(report, full),
    '',
    `recommend ${pick.shipped.toFixed(3)}  ` +
      `= efficient ${pick.efficient.toFixed(3)} + ${pick.margin} margin` +
      `${pick.zero_admits_possible ? '' : `  (no threshold reaches zero admits; floor is ${pick.admits_floor})`}`,
    `committed ${committed.threshold.toFixed(3)} in src/search.mjs  ` +
      `— ${committed.hits}/${committed.positives} served, ${committed.admits}/${committed.negatives} admitted`,
    `          ${pick.shipped.toFixed(3)} would serve ${recommended.hits}/${recommended.positives}` +
      ` and admit ${recommended.admits}/${recommended.negatives}` +
      `  (margin costs ${pick.recall_cost} hit rate)`,
  ];

  // Both thresholds get a block, because they answer different questions: what
  // does what we ship let through, and what does fixing that cost. Collapsed to
  // one when the recommendation is already what is committed.
  const views =
    committed.threshold === recommended.threshold
      ? [['committed', committed]]
      : [['committed', committed], ['recommended', recommended]];

  for (const [where, at] of views) {
    // The aggregate hides which half of the problem the gate is solving: a literal
    // prompt reuses the memory's own words and sails through, a paraphrase is what
    // the threshold is actually adjudicating.
    lines.push('', `by tier at the ${where} ${at.threshold.toFixed(3)}`);
    for (const [tier, t] of Object.entries(at.by_tier)) {
      const positive = ['literal', 'paraphrase'].includes(tier);
      const [n, of] = positive ? [t.served, 'served'] : [t.admitted, 'ADMITTED'];
      lines.push(
        `  ${tier.padEnd(11)}${String(n).padStart(2)}/${String(t.cases).padStart(2)} ${of.padEnd(8)}` +
          ` ${(t.cases === 0 ? 0 : n / t.cases).toFixed(2)}`,
      );
    }

    if (at.admitted.length > 0) {
      lines.push(
        '',
        `ADMITTED at the ${where} ${at.threshold.toFixed(3)} (${at.admitted.length} of ${at.negatives})` +
          ' — PLAN\'s phase-3 exit criterion is that this is empty',
      );
      for (const a of at.admitted) {
        lines.push(`  ${a.tier.padEnd(11)}"${a.prompt}"`);
        for (const g of a.got) lines.push(`              ${g.similarity} / cov ${g.coverage}  ${g.text}`);
      }
    }
    if (at.noise.length > 0) {
      lines.push(
        '',
        `noise beside a right answer at the ${where} ${at.threshold.toFixed(3)} (${at.noise.length}) — ` +
          'if one of these is defensible it belongs in the case\'s `allow`',
      );
      for (const s of at.noise) {
        lines.push(`  ${s.tier.padEnd(11)}"${s.prompt}"${s.served ? '' : '   [and missed its own answer]'}`);
        for (const g of s.got) lines.push(`              ${g.similarity} / cov ${g.coverage}  ${g.text}`);
      }
    }
    if (at.misses.length > 0) {
      lines.push('', `missed at the ${where} ${at.threshold.toFixed(3)} (${at.misses.length} of ${at.positives})`);
      for (const m of at.misses) {
        lines.push(
          `  ${m.tier.padEnd(11)}best ${m.best_similarity}  "${m.prompt}"` +
            (m.beyond_vector_limit ? '   [cleared the gate, outside the top 20]' : ''),
        );
        lines.push(`              wanted: ${m.expect.join(' / ')}`);
      }
      if (at.beyond_vector_limit > 0) {
        lines.push(
          `  ${at.beyond_vector_limit} of those cleared the gate and lost to VECTOR_LIMIT=${VECTOR_LIMIT}` +
            ' — no threshold recovers them',
        );
      }
    }
  }

  lines.push('', 'latency', tuneLatency(report.latency), '', `${report.elapsed_ms} ms total`);
  console.log(lines.join('\n'));
  return 0;
}

async function main(argv) {
  if (argv.includes('--version')) {
    console.log(readVersion(resolvePaths().pluginRoot));
    return 0;
  }

  const name = argv[0];
  if (!name || name === '-h' || name === '--help') return help();

  const command = commands[name];
  if (!command) {
    console.error(`mem: unknown command '${name}'. Try 'mem help'.`);
    return 1;
  }
  return command.run(argv.slice(1));
}

process.exitCode = await main(process.argv.slice(2));
