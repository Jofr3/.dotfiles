{
  "default": "app",
  "connections": {
    "app": {
      "dialect": "postgresql",
      "urlEnv": "DATABASE_URL",
      "allowWrites": false,
      "confirmWrites": true,
      "maxRows": 100
    },
    "warehouse": {
      "dialect": "sqlserver",
      "urlEnv": "SQLSERVER_DATABASE_URL",
      "allowWrites": false,
      "confirmWrites": true,
      "maxRows": 100
    },
    "local": {
      "dialect": "sqlite",
      "url": "file:./data/app.db",
      "allowWrites": true,
      "confirmWrites": true,
      "maxRows": 100
    },
    "turso": {
      "dialect": "libsql",
      "urlEnv": "TURSO_DATABASE_URL",
      "authTokenEnv": "TURSO_AUTH_TOKEN",
      "allowWrites": false
    }
  }
}
