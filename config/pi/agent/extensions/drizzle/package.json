{
  "name": "pi-drizzle-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM database tools for Pi",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "drizzle-orm": "0.45.2",
    "mysql2": "3.24.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "tsx": "4.21.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
