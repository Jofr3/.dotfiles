{
  "name": "pi-drizzle-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM database tools for Pi",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "drizzle-orm": "0.45.2",
    "mssql": "12.7.0",
    "mysql2": "3.24.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "tsx": "4.21.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "tedious": "19.2.2",
    "@azure/identity": "4.13.1",
    "@azure/keyvault-keys": "4.9.0",
    "@azure-rest/core-client": "2.5.1",
    "@azure/abort-controller": "2.1.2",
    "@azure/core-auth": "1.10.1",
    "@azure/core-client": "1.10.1",
    "@azure/core-http-compat": "2.4.0",
    "@azure/core-paging": "1.6.2",
    "@azure/core-rest-pipeline": "1.22.1",
    "@azure/core-tracing": "1.3.1",
    "@azure/core-util": "1.13.0",
    "@azure/logger": "1.3.0",
    "@typespec/ts-http-runtime": "0.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
